	{ "wpn_ump45", "WP_VAL", "weapon" },
	{ "wpn_upd", "WP_BINOC", "weapon" },
	{ "wpn_usp", "WP_PM", "weapon" },
	{ "wpn_usp_nimble", "WP_PM", "weapon" },
	{ "wpn_val", "WP_VAL", "weapon" },
	{ "wpn_vector", "WP_VAL", "weapon" },
	{ "wpn_vepr", "WP_ASHTG", "weapon" },
	{ "wpn_vihr", "WP_VAL", "weapon" },
	{ "wpn_vintorez", "WP_VAL", "weapon" },
	{ "wpn_vintorez_nimble", "WP_VAL", "weapon" },
	{ "wpn_vityaz", "WP_VAL", "weapon" },
	{ "wpn_vpo101", "WP_SVD", "weapon" },
	{ "wpn_walther", "WP_PM", "weapon" },
	{ "wpn_waste_heavy", "S_PDA", "item" },
	{ "wpn_waste_light", "S_PDA", "item" },
	{ "wpn_wincheaster1300", "WP_SHOTG", "weapon" },
	{ "wpn_wincheaster1300_trapper", "WP_SHOTG", "weapon" }
}

local idx = 0
local next_frame = 0
local started_frame = nil
local done = false
local pass_n, fail_n = 0, 0

local function enabled()
	return string.find(command_line() or "", "mc_selftest") ~= nil
end

local function slog(fmt, ...)
	local line = string.format(fmt, ...)
	-- routed through the standard log so it lands in xray_*.log next to any FATAL
	log("[MC_SELFTEST] " .. line)
	if mc_core and mc_core.mc_log then mc_core.mc_log("SELFTEST " .. line) end
end

local function probe(entry)
	local section, cls, kind = entry[1], entry[2], entry[3]
	local actor = mc_core.local_actor()
	if actor == nil then
		return false, "no local actor"
	end
	-- spawn to inventory via the console path (same as manual g_spawn_to_inventory)
	local ok, err = pcall(function()
		get_console():execute("g_spawn_to_inventory " .. section)
	end)
	if not ok then
		return false, "spawn: " .. tostring(err)
	end
	-- armor: force-equip so attach/actor_visual load is exercised, not just spawn
	if kind == "helmet" or kind == "outfit" then
		local ok2, err2 = pcall(function()
			actor:iterate_inventory(function(owner, item)
				if item:section() == section then
					owner:move_to_slot(item, kind == "helmet" and 12 or 7)
				end
			end, actor)
		end)
		if not ok2 then
			return false, "equip: " .. tostring(err2)
		end
	end
	return true, "ok"
end

local function run(binder, delta)
	if done or not enabled() then
		return
	end
	local frame = device().frame
	if started_frame == nil then
		started_frame = frame
		slog("ENABLED -- %s items queued%s; first probe in %s frames", tostring(#MANIFEST),
			TARGET_SECTION and ("; target=" .. TARGET_SECTION) or "", tostring(START_DELAY))
		-- identity self-check: write + read back a per-player var (2-client run: each
		-- client logs its OWN LocalActor; the buckets must not cross-contaminate)
		mc_player_state.set("selftest_owner", LocalActor())
		slog("identity: LocalActor=%s key='%s' selftest_owner=%s",
			tostring(LocalActor()), tostring(mc_core.player_key()),
			tostring(mc_player_state.get("selftest_owner", -1)))
		return
	end
	if frame < started_frame + START_DELAY or frame < next_frame then
		return
	end
	next_frame = frame + SPAWN_EVERY
	repeat
		idx = idx + 1
		if idx > #MANIFEST then
			done = true
			slog("COMPLETE -- pass=%s fail=%s of %s", tostring(pass_n), tostring(fail_n),
				TARGET_SECTION and 1 or #MANIFEST)
			return
		end
	until TARGET_SECTION == nil or MANIFEST[idx][1] == TARGET_SECTION
	local entry = MANIFEST[idx]
	local ok, reason = probe(entry)
	if ok then
		pass_n = pass_n + 1
		slog("PASS [%s] (%s/%s) %s", entry[1], entry[3], tostring(idx), tostring(#MANIFEST))
	else
		fail_n = fail_n + 1
		slog("FAIL [%s] :: %s", entry[1], reason)
	end
end

-- register on the per-player update hub (local-actor path); inert unless enabled()
if mc_player_loop and mc_player_loop.register_system then
	mc_player_loop.register_system("selftest", { update = run })
end
