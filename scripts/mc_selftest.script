-- mc_selftest.script  (GENERATED by tools/build_selftest.py -- DO NOT HAND-EDIT)
-- In-engine, OPT-IN item-matrix self-test. See tools/build_selftest.py header.
-- Enable by adding the token `mc_selftest` to the client launch command line.
-- Hooks the local actor via mc_player_loop.register_system; spawns each item, and
-- equips armor, inside pcall; logs PASS/FAIL. A real C++ FATAL still fires so the
-- crash-watch/WER pipeline captures a dump naming the offending section.

local SPAWN_EVERY   = 30      -- frames between item probes (avoid flooding one tick)
local START_DELAY   = 300     -- frames to wait after spawn before probing begins
-- Optional focused repro: launch with `mc_selftest=<section>` to exercise just
-- that section through the same g_spawn_to_inventory path as the full matrix.
local TARGET_SECTION = string.match(command_line() or "", "mc_selftest=([%w_]+)")

