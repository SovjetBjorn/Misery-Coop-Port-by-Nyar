-- generated by tools/build_ai_system.py; component help_wounded=off
function help_wounded(npc)
	return true -- animation callback compatibility; no help action is installed
end

function add_to_binder(npc, ini, scheme, section, storage)
	return -- disabled scheme is never bound
end

function set_help_wounded(npc, ini, scheme, section)
	-- Other enabled planner actions retain wounded_exist=false preconditions.
	-- X-Ray's CProblemSolver requires an evaluator for every referenced property.
	npc:motivation_action_manager():add_evaluator(
		xr_evaluators_id.wounded_exist, property_evaluator_const(false))
end

function reset_help_wounded(npc, scheme, st, section)
	return
end

function is_under_help_wounded(npc)
	return false
end
