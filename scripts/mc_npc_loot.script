-- AUTO-GENERATED by tools/build_npc_loot.py.
-- Misery-faithful server-authoritative humanoid corpse filter.
-- Inventory is collected first; release/condition/create operations happen afterward.

local ini = ini_file("misc\\mc_npc_loot.ltx")

local function log(message)
	if mc_core and mc_core.mc_log then mc_core.mc_log("[npc_loot] " .. tostring(message)) end
end

local function load_set(section)
	local result = {}
	if not ini:section_exist(section) then return result end
	for i = 0, ini:line_count(section) - 1 do
		local ok, id, value = ini:r_line(section, i, "", "")
		if id and id ~= "" then result[id] = true end
	end
	return result
end

local function load_numbers(section)
	local result = {}
	if not ini:section_exist(section) then return result end
	for i = 0, ini:line_count(section) - 1 do
		local ok, id, value = ini:r_line(section, i, "", "")
		if id and id ~= "" and value then result[id] = tonumber(value) end
	end
	return result
end

local function number(section, key, fallback)
	if not ini:section_exist(section) or not ini:line_exist(section, key) then return fallback end
	local ok, value = pcall(function() return ini:r_float(section, key) end)
	return ok and tonumber(value) or fallback
end

local function pair(section, key, amin, amax)
	if not ini:section_exist(section) or not ini:line_exist(section, key) then return amin, amax end
	local ok, raw = pcall(function() return ini:r_string(section, key) end)
	if not ok or not raw then return amin, amax end
	local a, b = tostring(raw):match("^%s*([%+%-]?[%d%.]+)%s*,%s*([%+%-]?[%d%.]+)")
	return tonumber(a) or amin, tonumber(b) or amax
end

local quest_keep = load_set("quest_keep")
local npc_only = load_set("npc_only_destroy")
local launcher_ammo = load_set("launcher_ammo")
local misery_lootable = load_set("misery_lootable")
local survival_factor = load_numbers("item_survival_factor")

local function clamp(value, amin, amax)
	if value < amin then return amin end
	if value > amax then return amax end
	return value
end

local function exists(section)
	local ok, value = pcall(function() return section and system_ini():section_exist(section) end)
	return ok and value == true
end

local function line(section, key)
	local ok, value = pcall(function() return exists(section) and system_ini():line_exist(section, key) end)
	return ok and value == true
end

local function slot_of(section)
	if not line(section, "slot") then return -1 end
	local ok, value = pcall(function() return system_ini():r_float(section, "slot") end)
	return ok and tonumber(value) or -1
end

local function first_ammo(section)
	if not line(section, "ammo_class") then return nil end
	local ok, raw = pcall(function() return system_ini():r_string(section, "ammo_class") end)
	if not ok or not raw then return nil end
	local ammo = tostring(raw):match("([^,%s]+)")
	return exists(ammo) and ammo or nil
end

local function mag_size(section)
	if not line(section, "ammo_mag_size") then return 30 end
	local ok, value = pcall(function() return system_ini():r_float(section, "ammo_mag_size") end)
	value = ok and tonumber(value) or 30
	return value and value >= 1 and value or 30
end

local function is_ordinary_weapon(item)
	local ok, result = pcall(function()
		if not isWeapon(item) then return false end
		local class = get_clsid(item)
		return class ~= clsid.wpn_grenade_rgd5_s and class ~= clsid.wpn_grenade_f1_s
	end)
	return ok and result == true
end

local function is_artefact(item)
	local ok, result = pcall(function() return isArtefact(item) end)
	return ok and result == true
end

local function safe_release(record)
	local ok, err = pcall(function()
		local sim = alife()
		local server_item = sim and sim:object(record.id)
		if not server_item then error("missing server entity") end
		sim:release(server_item, true)
	end)
	if not ok then log(string.format("release failed npc-item=%s id=%s: %s", record.section, tostring(record.id), tostring(err))) end
	return ok
end

local function safe_condition(record, condition)
	local ok, err = pcall(function() record.item:set_condition(clamp(condition, 0, 1)) end)
	if not ok then log(string.format("condition failed section=%s id=%s: %s", record.section, tostring(record.id), tostring(err))) end
	return ok
end

local function npc_context(npc)
	local community, rank = "unknown", "unknown"
	pcall(function() community = character_community(npc) or "unknown" end)
	pcall(function() rank = ranks.get_obj_rank_name(npc) or "unknown" end)
	if not ini:line_exist("community_item_multiplier", community) then community = "unknown" end
	if not ini:line_exist("rank_item_multiplier", rank) then rank = "unknown" end
	local difficulty = "unknown"
	pcall(function() difficulty = "level_" .. tostring(level.get_game_difficulty()) end)
	if not ini:line_exist("difficulty_ammo_multiplier", difficulty) then difficulty = "unknown" end
	return community, rank, difficulty
end

local function item_survives(section, community, rank)
	local factor = survival_factor[section]
	if factor == nil then return false end
	local score = factor * 100
		* number("community_item_multiplier", community, 1)
		* number("rank_item_multiplier", rank, 1)
	return score > math.random(100)
end

local function percent_roll(amin, amax)
	if amin > amax then amin, amax = amax, amin end
	local lo = math.floor(clamp(amin, 0, 1) * 100 + .5)
	local hi = math.floor(clamp(amax, 0, 1) * 100 + .5)
	return math.random(lo, hi) / 100
end

local function weapon_condition(community, rank)
	local cmin, cmax = pair("community_weapon_condition", community, .01, .15)
	local rmin, rmax = pair("rank_weapon_condition", rank, .05, .25)
	local fmin, fmax = pair("constants", "weapon_condition_factor", .90, 1.20)
	local factor = math.random(math.floor(fmin * 100 + .5), math.floor(fmax * 100 + .5)) / 100
	return clamp((percent_roll(cmin, cmax) + percent_roll(rmin, rmax)) * factor, 0, 1)
end

local function ammo_cap(record, community, rank, difficulty)
	local ammo = first_ammo(record.section)
	if not ammo then return nil, 0 end
	if launcher_ammo[ammo] then return ammo, math.floor(number("constants", "launcher_round_cap", 1)) end
	local sidearm = record.slot == 1
	local mags = number(sidearm and "rank_sidearm_mags" or "rank_primary_mags", rank, sidearm and 1 or 2)
	local cm = number("community_ammo_multiplier", community, 1)
	local dm = number("difficulty_ammo_multiplier", difficulty, 1)
	local global_cap = number("constants", sidearm and "sidearm_round_cap" or "primary_round_cap", sidearm and 36 or 90)
	return ammo, math.max(0, math.min(global_cap, math.floor(mag_size(record.section) * mags * cm * dm)))
end

local function half_ammo_roll(cap)
	if cap <= 0 then return 0 end
	local scaled = math.random(0, cap) * number("constants", "ammo_amount_multiplier", .50)
	local rounds = math.floor(scaled)
	if math.random() < (scaled - rounds) then rounds = rounds + 1 end
	return rounds
end

function process(npc)
	if not npc or not npc.iterate_inventory or not alife() then
		log("process skipped: missing npc/inventory/alife")
		return false
	end
	if mc_npc_ammo and mc_npc_ammo.on_npc_death then
		local ok, err = pcall(mc_npc_ammo.on_npc_death, npc)
		if not ok then log("telemetry failed: " .. tostring(err)) end
	end

	local community, rank, difficulty = npc_context(npc)
	local records = {}
	npc:iterate_inventory(function(owner, item)
		local ok, section, id = pcall(function() return item:section(), item:id() end)
		if ok and section and id then
			table.insert(records, {
				item=item, section=section, id=id, slot=slot_of(section),
				weapon=is_ordinary_weapon(item), artefact=is_artefact(item),
			})
		else
			log("inventory record skipped: item lacks section/id")
		end
	end, npc)

	local releases, conditions, weapons, normal, unknown = {}, {}, {}, {}, {}
	for _, record in ipairs(records) do
		if npc_only[record.section] then
			table.insert(releases, record)
		elseif record.artefact or record.section == "bolt" or quest_keep[record.section] then
			-- Misery unconditional overrides: untouched and not counted as weapons.
		elseif string.sub(record.section, 1, 5) == "ammo_" then
			table.insert(releases, record) -- xrMPE-safe synthetic replacement below
		elseif record.weapon then
			table.insert(weapons, record)
		else
			table.insert(normal, record)
		end
	end

	local initial = math.floor(number("constants", "initial_firearms_keep", 2))
	local extra_chance = number("constants", "extra_firearm_chance", .05)
	for index, record in ipairs(weapons) do
		record.keep = index <= initial or math.random() < extra_chance
		if record.keep then
			table.insert(conditions, {record=record, value=weapon_condition(community, rank)})
		else
			table.insert(releases, record)
		end
	end

	for _, record in ipairs(normal) do
		if survival_factor[record.section] ~= nil then
			if not item_survives(record.section, community, rank) then table.insert(releases, record) end
		elseif not misery_lootable[record.section] then
			table.insert(releases, record)
			unknown[record.section] = true
		end
	end

	-- Mutation phase: never release/set/spawn while iterate_inventory is active.
	for _, record in ipairs(releases) do safe_release(record) end
	for _, action in ipairs(conditions) do safe_condition(action.record, action.value) end

	-- Retain the port's engine workaround, deduplication, and loaded magazines.
	-- Only the synthetic spare amount is halved relative to the prior port policy.
	local ammo_caps = {}
	for _, record in ipairs(weapons) do
		if record.keep then
			local ammo, cap = ammo_cap(record, community, rank, difficulty)
			if ammo and cap > (ammo_caps[ammo] or -1) then ammo_caps[ammo] = cap end
		end
	end
	local ammo_names = {}
	for ammo, _ in pairs(ammo_caps) do table.insert(ammo_names, ammo) end
	table.sort(ammo_names)
	local pos, lv, gv, nid
	local context_ok, context_err = pcall(function()
		pos, lv, gv, nid = npc:position(), npc:level_vertex_id(), npc:game_vertex_id(), npc:id()
	end)
	if context_ok and nid then
		for _, ammo in ipairs(ammo_names) do
			local rounds = half_ammo_roll(ammo_caps[ammo])
			if rounds > 0 and exists(ammo) then
				local ok, err = pcall(function() create_ammo(ammo, pos, lv, gv, nid, rounds) end)
				if not ok then log(string.format("ammo create failed npc=%s %s x%d: %s", tostring(nid), ammo, rounds, tostring(err))) end
			end
		end
	else
		log("ammo create skipped: missing corpse context: " .. tostring(context_err))
	end

	local examples, limit = {}, number("constants", "unknown_log_examples", 5)
	for section, _ in pairs(unknown) do table.insert(examples, section) end
	table.sort(examples)
	if #examples > 0 then
		local shown = {}
		for i = 1, math.min(#examples, limit) do shown[i] = examples[i] end
		log(string.format("npc=%s destroyed %d unknown section type(s): %s", tostring(nid or "?"), #examples, table.concat(shown, ",")))
	end
	return true
end
