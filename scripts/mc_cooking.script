-- mc_cooking.script
-- Misery_Coop_Port: server-authoritative cooking RPC (a per-player item-op channel).
--
-- WHY THIS EXISTS: the cooking UI (ui_itm_cooking) runs CLIENT-side -- it reads the local
-- player's inventory to pick a fuel + ingredients. But the mutations it then performs --
-- destroy the fuel + ingredients, create the cooked meals, hand the tool back -- are
-- alife():create / alife():release, which are SERVER-ONLY in coop (alife() is nil on a
-- pure client). So ui_itm_cooking computes the DECISION on the client (what to consume,
-- how much, which meal) and ships the exact ops here; the SERVER executes them against
-- that actor's inventory. The engine's normal alife->client sync then reflects the new
-- inventory back to the cooking player -- no server->client reply needed.
--
-- Transport: GM_MC_PLAYER_EVENT (104), the bidirectional per-player event channel that
-- mc_net reserves. mc_net.on_game_message routes every packet of that type to
-- on_player_event() here; the first payload byte is an event code.

local EVENT_COOK      = 1
local EVENT_LOOT      = 2
local EVENT_USE       = 3
local EVENT_SMOKE     = 4  -- client->server: create the next charge variant (+ the _smoke boost)
local EVENT_SMOKE_EAT = 5  -- server->client: eat the just-created _smoke boost (apply the effect)
local EVENT_GIVE      = 6  -- client->server: alife:create N of a section into the actor (item-wear)
local EVENT_RELEASE   = 7  -- client->server: alife:release an item by id (item-wear consume)
local EVENT_DEPLOY    = 8  -- client->server: alife:create a section in the WORLD (no parent) at the actor (deployables: backpack stash, ...)
local EVENT_RIDDLE    = 9  -- server->client: give the taker their next alun_riddle task locally (axr_quest_master.cl_on_riddle; the give-logic spawns server-side, but give_task is client-side)

-- SMOKING (effect + charges, no anims). Misery models a pack as a chain of item variants
-- (each puff = -1 charge = the next variant) and applies the buff by EATING a hidden
-- "<section>_smoke" booster (eat_satiety/eat_sleepiness/boost_radiation_restore/...). Both
-- the variant swap and the booster spawn are alife():create (server-only) -> they die in
-- coop; route them through the server like cooking, then eat the booster client-side.
-- Needs a lit lighter (Misery rule); the lighter drain is client-side (set_condition).
local SMOKE_NEXT = {
	marijuana="marijuana2", marijuana2="marijuana3",
	cigarettes="cigarettes2", cigarettes2="cigarettes3", cigarettes3="cigarettes4",
	cigar1="cigar1_2", cigar1_2="cigar1_3",
	cigar2="cigar2_2", cigar2_2="cigar2_3",
	cigar3="cigar3_2", cigar3_2="cigar3_3",
	tobacco="tobacco2", tobacco2="tobacco3", tobacco3="tobacco4", tobacco4="tobacco5",
	hand_rolling_tobacco="hand_rolling_tobacco2", hand_rolling_tobacco2="hand_rolling_tobacco3",
	hand_rolling_tobacco3="hand_rolling_tobacco4", hand_rolling_tobacco4="hand_rolling_tobacco5",
	cigarettes_lucky="cigarettes_lucky2", cigarettes_lucky2="cigarettes_lucky3", cigarettes_lucky3="cigarettes_lucky4",
	cigarettes_russian="cigarettes_russian2", cigarettes_russian2="cigarettes_russian3",
}
-- last-puff variants (smokable, but no next -> pack consumed after this one)
local SMOKE_TERMINAL = {
	marijuana3=true, cigarettes4=true, cigar1_3=true, cigar2_3=true, cigar3_3=true,
	tobacco5=true, hand_rolling_tobacco5=true, cigarettes_lucky4=true, cigarettes_russian3=true,
}

function is_smokable(section)
	return SMOKE_NEXT[section] ~= nil or SMOKE_TERMINAL[section] == true
end

-- CANNED FOOD (same shape as smoking): a can needs an opener TOOL, then spawns + eats a
-- "<section>_opened" food booster (the nutrition). Both alife():create = server -> route
-- through the SAME RPC as smoking (give_section="" , the _opened item is the eat target).
-- The openable cans are config-listed ([food_in_cans_list]); the opener tools mirror
-- itms_refunct.open_and_eat's cascade. Tool-wear (blunting the knife) is deferred.
local CAN_OPENERS = {
	"swiss", "swiss_sharp", "kit_hunt", "cutlery_sharp", "grooming_sharp",
	"shovel_mili_sharp", "shovel_old_sharp",
	"outfit_dismantler", "outfit_dismantler2", "outfit_dismantler3",
	"outfit_dismantler4", "outfit_dismantler5",
}
local _canfood = nil
local function canfood_set()
	if _canfood then return _canfood end
	local ini = ini_file and ini_file("plugins\\itms_manager.ltx")
	_canfood = (ini and alun_utils and alun_utils.collect_section(ini, "food_in_cans_list", true)) or {}
	return _canfood
end

function is_canned_food(section)
	return canfood_set()[section] == true
end

function has_can_opener(a)
	if not a then return false end
	for i = 1, #CAN_OPENERS do
		if a:object(CAN_OPENERS[i]) then return true end
	end
	-- a carried (sharp-enough) knife opens a can too
	return itms_refunct ~= nil and itms_refunct.choose_knife ~= nil
		and itms_refunct.choose_knife("foodcan") ~= nil
end

-- =====================================================================================
-- CLIENT  -- build + send a cook request.
--   ops = {
--     fuel_id  = <item id to destroy | 0>,
--     new_fuel = "<reduced-charge fuel section to spawn>" | "",  -- "" = fuel fully spent
--     parts    = { <ingredient item id>, ... },                  -- specific ids to destroy
--     meal     = "<cooked meal section>" | "",
--     count    = <how many meals to create>,
--     tool     = "<cooking tool section to give back>" | "",     -- Misery removes it on use
--   }
-- All decision logic lives on the client (it can read the inventory); the server is a
-- dumb, validated executor.
-- =====================================================================================
function request_cook(ops)
	if not OnClient() then return end                 -- only a real client originates a cook
	local a = getLocalActor()
	if not (a and ops) then return end

	local p = mc_net.new_message(mc_core.GM_MC_PLAYER_EVENT)
	p:w_u8(EVENT_COOK)
	p:w_u16(a:id())
	p:w_u16(ops.fuel_id or 0)
	p:w_stringZ(ops.new_fuel or "")

	local parts = ops.parts or {}
	local n = #parts
	if n > 64 then n = 64 end                          -- a single cook batch is small; cap defensively
	p:w_u8(n)
	for i = 1, n do p:w_u16(parts[i] or 0) end

	p:w_stringZ(ops.meal or "")
	p:w_u8(math.min(ops.count or 0, 255))
	p:w_stringZ(ops.tool or "")

	mc_net.send_to_server(p)
	mc_core.mc_log("cook request sent: %sx %s (%s ingredients, fuel->%s)",
		tostring(ops.count), tostring(ops.meal), tostring(n), tostring(ops.new_fuel))
end

-- =====================================================================================
-- mc_net entrypoint for GM_MC_PLAYER_EVENT. First byte selects the handler.
-- =====================================================================================
function on_player_event(packet)
	local ev = packet:r_u8()
	if ev == EVENT_COOK then
		sv_on_cook(packet)
	elseif ev == EVENT_LOOT then
		sv_on_loot(packet)
	elseif ev == EVENT_USE then
		cl_on_use(packet)
	elseif ev == EVENT_SMOKE then
		sv_on_smoke(packet)
	elseif ev == EVENT_SMOKE_EAT then
		cl_on_smoke_eat(packet)
	elseif ev == EVENT_GIVE then
		sv_on_give(packet)
	elseif ev == EVENT_RELEASE then
		sv_on_release(packet)
	elseif ev == EVENT_DEPLOY then
		sv_on_deploy(packet)
	elseif ev == EVENT_RIDDLE then
		if axr_quest_master and axr_quest_master.cl_on_riddle then axr_quest_master.cl_on_riddle(packet) end
	else
		mc_core.mc_log("! mc_cooking: unknown event code %s", tostring(ev))
	end
end

-- =====================================================================================
-- ITEM-USE FEEDBACK (server -> client). In this coop fork callback.use_object fires ONLY
-- on the server (the bind_stalker mp_actor_binder), so the client-side Misery item-use
-- handlers (cook UI / actor_effects / postproces_mod / multi-charge) never run. The server
-- binder calls notify_use(actor_id, obj) -> we ship the item id+section to that client, and
-- cl_on_use runs the handlers there (where getLocalActor() + the HUD exist).
-- =====================================================================================
function notify_use(actor_id, obj)
	if not OnServer() then return end
	if not (actor_id and obj) then return end
	local section = obj:section()
	-- bedding give-back: the base 'use' EATS the sleeping bag (it is a consumable class), but
	-- coop sleep just opens the picker -- the bedroll must survive. Re-create a fresh one into
	-- the actor (alife() is valid here, server-side); the engine still consumes the original,
	-- so net inventory is unchanged. (The eat animation is cosmetic.)
	if mc_sleep and mc_sleep.is_bedding and mc_sleep.is_bedding(section) and alife() then
		local se = alife():object(actor_id)
		if se and system_ini():section_exist(section) then
			alife():create(section, se.position, 0, 0, actor_id)
		end
	end
	local p = mc_net.new_message(mc_core.GM_MC_PLAYER_EVENT)
	p:w_u8(EVENT_USE)
	p:w_u16(obj:id())
	p:w_stringZ(section)
	mc_net.send_to_client(p, actor_id)
end

-- A real first-person consumable hud (bread_hud, medkit_hud, ...) means XRMPE/AGWP already animates
-- this item's use -> the engine plays that eat anim, so the ported Misery use-FX cinematic
-- (actor_effects item_fx cam-effector + postproces pp) would DOUBLE it. Used by BOTH coop use paths
-- (the local mp_actor_binder:use_inventory_item and this remote bridge) to suppress the duplicate.
function has_agwp_use_anim(section)
	if not section then return false end
	local sini = system_ini()
	-- the engine plays a first-person USE animation iff use_hud_anim=1 with a real hud -- the EXACT
	-- "XRMPE/AGWP already animates this use" condition (verified true for every coop food/drink/med/
	-- drug). Without the flag (e.g. a hud only for holding), the Misery use-FX is the ONLY animation,
	-- so it must stay.
	if not (sini:line_exist(section, "use_hud_anim") and sini:r_bool(section, "use_hud_anim")) then return false end
	local hud = (sini:line_exist(section, "hud") and sini:r_string(section, "hud")) or ""
	return hud ~= "" and hud ~= "device_flashlight_hud"
end

function cl_on_use(packet)
	if not OnClient() then return end
	local id      = packet:r_u16()
	local section = packet:r_stringZ()
	local a = getLocalActor()
	if not a then return end
	local obj = level.object_by_id(id)
	-- coop sleep: using sleeping gear opens the consent-sleep picker instead of the generic
	-- item-use FX. (itms_manager's own sleep path is disabled + alife()-unsafe on a client;
	-- this is the clean client-side trigger.) The bedding stays in inventory -> tier reads it.
	if mc_sleep and mc_sleep.is_bedding and mc_sleep.is_bedding(section) then
		if ui_sleep_dialog and ui_sleep_dialog.sleep then ui_sleep_dialog.sleep() end
		mc_core.mc_log("[sleep] bedding '%s' used -> open picker", tostring(section))
		return
	end
	-- coop smoking: a smokable (cigarette/cigar/tobacco/...) runs the lighter-gated puff via
	-- RPC (apply the _smoke buff + swap to the next charge variant), NOT the generic FX chain
	-- (whose Misery smoke path is the now-no-op'd item-wear). The original was already eaten
	-- by the base use; the server re-materialises the next variant (or gives it back).
	if is_smokable(section) then
		request_smoke(section)
		mc_core.mc_log("[smoke] '%s' used -> request_smoke", tostring(section))
		return
	end
	-- coop canned food: needs an opener tool, then spawn+eat the "<sec>_opened" nutrition via
	-- the smoke RPC (give_section="" so nothing is replaced; the _opened item is eaten). No
	-- opener -> hand the can back. The base 'use' already ate the can, so the server re-creates.
	if is_canned_food(section) then
		local a = getLocalActor()
		if has_can_opener(a) then
			send_smoke(a:id(), "", section .. "_opened")
			mc_core.mc_log("[canfood] '%s' opened -> eat %s_opened", tostring(section), tostring(section))
		else
			send_smoke(a:id(), section, "")
			smoke_msg("Need a knife or can-opener to open this.")
		end
		return
	end
	-- run the ported Misery item-use chain client-side (the section-only handler always
	-- runs; the obj-based ones run if the item still exists -- it may already be consumed).
	-- pcall each: a Misery handler that indexes a coop-nil must degrade+log, not FATAL.
	local function _pc(fn, arg)
		local ok, err = pcall(fn, arg)
		if not ok then mc_core.mc_log("[itms] use handler fail: %s", tostring(err)) end
	end
	-- COOP ANIM FIX (see has_agwp_use_anim): skip the Misery use-FX cinematic for items XRMPE/AGWP
	-- already animates, else the engine eat anim + the Misery one DOUBLE (bread "eat twice + fade +
	-- ~15s cam lockout"). The eat EFFECT (eat_* satiety) is engine-applied regardless.
	local _agwp_anim = has_agwp_use_anim(section)
	if obj and axr_main and axr_main.actor_on_item_use then _pc(axr_main.actor_on_item_use, obj) end
	if not _agwp_anim and actor_effects and actor_effects.use_item then _pc(actor_effects.use_item, section) end
	if not _agwp_anim and obj and postproces_mod and postproces_mod.use_obj then _pc(postproces_mod.use_obj, obj) end
	mc_core.mc_log("[itms] cl_on_use sec=%s agwp_anim=%s", tostring(section), tostring(_agwp_anim))
end

-- =====================================================================================
-- MUTANT HARVEST (marriage of MSO trophy parts + Misery meat). The use-corpse callback
-- (itms_manager.monster_on_actor_use_callback) runs CLIENT-side and resolves the loot-
-- table name from the corpse class; the actual drop is alife():create = SERVER-only, so
-- it ships the table name here. The server rolls Misery's [<table>] loot list (section,
-- amount, chance) and creates the parts into the looting actor. No knife-gutting, no UI.
-- =====================================================================================
function request_loot(loot_table)
	if not OnClient() then return end
	local a = getLocalActor()
	if not (a and loot_table and loot_table ~= "") then return end
	local p = mc_net.new_message(mc_core.GM_MC_PLAYER_EVENT)
	p:w_u8(EVENT_LOOT)
	p:w_u16(a:id())
	p:w_stringZ(loot_table)
	mc_net.send_to_server(p)
	mc_core.mc_log("loot request sent: table '%s'", tostring(loot_table))
end

function sv_on_loot(packet)
	if not OnServer() then return end
	local actor_id   = packet:r_u16()
	local loot_table = packet:r_stringZ()
	local se_actor = alife() and alife():object(actor_id)
	if not (se_actor and loot_table and loot_table ~= "") then return end

	local ini = ini_file("plugins\\itms_manager.ltx")
	local rows = ini and alun_utils and alun_utils.collect_section(ini, loot_table)
	if not rows then
		mc_core.mc_log("! loot: no table '%s'", tostring(loot_table)); return
	end
	local made = 0
	for i = 1, #rows do
		local e = alun_utils.str_explode(rows[i], ",")
		if e and e[1] and e[2] then
			local section = tostring(e[1]):gsub("%s+", "")          -- trim any whitespace
			local amount  = tonumber(e[2]) or 0
			local chance  = e[3] and tonumber(e[3]) or 1
			if section ~= "" and system_ini():section_exist(section) then
				for _ = 1, amount do
					if math.random() <= chance then
						alife():create(section, se_actor.position, 0, 0, actor_id)
						made = made + 1
					end
				end
			end
		end
	end
	mc_core.mc_log("loot done: actor %s table '%s' -> %s part(s)", tostring(actor_id), tostring(loot_table), tostring(made))
end

-- =====================================================================================
-- SERVER  -- execute the cook ops. alife() is valid here.
-- =====================================================================================
-- parent_id = the actor id routes the new item straight into the actor's inventory, so
-- the 0,0 level/game vertices are nominal (mirrors itms_manager.loot_mutant's own create).
local function sv_actor_create(section, se_actor, actor_id)
	if not section or section == "" then return end
	if not system_ini():section_exist(section) then
		mc_core.mc_log("! cook: skip create of undeployed section '%s'", tostring(section))
		return
	end
	alife():create(section, se_actor.position, 0, 0, actor_id)
end

local function sv_release_id(id)
	if not id or id == 0 then return end
	local o = alife():object(id)
	if o then alife():release(o, true) end
end

function sv_on_cook(packet)
	if not OnServer() then return end                 -- mutate only on the authoritative server
	local actor_id = packet:r_u16()
	local fuel_id  = packet:r_u16()
	local new_fuel = packet:r_stringZ()
	local n        = packet:r_u8()
	local parts    = {}
	for i = 1, n do parts[i] = packet:r_u16() end
	local meal     = packet:r_stringZ()
	local count    = packet:r_u8()
	local tool     = packet:r_stringZ()

	local se_actor = alife() and alife():object(actor_id)
	if not se_actor then
		mc_core.mc_log("! cook: no server actor for id %s", tostring(actor_id))
		return
	end

	-- 1) consume the fuel: destroy the used item, spawn its reduced-charge variant (if any)
	sv_release_id(fuel_id)
	sv_actor_create(new_fuel ~= "" and new_fuel or nil, se_actor, actor_id)
	-- 2) consume the ingredients the client selected (specific ids)
	for i = 1, n do sv_release_id(parts[i]) end
	-- 3) create the cooked meals
	if meal ~= "" and count > 0 then
		for i = 1, count do sv_actor_create(meal, se_actor, actor_id) end
	end
	-- 4) hand the cooking tool back (Misery removes the tool when it is used)
	sv_actor_create(tool ~= "" and tool or nil, se_actor, actor_id)

	mc_core.mc_log("cook done: actor %s -> %sx %s | fuel#%s->%s | %s ingredient(s) | tool %s",
		tostring(actor_id), tostring(count), tostring(meal),
		tostring(fuel_id), tostring(new_fuel), tostring(n), tostring(tool))
end

-- =====================================================================================
-- SMOKING (effect + charges, no anims). Trigger: cl_on_use sees a smokable section.
-- =====================================================================================
-- CLIENT: gate on a lit lighter (client-side reads + drain), then ship the ops. The base
-- 'use' already ate the original cigarette, so the server re-materialises either the next
-- charge variant (lighter ok) or the original itself (no lighter = give-back, no puff).
function request_smoke(section)
	if not OnClient() then return end
	local a = getLocalActor()
	if not (a and section) then return end

	local lit
	if itms_refunct then
		local n = (itms_refunct.how_many_items and itms_refunct.how_many_items("lighter")) or 0
		if n >= 1 and itms_refunct.choose_lighter then
			lit = itms_refunct.choose_lighter("smoke")
		end
	end

	if not lit then
		send_smoke(a:id(), section, "")          -- give the cigarette back; no boost
		smoke_msg("Need a working lighter to smoke.")
		return
	end
	if itms_refunct.drain_lighter then itms_refunct.drain_lighter(lit, "smoke") end
	send_smoke(a:id(), SMOKE_NEXT[section] or "", section .. "_smoke")
end

function send_smoke(actor_id, give_section, smoke_section)
	local p = mc_net.new_message(mc_core.GM_MC_PLAYER_EVENT)
	p:w_u8(EVENT_SMOKE)
	p:w_u16(actor_id)
	p:w_stringZ(give_section or "")
	p:w_stringZ(smoke_section or "")
	mc_net.send_to_server(p)
end

-- SERVER: create the give_section (next variant / give-back) + the _smoke booster, then tell
-- the client to eat the booster (the actual buff -- eat is a client game_object method).
function sv_on_smoke(packet)
	if not OnServer() then return end
	local actor_id      = packet:r_u16()
	local give_section  = packet:r_stringZ()
	local smoke_section = packet:r_stringZ()
	local se = alife() and alife():object(actor_id)
	if not se then return end

	if give_section ~= "" and system_ini():section_exist(give_section) then
		alife():create(give_section, se.position, 0, 0, actor_id)
	end
	if smoke_section ~= "" and system_ini():section_exist(smoke_section) then
		alife():create(smoke_section, se.position, 0, 0, actor_id)
		local p = mc_net.new_message(mc_core.GM_MC_PLAYER_EVENT)
		p:w_u8(EVENT_SMOKE_EAT)
		p:w_stringZ(smoke_section)
		mc_net.send_to_client(p, actor_id)
	end
	mc_core.mc_log("smoke: actor %s give='%s' boost='%s'", tostring(actor_id), tostring(give_section), tostring(smoke_section))
end

-- CLIENT: eat the just-spawned _smoke booster to apply the buff. The alife->client sync can
-- lag the RPC, so queue it and retry from mc_player_loop until the item appears (short cap).
local _pending_smoke = nil
function cl_on_smoke_eat(packet)
	if not OnClient() then return end
	_pending_smoke = { section = packet:r_stringZ(), tries = 60 }
	try_eat_smoke()
end

function try_eat_smoke()
	if not _pending_smoke then return end
	local a = getLocalActor()
	if not a then _pending_smoke = nil; return end
	local itm = a:object(_pending_smoke.section)
	if itm then
		a:eat(itm)
		mc_core.mc_log("[smoke] effect applied: %s", tostring(_pending_smoke.section))
		_pending_smoke = nil
	else
		_pending_smoke.tries = _pending_smoke.tries - 1
		if _pending_smoke.tries <= 0 then
			mc_core.mc_log("[smoke] boost item never synced: %s", tostring(_pending_smoke.section))
			_pending_smoke = nil
		end
	end
end

function smoke_msg(text)
	local a = getLocalActor()
	if a and news_manager and news_manager.send_tip then
		news_manager.send_tip(a, tostring(text), nil, nil, nil)
	end
end

-- =====================================================================================
-- GENERIC ITEM-WEAR OPS (server-side alife create/release). itms_refunct give/get_rid_of
-- run client-side (item-use chain) but do alife():create/release = server-only -> they
-- were no-op'd to stop crashes, which killed tool degradation everywhere. Route them here:
-- the client ships the op, the server executes (same proven path as cooking).
-- =====================================================================================
function itemop_give(section, amount)
	if not OnClient() then return end
	local a = getLocalActor()
	if not (a and section and section ~= "") then return end
	local p = mc_net.new_message(mc_core.GM_MC_PLAYER_EVENT)
	p:w_u8(EVENT_GIVE)
	p:w_u16(a:id())
	p:w_stringZ(section)
	p:w_u8(math.min(amount or 1, 255))
	mc_net.send_to_server(p)
end

function sv_on_give(packet)
	if not OnServer() then return end
	local actor_id = packet:r_u16()
	local section  = packet:r_stringZ()
	local amount   = packet:r_u8()
	local se = alife() and alife():object(actor_id)
	if not (se and section ~= "" and system_ini():section_exist(section)) then return end
	for _ = 1, amount do alife():create(section, se.position, 0, 0, actor_id) end
	mc_core.mc_log("[itemop] give %sx %s -> actor %s", tostring(amount), tostring(section), tostring(actor_id))
end

function itemop_release(id)
	if not OnClient() then return end
	if not (id and id ~= 0) then return end
	local p = mc_net.new_message(mc_core.GM_MC_PLAYER_EVENT)
	p:w_u8(EVENT_RELEASE)
	p:w_u16(id)
	mc_net.send_to_server(p)
end

function sv_on_release(packet)
	if not OnServer() then return end
	local id = packet:r_u16()
	local o = alife() and alife():object(id)
	if o then alife():release(o, true); mc_core.mc_log("[itemop] release id %s", tostring(id)) end
end

-- =====================================================================================
-- DEPLOYABLES (world-spawn). itemop_give parents the new object to the actor (-> the
-- actor's inventory, which syncs). A DEPLOYABLE is created with NO parent at the actor's
-- world position, so the alife simulation streams it to every nearby client -- the same
-- path the base game uses to populate the world with items/NPCs. Used by the backpack
-- stash (inv_backpack); tents reuse it. The naming dialog + map spot (which need the
-- spawned id synchronously) are dropped in coop -- server-authoritative, no UI. NOTE:
-- whether the spawned world CONTAINER syncs/persists/opens for all clients is a RUNTIME
-- property that needs the user's playtest to confirm (static port only).
-- =====================================================================================
function request_deploy(section)
	if not OnClient() then return end
	local a = getLocalActor()
	if not (a and section and section ~= "") then return end
	local p = mc_net.new_message(mc_core.GM_MC_PLAYER_EVENT)
	p:w_u8(EVENT_DEPLOY)
	p:w_u16(a:id())
	p:w_stringZ(section)
	mc_net.send_to_server(p)
	mc_core.mc_log("deploy request: %s", tostring(section))
end

function sv_on_deploy(packet)
	if not OnServer() then return end
	local actor_id = packet:r_u16()
	local section  = packet:r_stringZ()
	local se = alife() and alife():object(actor_id)
	if not (se and section ~= "" and system_ini():section_exist(section)) then return end
	-- no parent = world object at the actor's position (streamed to nearby clients)
	alife():create(section, se.position, se.m_level_vertex_id, se.m_game_vertex_id)
	mc_core.mc_log("[deploy] %s at actor %s", tostring(section), tostring(actor_id))
end
