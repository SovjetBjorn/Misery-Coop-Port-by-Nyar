-- ui_sleep_dialog.script  (Misery_Coop_Port shadow)
-- Coop hour-picker for the consent-sleep. This OVERRIDES the base-coop ui_sleep_dialog:
-- the base version broadcast GM_SCRIPT_SLEEP directly (one player skipped time for all);
-- here the Sleep button only OPENS THE VOTE -- mc_sleep.request_sleep(hours) asks every
-- other player first (see mc_sleep.script). The actual fade + change_game_time + rest
-- booster all live in mc_sleep now, so this file is purely the initiator's UI.
--
-- The window itself reuses the deployed ui_sleep_dialog.xml (the base coop ships it, so
-- no new .xml), and the show path mirrors the working cook UI: HideActorMenu() to hand
-- the dialog input focus, then ShowDialog(true).

local sleep_control = nil
local sleep_st_tbl = {}
local sleep_static_base_width = 0

class "sleep_dialog" (CUIScriptWnd)

function sleep_dialog:__init() super()
	if IsDedicatedServer() then return end
	self:SetWndRect(Frect():set(0, 0, device().width, device().height))

	local xml = CScriptXmlInit()
	xml:ParseFile("ui_sleep_dialog.xml")

	self.back = xml:InitStatic("background", self)
	self.sleep_static  = xml:InitStatic("sleep_static", self.back)
	self.sleep_static2 = xml:InitStatic("sleep_static", self.back)
	self.static_cover  = xml:InitStatic("static_cover", self.back)
	self.st_marker     = xml:InitStatic("st_marker", self.static_cover)
	sleep_static_base_width = self.sleep_static:GetWidth()

	sleep_st_tbl = {}
	for i = 1, 24 do
		sleep_st_tbl[i] = xml:InitStatic("sleep_st_" .. i, self.back)
	end

	self.time_track = xml:InitTrackBar("time_track", self.back)
	self:Register(self.time_track, "time_track")
	self.btn_sleep = xml:Init3tButton("btn_sleep", self.back)
	self:Register(self.btn_sleep, "btn_sleep")
	self.btn_cancel = xml:Init3tButton("btn_cancel", self.back)
	self:Register(self.btn_cancel, "btn_cancel")
	self.sleep_mb = CUIMessageBoxEx()
	self:Register(self.sleep_mb, "sleep_mb")

	self:AddCallback("btn_sleep",  ui_events.BUTTON_CLICKED,          self.OnButtonSleep,  self)
	self:AddCallback("btn_cancel", ui_events.BUTTON_CLICKED,          self.OnButtonCancel, self)
	self:AddCallback("sleep_mb",   ui_events.MESSAGE_BOX_OK_CLICKED,  self.OnMessageBoxOk, self)
end

function sleep_dialog:Initialize()
	local cur_hours = level.get_time_hours()
	for i = 1, 24 do
		local hours = cur_hours + i
		if hours >= 24 then hours = hours - 24 end
		sleep_st_tbl[i]:TextControl():SetText(hours .. game.translate_string("st_sleep_hours"))
	end
	local delta = math.floor(591 / 24 * cur_hours)
	self.sleep_static:SetTextureRect(Frect():set(delta, 413, 591, 531))
	self.sleep_static:SetWndSize(vector2():set(sleep_static_base_width * (591 - delta) / 591, self.sleep_static:GetHeight()))
	self.sleep_static2:SetTextureRect(Frect():set(0, 413, delta, 531))
	self.sleep_static2:SetWndSize(vector2():set(sleep_static_base_width * delta / 591, self.sleep_static2:GetHeight()))
	local pos = self.sleep_static2:GetWndPos()
	pos.x = self.sleep_static:GetWndPos().x + self.sleep_static:GetWidth()
	self.sleep_static2:SetWndPos(pos)
end

function sleep_dialog:Update()
	CUIScriptWnd.Update(self)
	local sleep_time = self.time_track:GetIValue() - 1
	local x = math.floor(sleep_static_base_width / 24 * sleep_time)
	if x == 0 then x = 5 end
	self.st_marker:SetWndPos(vector2():set(x, self.st_marker:GetWndPos().y))
end

-- COOP: Sleep no longer sleeps -- it opens the vote. Local pre-check gives instant
-- feedback (bleeding/etc.) before bothering the other players; mc_sleep re-checks anyway.
function sleep_dialog:OnButtonSleep()
	local hours = self.time_track:GetIValue()
	self:HideDialog()
	if mc_sleep and mc_sleep.request_sleep then
		mc_sleep.request_sleep(hours)
	end
end

function sleep_dialog:OnButtonCancel()
	self:HideDialog()
end

function sleep_dialog:OnMessageBoxOk()
end

--------------------------------------------------------------------------------
-- entry points itms_manager calls on sleep-gear use. They IGNORE the passed se_obj
-- (the base/Misery deploy-a-physobj id) -- in coop the gear stays in inventory and
-- mc_sleep.cl_my_tier reads it there; deploying a physobj needs alife() (server-only)
-- and is a later refinement. Each just focuses + shows the picker.
--------------------------------------------------------------------------------
local function open_picker()
	if IsDedicatedServer() then return end
	if sleep_control == nil then
		sleep_control = ui_sleep_dialog.sleep_dialog()
	end
	local hud = get_hud()
	if hud then hud:HideActorMenu() end          -- coop: hand the picker input focus (cook-UI pattern)
	sleep_control.time_track:SetCurrentValue()
	sleep_control:Initialize()
	sleep_control:ShowDialog(true)
	return sleep_control
end

function sleep()            return open_picker() end
function main()             return open_picker() end
function sleep_bag(_, _)    return open_picker() end
function sleep_in_nrc(_, _) return open_picker() end
function sleep_in_tent(_)   return open_picker() end

-- Safety stub: the base game_cl.script still routes GM_SCRIPT_SLEEP here. Our flow uses
-- mc_sleep's own channel, so a stray GM_SCRIPT_SLEEP is a no-op rather than a nil-call.
function start_sleep(_) end

-- forced sleep = the fatigue/drowse passout (postproces_mod calls this when drowse maxes).
-- DEFERRED in coop: an involuntary single-player time-skip fights the consent model + the
-- shared server clock. No-op stub so the drowse system doesn't nil-call; voluntary sleep
-- via the picker still works. (Could become a local-only black-out fade later.)
function sleep_forced(_) end
