-- PORT_NOTES (Misery_Coop_Port, tools/build_cooking.py) -- coop-adapted
-- Misery item-refunct helpers, coop. The lighter slice (how_many_items /
-- choose_lighter / drain_lighter) is client-side inventory reads on the local
-- player (db.actor->getLocalActor). The item-WEAR mutators (give / get_rid_of /
-- release_amount) carry alife():create/release = server-only; each now routes
-- through the mc_cooking item-wear RPC on a client and falls through to the
-- original direct call on a listen-host. That unlocked the downstream features
-- as they were ported: canned food, smoking, lighter refuel, and (this pass)
-- SHARPENING -- sharpen_tools now runs client-side, its stone-degrade gives/
-- releases + the no-stones give-back all RPC-routed. Lighter drain uses
-- set_condition on the local lighter; condition-sync is a runtime detail.
-- use_tools_on_mutant rewritten CHECK-ONLY: the harvest tool REQUIREMENT (a
-- pure inventory test, client-side) with the item-wear/consumption dropped
-- (get_rid_of/give are alife():release/create = server-only; tool degradation
-- would need a separate RPC -- a follow-up). Returns true=halt (no tool).

-----------------------------------------------------------------
---- Items refunct mod ---- by Plaargath ---- for MISERY mod ----
-----------------------------------------------------------------
function get_float(section,line)
	return ini_file("plugins\\itms_manager.ltx"):r_float(section,line)
end

function how_many_items(section)
	local amount = 0
	for i = 0, getLocalActor():object_count() - 1 do -- thx tt44
		if getLocalActor():object(i):section() == section then
			amount = amount + 1
		end
	end
	return amount
end

function give(section,amount)
	if not getLocalActor() then return end
	if not alife() then if mc_cooking then mc_cooking.itemop_give(section, amount or 1) end return end
	if not amount then amount = 1 end
	for i = 1, amount do
		alife():create(section,getLocalActor():position(),0,0,0)
	end
end

function get_rid_of(obj)
	if not obj then return end
	if not alife() then if mc_cooking then mc_cooking.itemop_release(obj:id()) end return end
	alife():release(alife():object(obj:id()), true)
end

function release_amount(section, amount)
	if not getLocalActor() then return end
	if not alife() then  -- client: release N of section by id via the item-wear RPC
		for i = 0, getLocalActor():object_count() - 1 do
			if amount > 0 and getLocalActor():object(i):section() == section then
				if mc_cooking then mc_cooking.itemop_release(getLocalActor():object(i):id()) end
				amount = amount - 1
			end
		end
		return
	end
	for i = 0, getLocalActor():object_count() - 1 do -- thx tt44
		if amount > 0 and getLocalActor():object(i):section() == section then
			alife():release(alife():object(getLocalActor():object(i):id()))
			amount = amount - 1
		end
	end
end

function hit_obj(target, strength, hit_type)
	local h = hit()
	h.draftsman	= target
	h.direction	= vector():set(0,0,0)
	h.power		= strength
	h.impulse	= 1
	h.type		= hit_type
	target:hit(h)
end

function sharpen_tools(obj)
	if not getLocalActor() then return end  -- coop: client-side; item-wear is RPC-routed
	local sec = obj:section()
	local sec_sharp = tostring(sec.."_sharp")
	local has_any_tools, has_only_weak_tools, tools_wear

	local t_tools = {
		[1] = "sharpening_stones",  -- 4 uses left
		[2] = "sharpening_stones2", -- 3 uses left
		[3] = "sharpening_stones3", -- 2 uses left
		[4] = "sharpening_stones4"  -- 1 use  left
	}

	for i = 1,#t_tools do
		if i <= #t_tools -1 then
			if getLocalActor():object(t_tools[i]) then
				has_any_tools = true
			end
		else
			if getLocalActor():object(t_tools[i]) and not has_any_tools then
				has_any_tools = true
				has_only_weak_tools = true
			end
		end
	end

	if not has_any_tools then
		hud_caption("st_sharp_need_stones")
		if not alife() then if mc_cooking then mc_cooking.itemop_give(sec, 1) end return end
		return alife():create(sec,getLocalActor():position(),0,0,0)
	end

	if (not string.find(sec, "shovel")) then
		tools_wear = 1

		for i = #t_tools,1,-1 do
			if i <= 3 then
				if getLocalActor():object(t_tools[i]) then
					give(t_tools[i+tools_wear])
					get_rid_of(getLocalActor():object(t_tools[i]))
					give(sec_sharp)
					actor_effects.use_item("sharpening_stones_dummy")
					break
				end
			else
				if getLocalActor():object(t_tools[i]) then
					get_rid_of(getLocalActor():object(t_tools[i]))
					give(sec_sharp)
					actor_effects.use_item("sharpening_stones_dummy")
					break
				end
			end
		end

	else
		tools_wear = 2

		for i = #t_tools,1,-1 do
			if i <= 2 then
				if getLocalActor():object(t_tools[i]) then
					give(t_tools[i+tools_wear])
					get_rid_of(getLocalActor():object(t_tools[i]))
					give(sec_sharp)
					actor_effects.use_item("sharpening_stones_dummy")
					break
				end
			elseif i == 3 then
				if getLocalActor():object(t_tools[i]) then
					get_rid_of(getLocalActor():object(t_tools[i]))
					give(sec_sharp)
					actor_effects.use_item("sharpening_stones_dummy")
					break
				end
			elseif i == 4 then
				if getLocalActor():object(t_tools[i]) then
					local amount = how_many_items(t_tools[i])
					if amount >= 2 then
						release_amount(t_tools[i], 2)
						give(sec_sharp)
						actor_effects.use_item("sharpening_stones_dummy")
						break
					elseif has_only_weak_tools and amount == 1 then
						hud_caption("st_sharp_need_more_stones")
						give(sec)
						break
					end
				end
			end
		end
	end
end

local chosen_knife
function choose_knife(purpose)
	chosen_knife = nil
	local compare_con = 1.1
	local purpose_lowest_con

	if purpose == "foodcan" then
		purpose_lowest_con = get_float("sharpening_config","lowest_condition_for_knife_on_food")
	elseif purpose == "mutantloot" then
		purpose_lowest_con = get_float("sharpening_config","lowest_condition_for_knife_on_mutant")
	end

	for i = 0, getLocalActor():object_count() - 1 do
		if string.find(getLocalActor():object(i):section(), "wpn_knife_") then
			local next_con = getLocalActor():object(i):condition()
			if (next_con > purpose_lowest_con) and (next_con < compare_con) then
				compare_con = next_con
				chosen_knife = getLocalActor():object(i)
			end
		end
	end

	return chosen_knife
end

local chosen_axe
function choose_axe(purpose)
	chosen_axe = nil
	local compare_con = 1.1
	local purpose_lowest_con

	if purpose == "mutantloot" then
		purpose_lowest_con = get_float("sharpening_config","lowest_condition_for_axe_on_mutant")
	end

	for i = 0, getLocalActor():object_count() - 1 do
		if string.find(getLocalActor():object(i):section(), "wpn_axe") then
			local next_con = getLocalActor():object(i):condition()
			if (next_con > purpose_lowest_con) and (next_con < compare_con) then
				compare_con = next_con
				chosen_axe = getLocalActor():object(i)
			end
		end
	end

	return chosen_axe
end

function blunt_knife(used_knife,purpose,percent)
	local cond = used_knife:condition()
	local sect = used_knife:section()

	if purpose == "mutantloot" then
		if sect == "wpn_knife_inv_3" then
			cond = cond - get_float("sharpening_config","blunt_wpn_knife_inv_3_on_mutant")
		elseif sect == "wpn_knife_inv" then
			cond = cond - get_float("sharpening_config","blunt_wpn_knife_inv_on_mutant")
		elseif sect == "wpn_knife_inv_2" then
			cond = cond - get_float("sharpening_config","blunt_wpn_knife_inv_2_on_mutant")
		elseif sect == "wpn_knife_m" then
			cond = cond - get_float("sharpening_config","blunt_wpn_knife_m_on_mutant")
		elseif sect == "wpn_knife_inv_5" then
			cond = cond - get_float("sharpening_config","blunt_wpn_knife_inv_5_on_mutant")
		elseif sect == "wpn_knife_inv_4" then
			cond = cond - get_float("sharpening_config","blunt_wpn_knife_inv_5_on_mutant")
		end

	elseif purpose == "foodcan" then
		cond = cond - get_float("sharpening_config","blunt_knife_on_food")

	elseif purpose == "dismantle" then
		if percent then
			cond = cond - percent
		else
			cast_error("Unknown knife condition decrease.","itms_refunct.blunt_knife()")
		end
	end

	used_knife:set_condition(cond)
end

function blunt_axe(used_axe,purpose,percent)
	local cond = used_axe:condition()
	local sect = used_axe:section()

	if purpose == "mutantloot" then
		cond = cond - get_float("sharpening_config","blunt_axe_on_mutant")

	elseif purpose == "dismantle" then
		if percent then
			cond = cond - percent
		else
			cast_error("Unknown axe condition decrease.","itms_refunct.blunt_axe()")
		end
	end

	used_axe:set_condition(cond)
end

function use_tools_on_mutant(obj)
	-- coop: tool REQUIREMENT only -- a pure inventory check (Misery's original has
	-- no animations). Returns true (halt, no loot) when no harvest tool is carried.
	-- Item-wear/consumption is intentionally dropped (it would need a server RPC).
	local a = getLocalActor()
	if not a then return true end
	if a:object("kit_hunt") ~= nil then return false
	elseif choose_knife("mutantloot") ~= nil then return false
	elseif choose_axe("mutantloot") ~= nil then return false
	elseif a:object("swiss_sharp") ~= nil then return false
	elseif a:object("shovel_mili_sharp") ~= nil then return false
	elseif a:object("shovel_old_sharp") ~= nil then return false
	elseif a:object("cutlery_sharp") ~= nil then return false
	elseif a:object("grooming_sharp") ~= nil then return false
	elseif a:object("mutant_part_chimera_claw") ~= nil then return false
	elseif a:object("outfit_dismantler5") ~= nil then return false
	elseif a:object("outfit_dismantler4") ~= nil then return false
	elseif a:object("outfit_dismantler3") ~= nil then return false
	elseif a:object("outfit_dismantler2") ~= nil then return false
	elseif a:object("outfit_dismantler") ~= nil then return false
	else
		itms_manager.show_message(game.translate_string("st_mutloot_need_tool"),25)
		return true
	end
end

local chosen_lighter
function choose_lighter(purpose)
	chosen_lighter = nil
	local compare_con = 1.1
	local purpose_lowest_con
	if purpose == "smoke" then
		purpose_lowest_con = get_float("lighter_config","lowest_condition_for_lighter_on_smoke")
	elseif purpose == "fieldcooker" then
		purpose_lowest_con = get_float("lighter_config","lowest_condition_for_lighter_on_fieldcooker")
	elseif purpose == "wood_stove" then
		purpose_lowest_con = get_float("lighter_config","lowest_condition_for_lighter_on_wood_stove")
	else
		return
	end
	for i = 0, getLocalActor():object_count() - 1 do
		if getLocalActor():object(i):section() == "lighter" then
			local next_con = getLocalActor():object(i):condition()
			if (next_con >= purpose_lowest_con) and (next_con < compare_con) then
				compare_con = next_con
				chosen_lighter = getLocalActor():object(i)
			end
		end
	end
	return chosen_lighter
end

function drain_lighter(used_lighter,purpose)
	local cond = used_lighter:condition()
	if purpose == "smoke" then
		cond = cond - get_float("lighter_config","drain_lighter_on_smoke")
	elseif purpose == "fieldcooker" then
		cond = cond - get_float("lighter_config","drain_lighter_on_fieldcooker")
	elseif purpose == "wood_stove" then
		cond = cond - get_float("lighter_config","drain_lighter_on_wood_stove")
	end
	used_lighter:set_condition(cond)
end

function refuel_target(obj)
	local getback = obj:section()
	local target = getLocalActor():object("lighter")
	local target_sec = "lighter"
	local chosen_target, chosen_target_con
	local full_condition = get_float("lighter_config","lighter_considered_full_on_con")

	if target == nil then
		hud_caption("st_lighter_refill_no_target")
		give(getback)
		return
	elseif how_many_items(target_sec) == 1 then
		chosen_target = target
		chosen_target_con = target:condition()
		if chosen_target_con >= full_condition then
			hud_caption("st_lighter_refill_target_full")
			give(getback)
			return
		end
	elseif how_many_items(target_sec) > 1 then
		local lowest_con = 1
		for i = 0, getLocalActor():object_count() - 1 do
			if getLocalActor():object(i):section() == target_sec then
				local next_con = getLocalActor():object(i):condition()
				if (next_con >= 0) and (next_con < lowest_con) then
					lowest_con = next_con
					chosen_target = getLocalActor():object(i)
					chosen_target_con = lowest_con
				end
			end
		end
		if lowest_con >= full_condition then
			hud_caption("st_lighter_refill_all_targets_full")
			give(getback)
			return
		end
	end

	local tools_wear = 1
	local tools_gain = 1
	local set_con
	local t_tools = {
		[1] = "lighter_refiller1",
		[2] = "lighter_refiller2",
		[3] = "lighter_refiller3",
		[4] = "lighter_refiller4",
		[5] = "lighter_refiller5"
	}

	for i = 1,#t_tools do
		if getback == t_tools[i] then
			if i ~= 1 then
				give(t_tools[i-tools_wear])
			end
		end
	end

	set_con = chosen_target_con + tools_gain
	chosen_target:set_condition(set_con)
	actor_effects.use_item("lighter_refillers")
end

function reduce_smoke_portion(obj)
	local sec = obj:section()
	if sec == "marijuana"				then give("marijuana2") end
	if sec == "marijuana2"				then give("marijuana3") end
	if sec == "cigarettes"				then give("cigarettes2") end
	if sec == "cigarettes2"				then give("cigarettes3") end
	if sec == "cigarettes3"				then give("cigarettes4") end
	if sec == "cigar1"					then give("cigar1_2") end
	if sec == "cigar1_2"				then give("cigar1_3") end
	if sec == "cigar2"					then give("cigar2_2") end
	if sec == "cigar2_2"				then give("cigar2_3") end
	if sec == "cigar3"					then give("cigar3_2") end
	if sec == "cigar3_2"				then give("cigar3_3") end
	if sec == "tobacco"					then give("tobacco2") end
	if sec == "tobacco2"				then give("tobacco3") end
	if sec == "tobacco3"				then give("tobacco4") end
	if sec == "tobacco4"				then give("tobacco5") end
	if sec == "hand_rolling_tobacco"	then give("hand_rolling_tobacco2") end
	if sec == "hand_rolling_tobacco2"	then give("hand_rolling_tobacco3") end
	if sec == "hand_rolling_tobacco3"	then give("hand_rolling_tobacco4") end
	if sec == "hand_rolling_tobacco4"	then give("hand_rolling_tobacco5") end
	if sec == "cigarettes_lucky"		then give("cigarettes_lucky2") end
	if sec == "cigarettes_lucky2"		then give("cigarettes_lucky3") end
	if sec == "cigarettes_lucky3"		then give("cigarettes_lucky4") end
	if sec == "cigarettes_russian"		then give("cigarettes_russian2") end
	if sec == "cigarettes_russian2"		then give("cigarettes_russian3") end
end

function light_up_and_eat(obj)
	local sec = obj:section()
	local sec_smoke = tostring(sec.."_smoke")
	local has_one_lighter, has_lighters

	local amount = how_many_items("lighter")
	if amount >= 1 then has_lighters = true end
	if amount == 1 then has_one_lighter = true end

	chosen_lighter = choose_lighter("smoke")

	if not has_lighters then
		hud_caption("st_lighter_no")
		give(sec)
	elseif has_one_lighter and not chosen_lighter then
		getLocalActor():hide_weapon()
		hud_caption("st_lighter_dead")
		getLocalActor():restore_weapon()
		give(sec)
	elseif has_lighters and not chosen_lighter then
		getLocalActor():hide_weapon()
		hud_caption("st_lighter_all_dead")
		getLocalActor():restore_weapon()
		give(sec)
	elseif chosen_lighter then
		drain_lighter(chosen_lighter,"smoke")
		give(sec_smoke)
		getLocalActor():eat(getLocalActor():object(sec_smoke))
		reduce_smoke_portion(obj)
	end
end

function open_and_eat(obj)
	local sec_display
	local sec = obj:section()
	local sec_opened = sec.."_opened"
	chosen_knife = choose_knife("foodcan")

	if getLocalActor():object("swiss") then
		give(sec_opened)
		getLocalActor():eat(getLocalActor():object(sec_opened))
		sec_display = "swiss"

	elseif getLocalActor():object("swiss_sharp") then
		give(sec_opened)
		getLocalActor():eat(getLocalActor():object(sec_opened))
		sec_display = "swiss_sharp"

	elseif getLocalActor():object("kit_hunt") then
		give(sec_opened)
		getLocalActor():eat(getLocalActor():object(sec_opened))
		sec_display = "kit_hunt"

	elseif chosen_knife then
		blunt_knife(chosen_knife,"foodcan")
		give(sec_opened)
		getLocalActor():eat(getLocalActor():object(sec_opened))
		sec_display = chosen_knife:section()

	elseif getLocalActor():object("cutlery_sharp") then
		get_rid_of(getLocalActor():object("cutlery_sharp"))
		give("cutlery")
		give(sec_opened)
		getLocalActor():eat(getLocalActor():object(sec_opened))
		sec_display = "cutlery_sharp"

	elseif getLocalActor():object("grooming_sharp") then
		get_rid_of(getLocalActor():object("grooming_sharp"))
		give("grooming")
		give(sec_opened)
		getLocalActor():eat(getLocalActor():object(sec_opened))
		sec_display = "grooming_sharp"

	elseif getLocalActor():object("shovel_mili_sharp") then
		get_rid_of(getLocalActor():object("shovel_mili_sharp"))
		give("shovel_mili")
		give(sec_opened)
		getLocalActor():eat(getLocalActor():object(sec_opened))
		sec_display = "shovel_mili_sharp"

	elseif getLocalActor():object("shovel_old_sharp") then
		get_rid_of(getLocalActor():object("shovel_old_sharp"))
		give("shovel_old")
		give(sec_opened)
		getLocalActor():eat(getLocalActor():object(sec_opened))
		sec_display = "shovel_old_sharp"

	elseif getLocalActor():object("outfit_dismantler5") then
		get_rid_of(getLocalActor():object("outfit_dismantler5"))
		give("outfit_dismantler_empty")
		give(sec_opened)
		getLocalActor():eat(getLocalActor():object(sec_opened))
		sec_display = "outfit_dismantler5"

	elseif getLocalActor():object("outfit_dismantler4") then
		get_rid_of(getLocalActor():object("outfit_dismantler4"))
		give("outfit_dismantler5")
		give(sec_opened)
		getLocalActor():eat(getLocalActor():object(sec_opened))
		sec_display = "outfit_dismantler4"

	elseif getLocalActor():object("outfit_dismantler3") then
		get_rid_of(getLocalActor():object("outfit_dismantler3"))
		give("outfit_dismantler4")
		give(sec_opened)
		getLocalActor():eat(getLocalActor():object(sec_opened))
		sec_display = "outfit_dismantler3"

	elseif getLocalActor():object("outfit_dismantler2") then
		get_rid_of(getLocalActor():object("outfit_dismantler2"))
		give("outfit_dismantler3")
		give(sec_opened)
		getLocalActor():eat(getLocalActor():object(sec_opened))
		sec_display = "outfit_dismantler2"

	elseif getLocalActor():object("outfit_dismantler") then
		get_rid_of(getLocalActor():object("outfit_dismantler"))
		give("outfit_dismantler2")
		give(sec_opened)
		getLocalActor():eat(getLocalActor():object(sec_opened))
		sec_display = "outfit_dismantler"

	else
		hud_caption("st_canfood_nosharp")
		give(sec)
	end

	if sec_display then
		itms_manager.show_message(game.translate_string("st_canfood_screen_hint").." "..game.translate_string(system_ini():r_string(sec_display,"inv_name")),25)
	end
end

