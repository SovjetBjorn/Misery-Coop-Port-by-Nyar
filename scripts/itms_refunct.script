function quick_actor_effect(eff)
	if eff == "electro_shock" then
		xr_effects.play_inv_dismantle_electro_shock()
		hit_obj(getLocalActor(), 0.1, hit.shock)
		level.add_cam_effector("camera_effects\\fusker.anm",8666,false)
	end
	if eff == "blast" then
		xr_effects.play_inv_dismantle_blast()
		particles_object("explosions\\explosion_01"):play_at_pos(getLocalActor():position())
		hit_obj(getLocalActor(), 1.2, hit.explosion)
		local outfit = getLocalActor():item_in_slot(7)
		if outfit then hit_obj(outfit, 12, hit.explosion) end
		local helm = getLocalActor():item_in_slot(12)
		if helm then hit_obj(helm, 13, hit.explosion) end
		level.add_cam_effector("camera_effects\\fusker.anm",8666,false)
		level.add_pp_effector("thermal_mine.ppe",8667, true)
		level.set_pp_effector_factor(8667,1)
	end
	if eff == "hammer_inv_on_wpn_fail" then
		xr_effects.play_inv_dismantle_hammer_wpn_fail()
		level.add_cam_effector("camera_effects\\shell_shock.anm",8666,false)
	end
	if eff == "swiss_sharp_on_wpn_fail" then
		xr_effects.play_inv_dismantle_swiss_sharp_wpn_fail()
		level.add_cam_effector("camera_effects\\shell_shock.anm",8666,false)
	end
	if eff == "cutlery_sharp_on_wpn_fail" then
		xr_effects.play_inv_dismantle_cutlery_sharp_wpn_fail()
		level.add_cam_effector("camera_effects\\shell_shock.anm",8666,false)
	end
	if eff == "hammer_inv_on_helm_fail" then
		xr_effects.play_inv_dismantle_hammer_helm_fail()
		level.add_cam_effector("camera_effects\\shell_shock.anm",8666,false)
	end
end

function spawn_in_front_quadrant(sec) -- coop-guarded (author: buggy/unused)
	if not (alife() and getLocalActor()) then return end
 -- buggy in some vertices, unused. todo: find another method
	local base_point = getLocalActor():level_vertex_id()
	local spawn_gvid = getLocalActor():game_vertex_id()
	local ang = math.random(-50,50)
	local dist = math.random(50,200)/100
	local dir = device().cam_dir
	local new_dir = vector_rotate_y(utils.vector_copy_by_val(dir),ang)
	local spawn_lvid = level.vertex_in_direction(base_point, new_dir, dist)
	local spawn_pos = level.vertex_position(spawn_lvid)
	alife():create(sec,spawn_pos,spawn_lvid,spawn_gvid)
end

function hud_caption(string_static)
	get_hud():HideActorMenu()
	itms_manager.show_message(game.translate_string(string_static),25)
end

function cast_error(info,header,showtime)
	if not showtime then showtime = 5000 end
	header = header and "[ITEMS REFUNCT MOD - ERROR] ".." ".." "..header or "[ITEMS REFUNCT MOD - ERROR]"
	if not info then info = "//unknown//" end
	news_manager.send_tip(getLocalActor(),info,nil,nil,showtime,nil,header,"ui_inGame2_PDA_icon_actorbackpack")
end