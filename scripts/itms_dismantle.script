-----------------------------
-- TARGET BASIC OPERATIONS --
-----------------------------
function irm_dismantle:TargetCondition()
	local func = "TargetCondition()"
	local item = self.list_box_trgts:GetSelectedItem()
	local trgt_obj = item and level.object_by_id(item.item_id)
	if not trgt_obj then self:cast("Cannot recognize target object.",func,301.1) return end
	if not trgt_obj:condition() then self:cast("Cannot read target :condition().",func,301.2) end
	return trgt_obj:condition()
end
function irm_dismantle:DecreaseTargetCondition(trgt_condec_amt)
	local func = "DecreaseTargetCondition()"
	if not trgt_condec_amt then self:cast("Missing condition decrease value.",func,302) return end
	trgt_condec_amt = trgt_condec_amt - self.actor_class_cdec_bonus
	local item = self.list_box_trgts:GetSelectedItem()
	local trgt_obj = item and level.object_by_id(item.item_id)
	trgt_obj:set_condition(self:TargetCondition() - trgt_condec_amt)
end
function irm_dismantle:KillTarget(se_trgt)
	mc_cooking.itemop_release(se_trgt and se_trgt:id() or 0)
end


--------------------
-- TOOL BEHAVIOUR --
--------------------
function irm_dismantle:TestToolFail(trgt_genus,trgt_species)
	-- Read tool failure probab from config
	local cfg_sec = "tool_fail_probab_on_"..trgt_genus.."_"..trgt_species
	local line = self:tool_is_in("tools_all_dismantle_kits") and "tfp_kit" or "tfp_"..self.tool
	-- Test on probab
	if test_on(get_float(cfg_sec,line)-self.actor_class_fail_bonus) then
		return true
	else
		return false
	end
end
function irm_dismantle:ToolFailOverride(trgt_genus,trgt_species)
	local func = "ToolFailOverride()"
	if not trgt_genus then
		self:cast("Function called without specyfing target genus.",func,401.1)
	return
	end
	if not trgt_species then
		self:cast("Function called without specyfing target species.",func,401.2)
		return
	end

	-- Decrease targets condition
	if trgt_genus ~= "wpn_addon" then
		self:DecreaseTargetCondition(get_float("tool_fail_con_decrease_on_"..trgt_genus.."_"..trgt_species,"tfcd_"..self.tool))
	else
		trgt_genus = "wpn" --// hack to trigger wpn finishing effectors //--
	end

	-- Tool behaviour: kill tool or drop blunted for swiss_sharp
	if self.tool == "swiss_sharp" then
		self:DropToolZerooneBlunted()
	end

	-- Define effector and finish with it
	local tool_prefix = string.find(self.tool,"shovel") and "shovels" or self.tool
	local effector = tool_prefix.."_on_"..trgt_genus.."_fail"
	self:FinishWith("tool_fail_override",effector)
end
function irm_dismantle:ExecuteToolBehaviour(tool_bhv,force_destination)
	local func = "ExecuteToolBehaviour()"
	if tool_bhv == "keep" then
		give(self.tool)
	elseif tool_bhv == "blunt_on_probab" then
		self:ZerooneBluntOnProbab()
	elseif tool_bhv == "force_blunt" then
		self:ForceZerooneBlunt(force_destination)
	elseif tool_bhv == "decrease" then
		if self:tool_is_in("tools_all_dismantle_kits") then
			self:KeepForcedTool()
		else
			self:cast("Attempted to decrease wrong type of tool. Only dismantling kits can follow 'decrease' tool behaviour pattern.",func,402.1)
		end
	elseif tool_bhv == "drop_blunted" then
		self:DropToolZerooneBlunted()
	elseif tool_bhv == "drop_intact" then
		self:DropToolIntact()
	elseif tool_bhv == "kill" then
		--// tool already killed by player on item use //--
	else
		self:cast("Unknown tool behaviour pattern: '"..tool_bhv.."'.",func,402.2)
	end
end
	function irm_dismantle:ZerooneBluntOnProbab()
		local cfg_sec, func = "tool_zeroone_blunt_probabs", "ZerooneBluntOnProbab()"

		if not self:tool_is_in("tools_all_sharpened") then
			self:cast("Attempted to blunt wrong type of tool. Only '*_sharp' tools can follow 'blunt' tool behaviour pattern.",func,403.1)
			return
		end
		if not configltx:section_exist(cfg_sec) then
			self:cast(clx.."Missing section ["..cfg_sec.."].",func,403.2)
			return
		end
		local lines_amt = configltx:line_count(cfg_sec)
		if lines_amt < 5 then
			self:cast(clx.."Config section ["..cfg_sec.."] incomplete (missing lines for some tools).",func,403.3)
			return
		end
		if not configltx:line_exist(cfg_sec,"tbp_"..self.tool) then
			self:cast(clx.."Missing blunt probab for "..self.tool.." in section ["..cfg_sec.."]",func,403,4)
			return
		end

		local probab = get_float(cfg_sec,"tbp_"..self.tool)
		if not probab then
			self:cast(clx.."Missing blunt probab for '"..self.tool.."'.",func,403.5)
			return
		elseif probab ~= math.floor(probab) then
			self:cast(clx.."Given probab 'tbp_"..self.tool.."' is not an integer.",func,403.61)
			return
		elseif probab < 0 then
			self:cast(clx.."Given probab 'tbp_"..self.tool.."' is < 0.",func,403.62)
			return
		elseif probab > 100 then
			self:cast(clx.."Given probab 'tbp_"..self.tool.."' is > 100.",func,403.63)
			return
		end

		probab = probab - self.actor_class_blnt_bonus

		if test_on(probab) then
			give(self.tool:gsub("_sharp",""))
		else
			give(self.tool)
		end
	end
	function irm_dismantle:ForceZerooneBlunt(destination)
		local func = "ForceZerooneBlunt()"
		destination = destination and destination or "give"
		if destination == "give" then
			self:KeepForcedTool()
		elseif destination == "drop" then
			self:DropToolZerooneBlunted()
		else
			self:cast("Cannot recognize destination type.",func,404)
		end
	end
		function irm_dismantle:DropToolZerooneBlunted()
			local func = "DropToolZerooneBlunted()"
			local drop_section
			if self:tool_is_in("tools_all_makeshift") then
				if self:tool_is_in("tools_group_1") then
					drop_section = self.tool
				else
					drop_section = self.tool:gsub("_sharp","")
				end
			elseif self:tool_is_in("tools_all_dismantle_kits") then
				local t_kit
				if self:tool_is_in("tools_outfit_dismantlers") then
					t_kit = get_kit_table("outfit")
				elseif self:tool_is_in("tools_weapon_dismantlers") then
					t_kit = get_kit_table("weapon")
				end
				for i = 1,#t_kit do
					if self.tool == t_kit[i] then
						drop_section = t_kit[i-1]
					end
				end
			else
				self:cast(plx.."Tool not included in plugin list.",func,405.1)
			end
			if drop_section then
				-- itms_refunct.spawn_in_front_quadrant(drop_section)
				if not string.find(drop_section,"_empty") then
					mc_cooking.itemop_give(drop_section, 1)
				else
					if self.empty_kits_enabled then
						mc_cooking.itemop_give(drop_section, 1)
					end
				end
			else
				self:cast("Missing drop_section.",func,405.2)
			end
		end
		function irm_dismantle:DropToolIntact()
			mc_cooking.itemop_give(self.tool, 1)
		end
		function irm_dismantle:KeepForcedTool()
			local func = "KeepForcedTool()"
			local give_section
			if self:tool_is_in("tools_all_makeshift") then
				if self:tool_is_in("tools_group_1") then
					give_section = self.tool
				else
					give_section = self.tool:gsub("_sharp","")
				end
			elseif self:tool_is_in("tools_all_dismantle_kits") then
				local t_kit
				if self:tool_is_in("tools_outfit_dismantlers") then
					t_kit = get_kit_table("outfit")
				elseif self:tool_is_in("tools_weapon_dismantlers") then
					t_kit = get_kit_table("weapon")
				end
				for i = 1,#t_kit do
					if self.tool == t_kit[i] then
						give_section = t_kit[i-1]
					end
				end
			else
				self:cast(plx.."Tool not included in plugin list.",func,406.1)
			end
			if give_section then
				if not string.find(give_section,"_empty") then
					give(give_section)
				else
					if self.empty_kits_enabled then
						give(give_section)
					end
				end
			else
				self:cast("Missing give_section.",func,406.2)
			end
		end


--------------
-- AUX TOOL --
--------------
function irm_dismantle:IncludeAuxTool()
	local func = "IncludeAuxTool()"
	-- Ensure aux clean slate
	self.aux_obj = nil
	self.aux_demanded = nil
	self.aux_boost = nil
	self.aux_condec = nil
	self.caption_aux_title:SetText("")
	self.caption_aux:SetText("")

	-- Set auxiliary tool demand
	local demand_aux
	if self:trgt_is_in("all_targets_for_aux") then
		if self:trgt_is_in("all_outfits_lists") then
			if not self:tool_is_in("tools_outfit_dismantlers") then
				demand_aux = "knife_first"
			end
		elseif self:trgt_is_in("outfitlike_targets") then
			if self:tool_is_in("tools_group_1") then
				demand_aux = "knife_first"
			elseif self:tool_is_in("tools_group_4") then
				if self.trgt ~= "af_camelbak" then
					demand_aux = "knife_first"
				end
			end
		elseif self:trgt_is_in("helmets_not_tough") then
			if self:tool_is_in("tools_group_1") then
				demand_aux = "knife_first"
			end
		elseif self:trgt_is_in("helmets_tough") then
			if self:tool_is_in("tools_group_1") then
				demand_aux = "knife_only"
			elseif self:tool_is_in("tools_group_2") then
				demand_aux = "axe_only"
			elseif self:tool_is_in("tools_group_4") then
				demand_aux = "axe_only"
			elseif self:tool_is_in("tools_outfit_dismantlers") then
				demand_aux = "axe_only"
			end
		else
			self:cast(plx.."Target from [all_targets_for_aux] not included in any subsequent plugin list.",func,500)
		end
	end

	-- Load config aux data on demand or end
	if demand_aux then
		self.aux_obj, self.aux_demanded, self.aux_boost, self.aux_condec = self:GetAuxTool(demand_aux)
	end

	-- Handle UI Captions
	if self.aux_obj then
		local aux_con = tostring(math.ceil(self.aux_obj:condition()*100)).."%"
		self.caption_left_inner_title:SetText(game.translate_string("st_dismantle_ui_is_aux_left"))
		self.caption_aux_title:SetText(game.translate_string("st_dismantle_ui_is_aux_title"))
		self.caption_aux:SetText(game.translate_string(system_ini():r_string(self.aux_obj:section(),"inv_name")).." ".."("..aux_con..")")
	elseif demand_aux then
		self.caption_trgts:SetText("")
		self.caption_left_inner_title:SetText(game.translate_string("st_dismantle_ui_need_aux_left"))
		self.caption_aux_title:SetText(game.translate_string("st_dismantle_ui_is_aux_title_no"))
		if demand_aux == "knife_only" then
			self.caption_aux:SetText(game.translate_string("st_dismantle_ui_caption_aux_knife"))
		elseif demand_aux == "axe_only" then
			self.caption_aux:SetText(game.translate_string("st_dismantle_ui_caption_aux_axe"))
		else
			self.caption_aux:SetText(game.translate_string("st_dismantle_ui_caption_aux_any"))
		end
	end
end
function irm_dismantle:GetAuxTool(aux_tool_demand)
	local func = "GetAuxTool()"
	if not self:trgt_is_in("all_targets_for_aux") then
		self:cast(plx.."Target not included in plugin targets list.",func,501.1)
		return
	end

	-- Determine target genus/species
	local trgt_genus, trgt_species
	if     self:trgt_is_in("outfit_light") 			then trgt_genus = "outfit" 		trgt_species = "light_"
	elseif self:trgt_is_in("outfit_medium") 		then trgt_genus = "outfit" 		trgt_species = "medium_"
	elseif self:trgt_is_in("outfit_heavy") 			then trgt_genus = "outfit" 		trgt_species = "heavy_"
	elseif self:trgt_is_in("outfit_ssp") 			then trgt_genus = "outfit" 		trgt_species = "ssp_"
	elseif self:trgt_is_in("outfit_seva") 			then trgt_genus = "outfit" 		trgt_species = "seva_"
	elseif self:trgt_is_in("outfit_exo") 			then trgt_genus = "outfit" 		trgt_species = "exo_"
	elseif self:trgt_is_in("outfitlike_targets") 	then trgt_genus = "outfitlike" 	trgt_species = ""
	elseif self:trgt_is_in("helmets_masks") 		then trgt_genus = "helm_mask" 	trgt_species = ""
	elseif self:trgt_is_in("helmets_hardhats") 		then trgt_genus = "helm_hard" 	trgt_species = ""
	elseif self:trgt_is_in("helmets_good") 			then trgt_genus = "helm_good" 	trgt_species = ""
	else
		self:cast(plx.."Cannot recognize target included in [all_targets_for_aux] plugin targets list.",func,501.2)
		return
	end

	-- Read and check aux tool blunt rate
	local knife_atbr = get_float("aux_tool_blunt_rate_on_"..trgt_genus,"atbr_"..trgt_genus.."_"..trgt_species.."knife")
	local axe_atbr   = get_float("aux_tool_blunt_rate_on_"..trgt_genus,"atbr_"..trgt_genus.."_"..trgt_species.."axe")
	if knife_atbr < 0 then
		self:cast(clx.."'atbr_"..trgt_genus.."_"..trgt_species.."knife' in [aux_tool_blunt_rate_on_"..trgt_genus.."] is < 0.",func,501.31)
		return
	elseif knife_atbr > 1 then
		self:cast(clx.."'atbr_"..trgt_genus.."_"..trgt_species.."knife' in [aux_tool_blunt_rate_on_"..trgt_genus.."] is > 1.",func,501.32)
		return
	end
	if axe_atbr < 0 then
		self:cast(clx.."'atbr_"..trgt_genus.."_"..trgt_species.."axe' in [aux_tool_blunt_rate_on_"..trgt_genus.."] is < 0.",func,501.41)
		return
	elseif axe_atbr > 1 then
		self:cast(clx.."'atbr_"..trgt_genus.."_"..trgt_species.."axe' in [aux_tool_blunt_rate_on_"..trgt_genus.."] is > 1.",func,501.42)
		return
	end

	-- Select applicable aux objects
	local aux_obj_knife = ChooseAuxKnife(knife_atbr)
	local aux_obj_axe = ChooseAuxAxe(axe_atbr)

	-- Read and check dismantle probab boost from aux tool
	-- -- Knives
	local dp_add_knife
	if aux_obj_knife then
		-- Read
		dp_add_knife = get_float(trgt_genus.."_aux_tool_dp_boost","dp_aux_add_"..aux_obj_knife:section())
		-- Check
		if dp_add_knife ~= math.floor(dp_add_knife) then
			self:cast(clx.."Given 'dp_aux_add_"..aux_obj_knife:section().."' probab boost is not an integer.",func,501.51)
			return
		elseif dp_add_knife < 0 then
			self:cast(clx.."Given 'dp_aux_add_"..aux_obj_knife:section().."' in ["..trgt_genus.."_aux_tool_dp_boost'] is < 0.",func,501.52)
			return
		elseif dp_add_knife > 100 then
			self:cast(clx.."Given 'dp_aux_add_"..aux_obj_knife:section().."' in ["..trgt_genus.."_aux_tool_dp_boost'] is > 100.",func,501.53)
			return
		end
	end
	-- -- Axes
	local dp_add_axe
	if aux_obj_axe then
		-- Read
		dp_add_axe = get_float(trgt_genus.."_aux_tool_dp_boost","dp_aux_add_"..aux_obj_axe:section())
		-- Check
		if dp_add_axe ~= math.floor(dp_add_axe) then
			self:cast(clx.."Given 'dp_aux_add_"..aux_obj_axe:section().."' probab boost is not an integer.",func,501.61)
			return
		elseif dp_add_axe < 0 then
			self:cast(clx.."Given 'dp_aux_add_"..aux_obj_axe:section().."' in ["..trgt_genus.."_aux_tool_dp_boost'] is < 0.",func,501.62)
			return
		elseif dp_add_axe > 100 then
			self:cast(clx.."Given 'dp_aux_add_"..aux_obj_axe:section().."' in ["..trgt_genus.."_aux_tool_dp_boost'] is > 100.",func,501.63)
			return
		end
	end

	-- Return gathered values based on demand
	if aux_tool_demand == "knife_first" then
		if aux_obj_knife then
			return aux_obj_knife, "demanded_any", dp_add_knife, knife_atbr
		elseif aux_obj_axe then
			return aux_obj_axe, "demanded_any", dp_add_axe, axe_atbr
		else
			return nil, "demanded_any"
		end
	elseif aux_tool_demand == "axe_first" then
		if aux_obj_axe then
			return aux_obj_axe, "demanded_any", dp_add_axe, axe_atbr
		elseif aux_obj_knife then
			return aux_obj_knife, "demanded_any", dp_add_knife, knife_atbr
		else
			return nil, "demanded_any"
		end
	elseif aux_tool_demand == "knife_only" then
		if aux_obj_knife then
			return aux_obj_knife, "demanded_knife", dp_add_knife, knife_atbr
		else
			return nil, "demanded_knife"
		end
	elseif aux_tool_demand == "axe_only" then
		if aux_obj_axe then
			return aux_obj_axe, "demanded_axe", dp_add_axe, axe_atbr
		else
			return nil, "demanded_axe"
		end
	else
		self:cast("Unknown aux tool demand pattern.",func,501.7)
	end
end
function BluntAuxTool(aux_obj,aux_blunt_percent)
	local func = "BluntAuxTool()"
	if string.find(aux_obj:section(),"knife") then
		itms_refunct.blunt_knife(aux_obj,"dismantle",aux_blunt_percent)
	elseif string.find(aux_obj:section(),"axe") then
		itms_refunct.blunt_axe(aux_obj,"dismantle",aux_blunt_percent)
	else
		self:cast("Unknown aux_obj predefined type.",func,502)
	end
end
function ChooseAuxKnife(lowest_con)
	-- Choose the most used of the most expensive knife available
	local compare_con, knives_by_cost, chosen_knife = 1.1, GetSortedKnives()

	-- (LOCAL UTIL)
	local function choose_leastcon_of(knife_section,lowest_con)
		local chosen
		for i = 0, getLocalActor():object_count() - 1 do
			if getLocalActor():object(i):section() == knife_section then
				local next_con = getLocalActor():object(i):condition()
				if (next_con >= lowest_con) and (next_con < compare_con) then
					compare_con = next_con
					chosen = getLocalActor():object(i)
				end
			end
		end
		return chosen
	end

	for i = 1,#knives_by_cost do
		if getLocalActor():object(knives_by_cost[i]) then
			chosen_knife = choose_leastcon_of(knives_by_cost[i],lowest_con)
			if chosen_knife then break end
		end
	end

	return chosen_knife
end
function ChooseAuxAxe(lowest_con)
	-- Choose the most used axe available
	local compare_con, chosen_axe = 1.1

	for i = 0, getLocalActor():object_count() - 1 do
		if getLocalActor():object(i):section() == "wpn_axe" then
			local next_con = getLocalActor():object(i):condition()
			if (next_con >= lowest_con) and (next_con < compare_con) then
				compare_con = next_con
				chosen_axe = getLocalActor():object(i)
			end
		end
	end

	return chosen_axe
end
function GetSortedKnives()
	local t_in = {
		{item = "wpn_knife_inv", 	cost = system_ini():r_string("wpn_knife_inv","cost")},
		{item = "wpn_knife_inv_2", 	cost = system_ini():r_string("wpn_knife_inv_2","cost")},
		{item = "wpn_knife_inv_3", 	cost = system_ini():r_string("wpn_knife_inv_3","cost")},
		{item = "wpn_knife_inv_4", 	cost = system_ini():r_string("wpn_knife_inv_4","cost")},
		{item = "wpn_knife_inv_5", 	cost = system_ini():r_string("wpn_knife_inv_5","cost")},
		{item = "wpn_knife_m", 		cost = system_ini():r_string("wpn_knife_m","cost")}}
	table.sort(t_in,function(a,b) return a.cost > b.cost end)
	local t_out = {}
	for i = 1, #t_in do
		t_out[i] = t_in[i].item
	end
	return t_out
end


------------------------------
-- CONTENT EXECUTION ENGINE --
------------------------------
function irm_dismantle:GetFromConfig(probabs_section,tool_bhv_section,probabs_prefix,tool_bhv_prefix,probabs_main_line,suffix)
	local func = "GetFromConfig()"
	-- Check main and optional input, define line operators
	if not probabs_section then self:cast("Missing probabs section.",func,601) return end
	if not tool_bhv_section then self:cast("Missing tool behaviour section.",func,602) return end
	probabs_prefix = probabs_prefix or "dp_"
	tool_bhv_prefix = tool_bhv_prefix or "tb_"
	probabs_main_line = probabs_main_line or "dp_main"
	suffix = suffix or self:tool_is_in("tools_all_dismantle_kits") and "kit" or self.tool

	-- TOOL BEHAVIOUR
	local tool_bhv

	-- Option for getting only probabs from config
	if tool_bhv_section ~= "skip" then
		-- Read tool behaviour value from config
		tool_bhv = get_string(tool_bhv_section,tool_bhv_prefix..suffix)
		-- Check tool behaviour value from config  - compare input with allowed values
		local allowed_tbhv = {
			keep 			= true,
			blunt_on_probab = true,
			force_blunt 	= true,
			decrease 		= true,
			drop 			= true,
			kill 			= true}
		if not allowed_tbhv[tool_bhv] then
			self:cast(clx.."Unknown tool behaviour pattern: ["..tool_bhv_section.."] "..tool_bhv_prefix..suffix.." == "..tool_bhv..".",func,603)
			return
		end
	end

	-- Option for getting only tool behaviour from config
	if probabs_section == "skip" then
		return tool_bhv
	end

	-- DISMANTLE PROBABILITY
	local probab

	-- Read and check main probab value from config
	local m_probab = get_float(probabs_section,probabs_main_line)
	if m_probab ~= math.floor(m_probab) then
		self:cast(clx.."Given '"..probabs_main_line.."' probab is not an integer.",func,604)
		return
	elseif m_probab < 0 then
		cast_console("[DISMANTLE DEBUG] GetFromConfig() : '"..probabs_main_line.."' probab < 0. Assuming 0.")
	elseif m_probab > 100 then
		cast_console("[DISMANTLE DEBUG] GetFromConfig() : '"..probabs_main_line.."' probab > 100. Assuming 100.")
	end

	-- Read and check tool adjustment probab value from config
	local t_probab = get_float(probabs_section,probabs_prefix..suffix)
	if t_probab ~= math.floor(t_probab) then
		self:cast(clx.."Given '"..probabs_prefix..suffix.."' probab is not an integer.",func,605)
		return
	elseif t_probab < 0 then
		cast_console("[DISMANTLE DEBUG] GetFromConfig() : '"..probabs_prefix..suffix.."' probab < 0. Assuming 0.")
	elseif t_probab > 100 then
		cast_console("[DISMANTLE DEBUG] GetFromConfig() : '"..probabs_prefix..suffix.."' probab > 100. Assuming 100.")
	end

	-- Construct final probab
	probab = m_probab + t_probab + self.actor_class_main_bonus

	if probab < 0 then
		cast_console("[DISMANTLE DEBUG] GetFromConfig() : final dismantle probab < 0. Assumed 0.")
	elseif probab > 100 then
		cast_console("[DISMANTLE DEBUG] GetFromConfig() : final dismantle probab > 100. Assumed 100.")
	end

	return probab, tool_bhv
end
function irm_dismantle:ExecuteContentFromConfig(probab,config_section_prefix)
	local func = "ExecuteContentFromConfig()"
	-- Check input and set config section name
	if not probab then self:cast("Missing probab.",func,710) return end
	if not config_section_prefix then self:cast("Missing config section prefix.",func,711) return end
	local cfg_sec
	if string.find(config_section_prefix,"_for_all") then
		cfg_sec = config_section_prefix.."_content"
	else
		cfg_sec = config_section_prefix.."_content_"..self.trgt
	end
	-- Config section presence and lenght check
	if not configltx:section_exist(cfg_sec) then
		self:cast(clx.."Missing section ["..cfg_sec.."]",func,712)
		return
	end
	local lines_amt = configltx:line_count(cfg_sec)
	if lines_amt == 0 then self:cast(clx.."Config section ["..cfg_sec.."] is empty.",func,714) return end
	if lines_amt < 2 then self:cast(clx.."Config section ["..cfg_sec.."] incomplete.",func,715) return end

	-- (LOCAL UTIL) Config line presence checking tool
	local function is_line(config_line,config_section)
		if not config_section then config_section = cfg_sec end
		return configltx:line_exist(config_section,config_line)
	end

	-- (LOCAL UTIL) Final execution tool
	local function CheckAndExecute(probab,succ_line,fail_line,test_amt_line,succ_amt_line,fail_amt_line,debug_i)
		local funx = "CheckAndExecute()"
		local succ, fail, test_amt, succ_amt, fail_amt
		debug_i = tostring(debug_i) or ""
		-- Check config values
		if probab ~= math.floor(probab) then
			self:cast("Given probab is not an integer.",funx,720)
			return
		elseif probab < 0 then
			cast_console("[DISMANTLE DEBUG] CheckAndExecute()arg1 : probab < 0. Assuming 0.")
		elseif probab > 100 then
			cast_console("[DISMANTLE DEBUG] CheckAndExecute()arg1 : probab > 100. Assuming 100.")
		end
		if get_string(cfg_sec,succ_line) == "" then
			self:cast(clx.."Given 'succ"..debug_i.."' setting in section ["..cfg_sec.."] is empty.",funx,721)
			return
		else
			succ = get_string(cfg_sec,succ_line)
		end
		if get_string(cfg_sec,fail_line) == "" then
			self:cast(clx.."Given 'fail"..debug_i.."' setting in section ["..cfg_sec.."] is empty.",funx,722)
			return
		else
			fail = get_string(cfg_sec,fail_line)
		end
		if not test_amt_line then
			self:cast("Missing 'test_amt_line' value.",funx,723.1)
			return
		elseif test_amt_line == "default" then
			test_amt = 1
		elseif get_float(cfg_sec,test_amt_line) ~= math.floor(get_float(cfg_sec,test_amt_line)) then
			self:cast(clx.."Given 'test"..debug_i.."_amt' is not an integer.",funx,723.2)
			return
		elseif get_float(cfg_sec,test_amt_line) < 0 then
			self:cast(clx.."Given 'test"..debug_i.."_amt' is negative.",funx,723.3)
			return
		else
			test_amt = get_float(cfg_sec,test_amt_line)
		end
		if not succ_amt_line then
			self:cast("Missing 'succ_amt_line' value.",funx,724.1)
			return
		elseif succ_amt_line == "default" then
			succ_amt = 1
		elseif get_float(cfg_sec,succ_amt_line) ~= math.floor(get_float(cfg_sec,succ_amt_line)) then
			self:cast(clx.."Given 'succ"..debug_i.."_amt' is not an integer.",funx,724.2)
			return
		elseif get_float(cfg_sec,succ_amt_line) < 0 then
			self:cast(clx.."Given 'succ"..debug_i.."_amt' is negative.",funx,724.3)
			return
		else
			succ_amt = get_float(cfg_sec,succ_amt_line)
		end
		if not fail_amt_line then
			self:cast("Missing 'fail_amt_line' value.",funx,725.1)
			return
		elseif fail_amt_line == "default" then
			fail_amt = 1
		elseif get_float(cfg_sec,fail_amt_line) ~= math.floor(get_float(cfg_sec,fail_amt_line)) then
			self:cast(clx.."Given 'fail"..debug_i.."_amt' is not an integer.",funx,725.2)
			return
		elseif get_float(cfg_sec,fail_amt_line) < 0 then
			self:cast(clx.."Given 'fail"..debug_i.."_amt' is negative.",funx,725.3)
			return
		else
			fail_amt = get_float(cfg_sec,fail_amt_line)
		end

		-- Get the shit done (and cast debug)
		for i=1,test_amt do
			if test_on(probab) then
				if succ ~= "skip" then
					give(succ,succ_amt)
				end
				cast_op_test(probab,test_amt_line,test_amt,succ_line,succ_amt_line,succ_amt,succ,fail_line,fail_amt_line,fail_amt,fail,"s",i)
			else
				if fail ~= "skip" and fail ~= "event" then
					give(fail,fail_amt)
				end
				cast_op_test(probab,test_amt_line,test_amt,succ_line,succ_amt_line,succ_amt,succ,fail_line,fail_amt_line,fail_amt,fail,"f",i)
			end
		end
	end

	-- Define feed for final execution
	local succ_line, succ_amt_line, fail_line, fail_amt_line, test_amt_line

	-- Config integrity check
	for k,v in pairs(alun_utils.collect_section(configltx,cfg_sec)) do
		if is_line("succ",cfg_sec) then
			if string.find(v,"succ") then
				if string.find(v,"succ%w") then
					self:cast(clx.."Invalid structure in section ["..cfg_sec.."]. Both 'succ' and 'succ*' lines detected.",func,731)
					return
				end
			end
		end
		if is_line("fail",cfg_sec) then
			if string.find(v,"fail") then
				if string.find(v,"fail%w") then
					self:cast(clx.."Invalid structure in section ["..cfg_sec.."]. Both 'fail' and 'fail*' lines detected.",func,732)
					return
				end
			end
		end
	end

	-- Prepare tested pairs execution
	if is_line("succ") then
		--// Single Pair Mode //--
		succ_line = "succ"
		-- Config integrity check
		if is_line("fail") then
			fail_line = "fail"
		else
			self:cast(clx.."Missing 'fail' line to match 'succ' line in section ["..cfg_sec.."].",func,740)
			return
		end
		-- Read optional settings
		succ_amt_line = is_line("succ_amt") and "succ_amt" or "default"
		fail_amt_line = is_line("fail_amt") and "fail_amt" or "default"
		test_amt_line = is_line("test_amt") and "test_amt" or "default"
		-- Execute
		CheckAndExecute(probab,succ_line,fail_line,test_amt_line,succ_amt_line,fail_amt_line)
	else
		--// Multiple Pairs Mode //--
		-- Structure check
		if not is_line("succ1") then
			if not is_line("succ2") then
				self:cast(clx.."Invalid 'succ*' structure in section ["..cfg_sec.."].",func,751)
				return
			end
		end
		local i = 1
		repeat
			succ_line = is_line("succ"..i) and "succ"..i
			-- Read optional fail line
			fail_line = is_line("fail"..i) and "fail"..i or is_line("fail") and "fail" or "error"
			if fail_line == "error" then
				self:cast(clx.."Invalid 'fail*' structure in section ["..cfg_sec.."].",func,752)
				return
			end
			-- Config line pairs integrity check
			if fail_line ~= "fail" and fail_line ~= "error" then
				if not is_line("succ"..i) then
					self:cast(clx.."Missing 'succ"..i.."' to match 'fail"..i.."' in section ["..cfg_sec.."].",func,753)
					return
				end
			end
			-- Read optional amount settings
			succ_amt_line = is_line("succ"..i.."_amt") and "succ"..i.."_amt" or is_line("succ_amt") and "succ_amt" or "default"
			fail_amt_line = is_line("fail"..i.."_amt") and "fail"..i.."_amt" or is_line("fail_amt") and "fail_amt" or "default"
			test_amt_line = is_line("test"..i.."_amt") and "test"..i.."_amt" or is_line("test_amt") and "test_amt" or "default"
			-- Execute this pair
			if fail_line ~= "error" then
				CheckAndExecute(probab,succ_line,fail_line,test_amt_line,succ_amt_line,fail_amt_line,i)
			end
			i = i + 1
		until is_line("succ"..i) ~= true
	end

	-- Handle Optional Always Given Content
	if is_line("always_give") then
		--// Single Mode //--
		-- Read from config
		local always_give = get_string(cfg_sec,"always_give")
		local always_give_amt = is_line("always_give_amt") and get_float(cfg_sec,"always_give_amt")
		-- Check
		if always_give_amt then
			if always_give_amt == "" then
				self:cast(clx.."Given 'always_give_amt' in section ["..cfg_sec.."] is empty.",func,760)
				return
			elseif always_give_amt ~= math.floor(always_give_amt) then
				self:cast(clx.."Given 'always_give_amt' in section ["..cfg_sec.."] is not an integer.",func,761)
				return
			elseif always_give_amt < 0 then
				self:cast(clx.."Given 'always_give_amt' in section ["..cfg_sec.."] is negative.",func,762)
				return
			end
		end
		-- Execute
		give(always_give,always_give_amt)
		-- Cast debug info
		cast_op_ag_single(always_give,always_give_amt)
	else
		--// Multiple Mode //--
		if is_line("always_give_multiple") then
			if get_bool(cfg_sec,"always_give_multiple") then
				-- Config structure check
				if not is_line("always_give1") then
					if not is_line("always_give2") then
						self:cast(clx.."Invalid multiple 'always_give*' structure in section ["..cfg_sec.."].",func,770)
						return
					end
				end
				-- Read from config and execute
				local i = 1
				repeat
					-- Structure check
					if is_line("always_give"..i.."_amt") then
						if not is_line("always_give"..i) then
							self:cast(clx.."Invalid multiple 'always_give*' structure in section ["..cfg_sec.."].",func,771)
							return
						end
					end
					-- Read
					local ag_amt = is_line("always_give"..i.."_amt") and get_float(cfg_sec,"always_give"..i.."_amt") or is_line("always_give_amt") and get_float(cfg_sec,"always_give_amt")
					local ag_content = get_string(cfg_sec,"always_give"..i)
					-- Execute
					give(ag_content,ag_amt)
					-- Cast debug info
					cast_op_ag_multiple(ag_content,ag_amt)
					i = i + 1
				until is_line("always_give"..i) ~= true
			else
				self:cast(clx.."Invalid 'always_give_multiple' value in section ["..cfg_sec.."].",func,772)
			end
		end
	end
end
function irm_dismantle:ExecuteBatteryTiersContentFromConfigs(config_section_prefix)
	local func = "ExecuteBatteryTiersContentFromConfigs()"
	-- Check input and set config section name
	if not config_section_prefix then self:cast("Missing config_section_prefix.",func,801) return end
	local cfg_sec = config_section_prefix.."_content_"..self.trgt

	-- Config section presence check
	if not configltx:section_exist(cfg_sec) then
		self:cast(clx.."Missing section ["..cfg_sec.."]",func,802)
		return
	end

	-- (LOCAL UTIL) Config line presence checking tool
	local function is_line(config_line,config_section)
		if not config_section then config_section = cfg_sec end
		return configltx:line_exist(config_section,config_line)
	end

	-- Config line presence check
	if not is_line("load_tiers_from_axr_battery") then
		self:cast(clx.."Missing 'load_tiers_from_axr_battery' line in ["..cfg_sec.."].",func,803)
		return
	end

	-- Auto loading from axr_battery.ltx enable check
	if not get_bool(cfg_sec,"load_tiers_from_axr_battery") then
		cast_console("[DISMANTLE DEBUG] "..func.." : Loading from axr_battery disabled in ["..cfg_sec.."].")
		return
	end

	-- Load condition values for batteries from axr_battery.ltx
	local bt = {
		[1] = {
			["treshold"] = 1,
			["succ"] = "batteries_ccell"
			},
		[2] = {
			["treshold"] = ini_file("plugins\\axr_battery.ltx"):r_float("batteries_ccell","power"),
			["succ"] = "batteries"
			},
		[3] = {
			["treshold"] = ini_file("plugins\\axr_battery.ltx"):r_float("batteries","power"),
			["succ"] = "batteries_dead"
			},
		[4] = {
			["treshold"] = ini_file("plugins\\axr_battery.ltx"):r_float("batteries_dead","power"),
			["succ"] = "batteries_ccell_empty"
			}
		}

	-- Execute
	for i = 4,1,-1 do
		if self:TargetCondition() <= bt[i].treshold then
			give(bt[i].succ)
			break
		end
	end
end


----------------------------------------------
-- FINISH : EVENTS, HUD CAPTIONS, EFFECTORS --
----------------------------------------------
function irm_dismantle:FinishWith(finish_type,finish_content)
	local func = "FinishWith()"
	if self:IsShown() then self:HideDialog() end
	get_hud():HideActorMenu()

	-- UI finishers
	if finish_type == "UI_cancel_override" then
		if finish_content == "override_no_trgt" then
			hud_caption("st_dismantle_screen_no_trgts")
		elseif finish_content == "override_no_aux" then
			hud_caption("st_dismantle_screen_no_aux_"..self.aux_demanded)
		end
		self:OnButtonCancel()


	-- surprise finishers
	elseif finish_type == "target_surprise" then
		if finish_content == "gauss" then
			itms_refunct.quick_actor_effect("electro_shock")
		elseif finish_content == "xplo" then
			itms_refunct.quick_actor_effect("blast")
		end


	-- tool fail finishers
	elseif finish_type == "tool_fail_override" then
		if finish_content == "swiss_sharp_on_wpn_fail" then
			itms_refunct.quick_actor_effect("swiss_sharp_on_wpn_fail")
			hud_caption("st_dismantle_screen_swiss_wpn_fail")
		elseif finish_content == "cutlery_sharp_on_wpn_fail" then
			itms_refunct.quick_actor_effect("cutlery_sharp_on_wpn_fail")
			hud_caption("st_dismantle_screen_cutlery_wpn_fail")
		elseif finish_content == "hammer_inv_on_wpn_fail" then
			itms_refunct.quick_actor_effect("hammer_inv_on_wpn_fail")
			hud_caption("st_dismantle_screen_fail_hammer")
		elseif finish_content == "hammer_inv_on_helm_fail" then
			itms_refunct.quick_actor_effect("hammer_inv_on_helm_fail")
			hud_caption("st_dismantle_screen_fail_hammer")
		elseif finish_content == "shovels_on_wpn_fail" then
			itms_refunct.quick_actor_effect("hammer_inv_on_wpn_fail")
			hud_caption("st_dismantle_screen_fail_shovel")
		elseif finish_content == "shovels_on_helm_fail" then
			itms_refunct.quick_actor_effect("hammer_inv_on_helm_fail")
			hud_caption("st_dismantle_screen_fail_shovel")
		elseif finish_content == "crowbar_on_helm_fail" then
			itms_refunct.quick_actor_effect("swiss_sharp_on_wpn_fail")
			hud_caption("st_dismantle_screen_fail_crowbar")
		end


	-- weapon genus specific finishers
	elseif finish_type == "weapon" then
		if finish_content == "hit" then
			actor_effects.use_item("dismantle_short_hit")

		elseif finish_content == "cutlery" then
			if test_on(50) then
				actor_effects.use_item("dismantle_cutlery1")
			else
				actor_effects.use_item("dismantle_cutlery1")
			end

		elseif finish_content == "metalplastic" then
			actor_effects.use_item("dismantle_metalplastic25")

		elseif finish_content == "kit" then
			if test_on(50) then
				actor_effects.use_item("dismantle_wpn_kit1")
			else
				actor_effects.use_item("dismantle_wpn_kit2")
			end
		end


	-- outfit genus specific finishers
	elseif finish_type == "outfit" then
		if finish_content == "hit" then
			actor_effects.use_item("dismantle_outfit_hit")

		elseif finish_content == "kit" then
			if test_on(50) then
				actor_effects.use_item("dismantle_outfit_kit1")
			else
				actor_effects.use_item("dismantle_outfit_kit2")
			end
		end


	-- family B specific finishers
	elseif finish_type == "standard" then
		if finish_content == "short_hit" then
			actor_effects.use_item("dismantle_short_hit")

		elseif finish_content == "metalplastic" then
			actor_effects.use_item("dismantle_metalplastic25")

		elseif finish_content == "cutlery" then
			if test_on(50) then
				actor_effects.use_item("dismantle_cutlery1")
			else
				actor_effects.use_item("dismantle_cutlery1")
			end

		elseif finish_content == "hammertime" then
			if test_on(50) then
				actor_effects.use_item("dismantle_hammertime1")
			else
				actor_effects.use_item("dismantle_hammertime2")
			end

		elseif finish_content == "grooming" then -- not used atm
			if test_on(50) then
				actor_effects.use_item("dismantle_grooming1")
			else
				actor_effects.use_item("dismantle_grooming2")
			end

		elseif finish_content == "outfitlike" then
			actor_effects.use_item("dismantle_grooming2")
		end

	end

	self:ClearMemory()
end


-----------
-- UTILS --
-----------
function give(section,amount)
	if not section then irm_dismantle:cast("Missing spawn section.","give()",920) return end
	amount = amount or 1
	if not alife() then if mc_cooking then mc_cooking.itemop_give(section, amount) end return end
	for i = 1, amount do
		alife():create(section,getLocalActor():position(),0,0,0)
	end
end
function give_const(cfg_sec)
	local func = "give_const()"
	-- Initial check
	if not configltx:section_exist(cfg_sec) then
		irm_dismantle:cast(ltx.."Missing ["..cfg_sec.."] section.",func,931)
		return
	end

	if not configltx:line_exist(cfg_sec,"give_const") then
		-- Cast debug info
		cast_console_for_const(clx.." Missing 'give_const' in ["..cfg_sec.."] - skipping.")
	else
		local const_content = get_string(cfg_sec,"give_const")
		-- Config integrity check
		if const_content == "" then
			irm_dismantle:cast(clx.."Given 'give_const' in section ["..cfg_sec.."] is empty.",func,932)
			return
		end
		local const_amt
		if not configltx:line_exist(cfg_sec,"give_const_amt") then
			const_amt = 1
			-- Cast debug info
			cast_console_for_const(clx.." Missing 'give_const_amt' in ["..cfg_sec.."] - assuming 1.")
		else
			const_amt = get_float(cfg_sec,"give_const_amt")
			-- Config integrity check
			if const_amt == "" then
				irm_dismantle:cast(clx.."Given 'give_const_amt' in section ["..cfg_sec.."] is empty.",func,933.1)
				return
			elseif const_amt ~= math.floor(const_amt) then
				irm_dismantle:cast(clx.."Given 'give_const_amt' in section ["..cfg_sec.."] is not an integer.",func,933.2)
				return
			elseif const_amt < 0 then
				irm_dismantle:cast(clx.."Given 'give_const_amt' in section ["..cfg_sec.."] is negative.",func,933.3)
				return
			end
		end
		-- Execute
		give(const_content,const_amt)
		-- Cast debug info
		cast_op_gconst(const_content,const_amt)
	end
end
function test_on(probab)
	if not probab then irm_dismantle:cast("Missing probab.","test_on()",940) return end
	return probab > math.random(0,100)
end
function hud_caption(xml_id)
	if not xml_id then irm_dismantle:cast("Missing static id.","hud_caption()",950) return end
	get_hud():HideActorMenu()
	itms_manager.show_message(game.translate_string(xml_id),25)
end
function get_float(section,line)
	if not section or not line then irm_dismantle:cast("Missing section and/or line argument.","get_float()",960) return end
	return configltx:r_float(section,line)
end
function get_string(section,line)
	if not section or not line then irm_dismantle:cast("Missing section and/or line argument.","get_string()",970) return end
	return configltx:r_string(section,line)
end
function get_bool(section,line)
	local func = "get_bool()"
	if not section or not line then irm_dismantle:cast("Missing section and/or line argument.",func,981) return end
	local _r = get_string(section,line)
	if _r ~= "true" and _r ~= "false" then
		irm_dismantle:cast("Given value is not boolean. Section ["..section.."], line '"..line.."'.",func,982)
	else
		return configltx:r_bool(section,line)
	end
end
function get_plugin(section)
	return alun_utils.collect_section(plugin,section,true)
end
function irm_dismantle:tool_is_in(section)
	return get_plugin(section)[self.tool]
end
function irm_dismantle:trgt_is_in(section)
	return get_plugin(section)[self.trgt]
end
function get_kit_table(kit_type)
	local t_kit = {}
	if kit_type == "outfit" then
		t_kit = {
			[0] = "outfit_dismantler_empty",
			[1] = "outfit_dismantler5",
			[2] = "outfit_dismantler4",
			[3] = "outfit_dismantler3",
			[4] = "outfit_dismantler2",
			[5] = "outfit_dismantler"}
	elseif kit_type == "weapon" then
		t_kit = {
			[0] = "wpn_dismantler_empty",
			[1] = "wpn_dismantler5",
			[2] = "wpn_dismantler4",
			[3] = "wpn_dismantler3",
			[4] = "wpn_dismantler2",
			[5] = "wpn_dismantler"}
	end
	return t_kit
end
function irm_dismantle:ClearMemory()
	self.tool = nil
	self.trgt = nil
	self.aux_obj = nil
	self.aux_demanded = nil
	self.aux_boost = nil
	self.aux_condec = nil
	self.actor_class_main_bonus = nil
	self.actor_class_fail_bonus = nil
	self.actor_class_cdec_bonus = nil
	self.actor_class_blnt_bonus = nil
	self.xml = nil
	self.form = nil
	self.list_box_trgts = nil
	self.file_item_main_sz = nil
	self.file_item_fd_sz = nil
	self.file_item_fn_sz = nil
	self.uiic = nil
	self.icon_trgt = nil
	self.caption_tool = nil
	self.caption_trgts_title = nil
	self.caption_trgts = nil
	self.caption_left_inner_title = nil
	self.caption_warning = nil
	self.caption_aux_title = nil
	self.caption_aux = nil
	self.slots_warning = nil
	self.tabs = nil
	self.helptabs = nil
	self.help_bg = nil
	self.slot2_id = nil
	self.slot3_id = nil
	self.slot7_id = nil
	self.slot9_id = nil
	self.slot12_id = nil
	self.empty_kits_enabled = nil
end


-----------
-- DEBUG --
-----------
local log_number = 1
function irm_dismantle:cast(info,header,error_number,showtime,is_known)
	if not is_debug then return end
	if not configltx:r_bool("dismantle_debug","dbg_enable_cast_errors") then return end
	local icon = "ui_inGame2_PDA_icon_actorbackpack"
	local title = "("..log_number..") ".."[DISMANTLE DEBUG - ERROR NUMBER]     "
	info = info or "(?)"
	header = header or "(?)"
	error_number = error_number or 404
	showtime = showtime or 8000

	if is_known then
		if not get_bool("dismantle_debug","dbg_enable_known_errors_casting") then return end
		info = "[KNOWN]:   "..info
		error_number = error_number and "K_"..error_number or "K_404"
		showtime = 3000
		icon = "ui_inGame2_PDA_icon_secret_found"
	end

	news_manager.send_tip(getLocalActor(),info,nil,nil,showtime,nil,title..error_number.."    [IN FUNCTION] "..header,icon)

	if configltx:r_bool("dismantle_debug","dbg_enable_cast_err_to_console") then
		local tool = self.tool and "["..self.tool.."]" or " (?) "
		local trgt = self.trgt and "["..self.trgt.."]" or " (?) "
		local aux = self.aux_demanded and "  with aux demand: '"..self.aux_demanded.."'." or "."
		cast_console("[DISMANTLE DEBUG] Error number:  "..error_number.."   Used:  "..tool.."  on  "..trgt..aux)
	end

	log_number = log_number + 1
end
function cast_op_test(probab,test_amt_line,test_amt,succ_line,succ_amt_line,succ_amt,succ,fail_line,fail_amt_line,fail_amt,fail,result,i,showtime)
	if not is_debug then return end
	if not get_bool("dismantle_debug","dbg_enable_operations_casting") then return end
	showtime = showtime or 16000
	local icon, info
	local s = "[S_AMT_L]   "..succ_amt_line.."     [S_AMT]   "..succ_amt.."     [S]   "..succ.."     [S_LINE]   "..succ_line
	local f = "[F_AMT_L]   "..fail_amt_line.."     [F_AMT]   "..fail_amt.."     [F]   "..fail.."     [F_LINE]   "..fail_line
	if result == "s" then
		icon = "dh_dbg_operation_icon_green_card"
		info = s
	elseif result == "f" then
		icon = "dh_dbg_operation_icon_red_card"
		info = f
	end
	local header = "("..log_number..")".."[TEST ON PROBAB]      "..probab.."       [TEST AMOUNT LINE]    "..test_amt_line.."       [TEST AMOUNT]    "..test_amt.."       [TEST ITERATION]    "..i
	news_manager.send_tip(getLocalActor(),info,nil,nil,showtime,nil,header,icon)
	log_number = log_number + 1
end
function cast_op_ag_single(ag_content,ag_amt,showtime)
	if not is_debug then return end
	if not get_bool("dismantle_debug","dbg_enable_operations_casting") then return end
	local header = "("..log_number..")".."[ALWAYS GIVE -- SINGLE MODE]"
	showtime = showtime or 5000
	ag_content = ag_content or "(?)"
	ag_amt = ag_amt or "default"
	local info = "ALWAYS GIVE ==      "..ag_content.."     ALWAYS GIVE AMOUNT ==      "..ag_amt
	news_manager.send_tip(getLocalActor(),info,nil,nil,showtime,nil,header,"dh_dbg_operation_icon_yellow_card")
	log_number = log_number + 1
end
function cast_op_ag_multiple(ag_content,ag_amt,showtime)
	if not is_debug then return end
	if not get_bool("dismantle_debug","dbg_enable_operations_casting") then return end
	local header = "("..log_number..")".."[ALWAYS GIVE -- MULTIPLE MODE]"
	showtime = showtime or 5000
	ag_content = ag_content or "(?)"
	ag_amt = ag_amt or "default"
	local info = "ALWAYS GIVE ==      "..ag_content.."     ALWAYS GIVE AMOUNT ==      "..ag_amt
	news_manager.send_tip(getLocalActor(),info,nil,nil,showtime,nil,header,"dh_dbg_operation_icon_yellow_card")
	log_number = log_number + 1
end
function cast_op_gconst(const_content,const_amt,showtime)
	if not is_debug then return end
	if not get_bool("dismantle_debug","dbg_enable_operations_casting") then return end
	local header = "("..log_number..")".."[CONST GIVE]"
	showtime = showtime or 5000
	const_content = const_content or "(?)"
	const_amt = const_amt or "default"
	local info = "CONST GIVE ==      "..const_content.."     CONST GIVE AMOUNT ==      "..const_amt
	news_manager.send_tip(getLocalActor(),info,nil,nil,showtime,nil,header,"dh_dbg_operation_icon_mechs")
	log_number = log_number + 1
end
function cast_console(txt)
	if not is_debug then return end
	if configltx:r_bool("dismantle_debug","dbg_enable_cast_console") then
		alun_utils.debug_write(txt)
	end
end
function cast_console_for_const(txt)
	if not is_debug then return end
	if configltx:r_bool("dismantle_debug","dbg_enable_cast_console_for_const") then 
		alun_utils.debug_write(txt)
	end
end