-- PORT_NOTES (Misery_Coop_Port, tools/build_cooking.py) -- coop-adapted
-- Misery dismantle UI (2544 lines), coop. Parses the deployed ui_itm_main.xml;
-- runs client-side off the local player's inventory + item conditions. The
-- dismantle itself reads conditions and spawns the recovered parts. set_condition
-- is CLIENT-side and PERSISTS in coop. The server ops -- the local give()/give_const
-- (give_const funnels through give()), the 4 direct part/gauss/tool alife:create,
-- and the source-item alife:release -- route through the mc_cooking item-wear RPC
-- (itemop_give/itemop_release). The 3 ammo-unload alife:create_ammo (recover loaded
-- rounds on dismantle) are coop-stubbed (do end) for v1: itemop_give would spawn a
-- full box, not the loaded count -- proper ammo-stack recovery is a bughunt-pass
-- refinement. blanket: db.actor->getLocalActor, alife():object->level.object_by_id,
-- :section_name->:section. Dispatch (itms_manager) already active: DismantleModEnable
-- is the items_refunct_mod/dismantle_enable sub-flag (true, not flipped by ship).
-- STATE_Write guard: the 3 get_weapon_data reads are pcall'd + fall back to a safe
-- table -- STATE_Write is nil on client objects in the fork -> CTD on weapon-select.

--#####################################################################################
--## Dismantle feature, Items Refunct Mod for MISERY mod  ##  scripting by Plaargath ##
--#####################################################################################
---------------------------------------------------------------------------------------
-- thx: kcs123, tt44, CrommCruac for support
---------------------------------------------------------------------------------------

local plugin, configltx = ini_file("plugins\\dismantle.ltx"), ini_file("plugins\\dismantle_configs.ltx")
local plx, clx = "[dismantle.ltx] ", "[dismantle_configs.ltx] "
local is_debug = alun_utils.read_from_ini(ini_file("debug\\xrs_debug_tools.ltx"),"plugin","enable","bool",true,"xrs_debug_tools")

class "load_item" (CUIListBoxItem)
function load_item:__init(height) super(height)
	self.file_name = "filename"
	self:SetTextColor(GetARGB(255, 170, 170, 170))
	self.fn = self:GetTextItem()
	self.fn:SetFont(GetFontLetterica18Russian())
	self.fn:SetEllipsis(true)
end
function load_item:__finalize()
end
class "irm_dismantle" (CUIScriptWnd)


---------------------------
-- MAIN DISMANTLE WINDOW --
---------------------------
function irm_dismantle:__init(owner,section) super()
	math.randomseed(device():time_global())
	self.tool = section
	self.trgt = nil
	self.empty_kits_enabled = alun_utils.read_from_ini(ini_file("plugins\\itms_manager.ltx"),"items_refunct_mod","empty_kits_enable","bool",true)
	self:InitControls()
	self:InitCallBacks()
end
function irm_dismantle:__finalize()
end

function irm_dismantle:InitControls()
	self:SetWndRect(Frect():set(0,0,1024,768))
	self:SetAutoDelete(true)
	self.xml = CScriptXmlInit()
	local ctrl
	self.xml:ParseFile("ui_itm_main.xml")
	ctrl = CUIWindow()
	self.xml:InitWindow("dismantle:file_item:main",0,ctrl)
	self.file_item_main_sz = vector2():set(ctrl:GetWidth(),ctrl:GetHeight())
	self.xml:InitWindow("dismantle:file_item:fn",0,ctrl)
	self.file_item_fn_sz = vector2():set(ctrl:GetWidth(),ctrl:GetHeight())
	self.xml:InitWindow("dismantle:file_item:fd",0,ctrl)
	self.file_item_fd_sz = vector2():set(ctrl:GetWidth(),ctrl:GetHeight())
	self.form = self.xml:InitStatic("dismantle:form",self)
	self.form:SetWndPos(vector2():set(0, 0))

	-- TARGET title
	self.caption_trgts_title = self.xml:InitTextWnd("dismantle:form:caption_trgts_title",self.form)
	self.caption_trgts_title:SetText(game.translate_string("st_dismantle_ui_caption_trgts_title"))
	-- TARGET icon
	self.icon_trgt = self.xml:InitStatic("dismantle:form:icon_trgt",self.form)
	-- TOOL name
	local tool_name = game.translate_string(system_ini():r_string(self.tool,"inv_name"))
	self.caption_tool = self.xml:InitTextWnd("dismantle:form:caption_tool",self.form)
	self.caption_tool:SetText(tool_name)
	-- TOOL icon
	self.uiic = self.xml:InitStatic("dismantle:form:icon_tool",self.form)
	local inv_grid_width 	= system_ini():r_float(self.tool,"inv_grid_width")
	local inv_grid_height 	= system_ini():r_float(self.tool,"inv_grid_height")
	local inv_grid_x 		= system_ini():r_float(self.tool,"inv_grid_x")
	local inv_grid_y 		= system_ini():r_float(self.tool,"inv_grid_y")
	local x1 = inv_grid_x*50
	local y1 = inv_grid_y*50
	local w = inv_grid_width*50
	local h = inv_grid_height*50
	local x2 = x1 + w
	local y2 = y1 + h
	local w,h = w,h
	if (utils.is_widescreen()) then
		w,h = w/1.2,h/1
	else
		w,h = w/1,h/1
	end
	self.uiic:InitTexture("ui\\ui_icon_equipment")
	self.uiic:SetTextureRect(Frect():set(x1,y1,x2,y2))
	self.uiic:SetWndSize(vector2():set(w,h))
	if not (self.uiic.x) then
		local pos = self.uiic:GetWndPos()
		local posform = self.form:GetWndPos()
		self.uiic.x = pos.x + posform.x
		self.uiic.y = pos.y + posform.y
	end
	self.uiic:SetWndPos(vector2():set(self.uiic.x-w/2, self.uiic.y-h/2))

	-- CAPTIONS
	-- target caption
	self.caption_trgts = self.xml:InitTextWnd("dismantle:form:caption_trgts",self.form)
	self.list_box_trgts = self.xml:InitListBox("dismantle:form:list_trgts",self.form)
	local frame = self.xml:InitFrame("dismantle:form:list_frame_trgts",self.form)
	self.list_box_trgts:ShowSelectedItem(true)
	self:Register(self.list_box_trgts,"list_window_trgts")
	-- secondary hint captions
	self.caption_left_inner_title = self.xml:InitTextWnd("dismantle:form:caption_left_inner_title",self.form)
	self.caption_warning = self.xml:InitTextWnd("dismantle:form:caption_warning",self.form)
	self.caption_aux_title = self.xml:InitTextWnd("dismantle:form:caption_aux_title",self.form)
	self.caption_aux = self.xml:InitTextWnd("dismantle:form:caption_aux",self.form)
	-- main hint caption
	self.slots_warning = self.xml:InitTextWnd("dismantle:form:slots_warning",self.form)
	self.slots_warning:SetText("")

	-- BUTTONS
	ctrl = self.xml:Init3tButton("dismantle:form:btn_ok",self.form)
	self:Register(ctrl,"button_ok")
	ctrl = self.xml:Init3tButton("dismantle:form:btn_cancel",self.form)
	self:Register(ctrl,"button_cancel")
	ctrl = self.xml:Init3tButton("dismantle:form:btn_help",self.form)
	self:Register(ctrl,"button_help")

	-- HELP TABS
	self.help_bg = self.xml:InitStatic("dismantle:form:help_bg",self.form)
	self.help_bg:Show(false)
	self.helptabs = {}
	self.helptabs.row1col1 = self.xml:InitStatic("dismantle:form:tab_row1col1",self)
	self.helptabs.row2col1 = self.xml:InitStatic("dismantle:form:tab_row2col1",self)
	self.helptabs.row1col2 = self.xml:InitStatic("dismantle:form:tab_row1col2",self)
	self.helptabs.row2col2 = self.xml:InitStatic("dismantle:form:tab_row2col2",self)
	self.helptabs.row1col3 = self.xml:InitStatic("dismantle:form:tab_row1col3",self)
	self.helptabs.row2col3 = self.xml:InitStatic("dismantle:form:tab_row2col3",self)
	self.helptabs.row1col4 = self.xml:InitStatic("dismantle:form:tab_row1col4",self)
	self.helptabs.row2col4 = self.xml:InitStatic("dismantle:form:tab_row2col4",self)
	self.helptabs["row1col1"]:Show(false)
	self.helptabs["row2col1"]:Show(false)
	self.helptabs["row1col2"]:Show(false)
	self.helptabs["row2col2"]:Show(false)
	self.helptabs["row1col3"]:Show(false)
	self.helptabs["row2col3"]:Show(false)
	self.helptabs["row1col4"]:Show(false)
	self.helptabs["row2col4"]:Show(false)
	self.tabs = self.xml:InitTab("dismantle:form:tabs",self)
	self:Register(self.tabs,"tabs")
	self.tabs:Show(false)

	-- Get equipped items' IDs
	if getLocalActor():item_in_slot(2)  then self.slot2_id  = getLocalActor():item_in_slot(2):id()  end
	if getLocalActor():item_in_slot(3)  then self.slot3_id  = getLocalActor():item_in_slot(3):id()  end
	if getLocalActor():item_in_slot(7)  then self.slot7_id  = getLocalActor():item_in_slot(7):id()  end
	if getLocalActor():item_in_slot(9)  then self.slot9_id  = getLocalActor():item_in_slot(9):id()  end
	if getLocalActor():item_in_slot(12) then self.slot12_id = getLocalActor():item_in_slot(12):id() end

end
function irm_dismantle:InitCallBacks()
	self:AddCallback("button_ok",			ui_events.BUTTON_CLICKED,			self.OnButtonOk,				self)
	self:AddCallback("button_cancel",		ui_events.BUTTON_CLICKED,			self.OnButtonCancel,			self)
	self:AddCallback("list_window",			ui_events.LIST_ITEM_CLICKED,		self.OnListItemClicked,			self)
	self:AddCallback("list_window",			ui_events.WINDOW_LBUTTON_DB_CLICK,	self.OnListItemDbClicked,		self)
	self:AddCallback("list_window_trgts",	ui_events.LIST_ITEM_CLICKED,		self.OnTargetsListItemClicked,	self)
	self:AddCallback("list_window_trgts",	ui_events.WINDOW_LBUTTON_DB_CLICK,	self.OnTargetsListItemDbClicked,self)
	self:AddCallback("button_help",			ui_events.BUTTON_CLICKED,			self.OnButtonHelp,				self)
	self:AddCallback("tabs",				ui_events.TAB_CHANGED,				self.OnTabsClicked,				self)
end

function irm_dismantle:FillTargetsList()
	self.list_box_trgts:RemoveAll()
	local is_tool_error
	local first_PDA_not_found = true

	-- (LOCAL UTIL)
	local function choose_targets(actor,obj)
		if obj then
			local con
			if get_plugin("targets_with_condition")[obj:section()] then
				con = obj:condition()
			end

			if self:tool_is_in("tools_outfit_dismantlers") then
				if get_plugin("trgts_for_outfit_dismantlers")[obj:section()] then
					self:AddItemToList(obj,self.list_box_trgts,con)
				end
			elseif self:tool_is_in("tools_weapon_dismantlers") then
				if get_plugin("trgts_for_wpn_dismantlers")[obj:section()] then
					self:AddItemToList(obj,self.list_box_trgts,con)
				end
			elseif self:tool_is_in("tools_all_makeshift") then
				if get_plugin("trgts_for_"..self.tool)[obj:section()] then
					if obj:section() ~= "device_pda" then
						self:AddItemToList(obj,self.list_box_trgts,con)
					else
						if first_PDA_not_found then
							first_PDA_not_found = nil
						else
							self:AddItemToList(obj,self.list_box_trgts,con)
						end
					end
				end
			else
				is_tool_error = true
			end
		end
	end

	getLocalActor():iterate_inventory(choose_targets,getLocalActor())

	if is_tool_error then
		self:cast(plx.."Unknown dismantling tool.","FillTargetsList() -> choose_targets()",100)
		self:OnButtonCancel()
		return
	end

	if self.list_box_trgts:GetSize() == 0 then
		self.caption_trgts:SetText(game.translate_string("st_dismantle_ui_no_trgts"))
	end
end
function irm_dismantle:AddItemToList(item,listbox,condition)
	local func = "AddItemToList()"
	local _itm = load_item(self.file_item_main_sz.y)
	local sec = item and item:section()
	local inv_name = item and game.translate_string(system_ini():r_string(sec,"inv_name")) or "//cannot read inv_name//"
	if inv_name == "//cannot read inv_name//" then
		self:cast("Cannot read targets inv_name from target config.",func,101)
	end

	_itm:SetWndSize(self.file_item_main_sz)
	_itm.fn:SetWndPos(vector2():set(0,0))
	_itm.fn:SetWndSize(self.file_item_fn_sz)
	_itm.fn:SetText(inv_name)

	if (item) then
		_itm.item_id = item:id()
		if condition then
			condition = math.ceil(condition*100)
			_itm.fage = _itm:AddTextField(condition.."%", self.file_item_fd_sz.x)
			_itm.fage:SetWndPos	(vector2():set(self.file_item_fn_sz.x-14, 0))
		end
		local inv_grid_width 	= system_ini():r_float(sec,"inv_grid_width")
		local inv_grid_height 	= system_ini():r_float(sec,"inv_grid_height")
		local inv_grid_x 		= system_ini():r_float(sec,"inv_grid_x")
		local inv_grid_y 		= system_ini():r_float(sec,"inv_grid_y")
		_itm.x1 = inv_grid_x*50
		_itm.y1 = inv_grid_y*50
		_itm.width = inv_grid_width*50
		_itm.height = inv_grid_height*50
		_itm.x2 = _itm.x1 + _itm.width
		_itm.y2 = _itm.y1 + _itm.height
	end

	listbox:AddExistingItem(_itm)
end

function irm_dismantle:OnTargetsListItemClicked()
	local func = "OnTargetsListItemClicked()"
	self.slots_warning:SetText("")
	-- Checks
	if self.list_box_trgts:GetSize()==0 then return end

	local item = self.list_box_trgts:GetSelectedItem()
	if not item then
		self.icon_trgt:SetTextureRect(Frect():set(0,0,0,0))
		self.caption_trgts:SetText("")
		return
	end

	local se_item = item.item_id and level.object_by_id(item.item_id)
	if se_item == nil or not getLocalActor():object(se_item:section()) then
		self.list_box_trgts:RemoveItem(item)
		return
	end

	-- Say hello to my little friend
	self.trgt = se_item:section()

	-- Show UI Icon
	local w,h = item.width,item.height
	if (utils.is_widescreen()) then
		w,h = item.width/1.2,item.height/1
	else
		w,h = item.width/1,item.height/1
	end
	if item.width > 299 then
		w,h = w*0.66,h*0.66
	elseif item.width > 199 then
		w,h = w*0.85,h*0.85
	end
	if item.height > 149 then
		w,h = w*0.66,h*0.66
	end
	self.icon_trgt:InitTexture("ui\\ui_icon_equipment")
	self.icon_trgt:SetTextureRect(Frect():set(item.x1,item.y1,item.x2,item.y2))
	self.icon_trgt:SetWndSize(vector2():set(w,h))

	if not (self.icon_trgt.x) then
		local pos = self.icon_trgt:GetWndPos()
		self.icon_trgt.x = pos.x
		self.icon_trgt.y = pos.y
	end
	self.icon_trgt:SetWndPos(vector2():set(self.icon_trgt.x-w/2, self.icon_trgt.y-h/2))

	-- Sanity checks
	if not self:trgt_is_in("all_targets") then
		self:cast(plx.."Target not included in plugin lists.",func,102)
		return
	end
	if not self:tool_is_in("all_tools") then
		self:cast(plx.."Tool not included in plugin lists.",func,103)
		return
	end

	-- Handle UI Captions
	self.caption_trgts:SetText(game.translate_string("st_dismantle_ui_hint1"))
	self.caption_left_inner_title:SetText("")
	self.caption_warning:SetText("")
	self.caption_aux:SetText("")
	-- Dynamic wpn warning and info
	if self:trgt_is_in("all_wpn_firearms_lists") then
		local item_by_id = level.object_by_id(item.item_id)
		local trgt = level.object_by_id(item_by_id:id())
		local wpn_data = (function() local ok, d = pcall(stpk_utils.get_weapon_data, trgt); return ok and d or {addon_flags = 0, ammo_elapsed = 0, ammo_type = 0, upgrades = {}} end)()  -- coop: STATE_Write nil client-side; fall back so dismantle proceeds
		local addon_flags = wpn_data.addon_flags
		-- Warning about wpn scopes not being handled
		for i = 1,7,2 do
			if addon_flags == i then
				self.caption_left_inner_title:SetText(game.translate_string("st_dismantle_ui_warning_title"))
			end
		end
		-- Clue about all wpn addons handling
		for i = 1,7 do
			if addon_flags == i then
				self.caption_warning:SetText(game.translate_string("st_dismantle_ui_addon_"..i))
			end
		end
	end

	-- Handle auxiliary tool
	self:IncludeAuxTool()

	-- Display warning for equipped items
	if item.item_id == self.slot2_id then
		self.slots_warning:SetText(game.translate_string("st_dismantle_ui_warning_slot_2"))
	elseif item.item_id == self.slot3_id then
		self.slots_warning:SetText(game.translate_string("st_dismantle_ui_warning_slot_3"))
	elseif item.item_id == self.slot7_id then
		self.slots_warning:SetText(game.translate_string("st_dismantle_ui_warning_slot_7"))
	elseif item.item_id == self.slot9_id then
		self.slots_warning:SetText(game.translate_string("st_dismantle_ui_warning_slot_9"))
	elseif item.item_id == self.slot12_id then
		self.slots_warning:SetText(game.translate_string("st_dismantle_ui_warning_slot_12"))
	end

end
function irm_dismantle:OnTargetsListItemDbClicked()
	self:OnButtonOk()
end

function irm_dismantle:OnKeyboard(dik,keyboard_action)
	local bind = dik_to_bind(dik)
	CUIScriptWnd.OnKeyboard(self,dik,keyboard_action)
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik ~= nil
		and bind ~= key_bindings.kUSE
		and dik ~= DIK_keys.MOUSE_1
		and dik ~= DIK_keys.DIK_H
		and bind ~= key_bindings.kJUMP
		then
			self:OnButtonCancel()
		elseif bind == key_bindings.kUSE then
			self:OnButtonOk()
		elseif bind == key_bindings.kJUMP then
			self:OnButtonHelp()
		elseif dik == DIK_keys.DIK_H then
			self:OnButtonHelp()
		end
	end
	return true
end
function irm_dismantle:OnButtonCancel()
	give(self.tool)
	self:ClearMemory()
	if self:IsShown() then self:HideDialog() end
end
function irm_dismantle:OnButtonOk()
	local func = "OnButtonOk()"
	if self.list_box_trgts:GetSize() == 0 then
		self:FinishWith("UI_cancel_override","override_no_trgt")
		return
	end

	self.caption_trgts:SetText(game.translate_string("st_dismantle_ui_hint2"))
	if (self.list_box_trgts) then
		index = self.list_box_trgts:GetSelectedIndex()
		if (index ~= -1) then
			item = self.list_box_trgts:GetItemByIndex(index)
			local se_trgt = item and item.item_id and level.object_by_id(item.item_id)
			if (se_trgt) then
				-- Sanity check
				if self.trgt ~= se_trgt:section() then
					self:cast("Unfortunately shit have just hit the fan.",func,104)
					return
				end

				-- CLASS BONUS
				local class_suffix = system_ini():r_string("actor","actor_class")
				self.actor_class_main_bonus = get_float("class_bonus","cb_main_class_bonus_"..class_suffix)
				self.actor_class_fail_bonus = get_float("class_bonus","cb_fail_class_bonus_"..class_suffix)
				self.actor_class_cdec_bonus = get_float("class_bonus","cb_cdec_class_bonus_"..class_suffix)
				self.actor_class_blnt_bonus = get_float("class_bonus","cb_blnt_class_bonus_"..class_suffix)

				-- SWITCHGEAR
				if self:trgt_is_in("all_wpn_firearms_lists") then
					self:DismantleFirearm(se_trgt,"wpn")
				elseif self:trgt_is_in("all_outfits_lists") then
					self:DismantleOutfit(se_trgt,"outfit")
				elseif self:trgt_is_in("all_helmets_list") then
					self:DismantleHelm(se_trgt)
				elseif self:trgt_is_in("weapon_gauss") then
					self:DismantleGauss(se_trgt)
				elseif self:trgt_is_in("all_wpn_related_targets") then
					self:DismantleWpnRelated(se_trgt)
				elseif self:trgt_is_in("all_outftit_related_targets") then
					self:DismantleOutfitRelated(se_trgt)
				elseif self:trgt_is_in("all_electric_items") then
					self:DismantleAllElectr(se_trgt)
				else
					self:cast(plx.."No target qualified for dismantling.",func,105)
				end

			else
				return
			end
		else
			return
		end
	end
end


--------------------------
-- HELP WINDOW AND TABS --
--------------------------
local HelpTabState
function irm_dismantle:OnButtonHelp()
	if self.help_bg:IsShown() then
		for k,v in pairs(self.helptabs) do
			v:Show(false)
		end
		self.tabs:Show(false)
		self.help_bg:Show(false)
	else
		self.help_bg:Show(true)
		self.tabs:Show(true)
		self.tabs:SetActiveTab(HelpTabState or "row1col1")
		self.helptabs[HelpTabState]:Show(true)
	end
end
function irm_dismantle:OnTabsClicked()
	local tab_selection = self.tabs:GetActiveId()
	if not (self.helptabs[tab_selection]) then return end
	for k,v in pairs(self.helptabs) do
		v:Show(false)
	end
	self.helptabs[tab_selection]:Show(true)
	HelpTabState = tab_selection
end


-----------------------------------
-- DISMANTLE OPERATION ON TARGET --
-----------------------------------
function irm_dismantle:DismantleFirearm(se_trgt,trgt_genus)
	local func = "DismantleFirearm()"
	-- Recognize target species
	local trgt_species
	if     self:trgt_is_in("weapon_handgun") 	then trgt_species = "handgun"
	elseif self:trgt_is_in("weapon_smg") 		then trgt_species = "smg"
	elseif self:trgt_is_in("weapon_smgscope") 	then trgt_species = "smgscope"
	elseif self:trgt_is_in("weapon_rifle") 		then trgt_species = "rifle"
	elseif self:trgt_is_in("weapon_riflescope") then trgt_species = "riflescope"
	elseif self:trgt_is_in("weapon_heavy") 		then trgt_species = "heavy"
	elseif self:trgt_is_in("weapon_heavyscope") then trgt_species = "heavyscope"
	else
		self:cast(plx.."Target not included in plugin targets list.",func,210.1)
		return
	end

	-- Tool behaviour: tool fail check
	if self:TestToolFail(trgt_genus,trgt_species) then
		self:ToolFailOverride(trgt_genus,trgt_species)
		return
	end
	-- Tool behaviour: read tool behaviour from config and execute
	self:ExecuteToolBehaviour(self:GetFromConfig("skip",trgt_genus.."_tool_bhv"))

	-- Recognize weapon condition tier from config
	local tier_amt = get_float("wpn_probabs","tier_amt")
	local tier_tresholds = {}
	for i = 1,tier_amt do
		tier_tresholds[i] = get_float("wpn_probabs","tier_"..i.."_perc")
	end
	-- Get base dismantle probab from config
	local trgt_con, probab = self:TargetCondition()
	for i = tier_amt,1,-1 do
		if trgt_con <= tier_tresholds[i] then
			probab = get_float("wpn_probabs","tier_"..i.."_main_slot_probab")
			break
		end
	end

	-- Get adjusted probab form config, according to actor class and currently used dismantling tool
	local cfg_line = self:tool_is_in("tools_all_dismantle_kits") and "dp_kit" or "dp_"..self.tool
	probab = probab + get_float("wpn_probabs",cfg_line) + self.actor_class_main_bonus

	-- Weapons with fixed addons : check target subspecies and read corresponding slot content from config
	local wpn_slot_silencer_amt, wpn_slot_grndlnch_amt
	local wpn_slot_grndlnch_succ, wpn_slot_silencer_succ, wpn_slot_scope_succ
	-- -- Fixed silencers
	if self:trgt_is_in("all_wpn_fixed_silencers") then
		wpn_slot_silencer_amt = 1
		if self:trgt_is_in("fixed_silencer_556x45") then
			wpn_slot_silencer_succ = get_string("wpn_fixed_silencer_content","wpn_slot_sil55645_succ")
		elseif self:trgt_is_in("fixed_silencer_9x18") then
			wpn_slot_silencer_succ = get_string("wpn_fixed_silencer_content","wpn_slot_sil918_succ")
		elseif self:trgt_is_in("fixed_silencer_9x39") then
			wpn_slot_silencer_succ = get_string("wpn_fixed_silencer_content","wpn_slot_sil939_succ")
		elseif self:trgt_is_in("fixed_silencer_svu") then
			wpn_slot_silencer_succ = get_string("wpn_fixed_silencer_content","wpn_slot_silsvu_succ")
		end
	end
	-- -- Fixed grenade launchers
	if self:trgt_is_in("all_wpn_fixed_grndlnch") then
		wpn_slot_grndlnch_amt = 1
		if self:trgt_is_in("fixed_grndlnch_east") then
			wpn_slot_grndlnch_succ = get_string("wpn_fixed_grndlnch_content","wpn_slot_grndlnch_east_succ")
		elseif self:trgt_is_in("fixed_grndlnch_west") then
			wpn_slot_grndlnch_succ = get_string("wpn_fixed_grndlnch_content","wpn_slot_grndlnch_west_succ")
		end
	end
	-- -- Fixed scopes
	if self:trgt_is_in("all_wpn_firearms_with_fixed_scopes") then
		-- Additional plugin integrity check
		if not self:trgt_is_in("all_wpn_fixed_scopes") then
			self:cast(plx.."Plugin incomplete. Compare sections: [all_wpn_firearms_lists] and [all_wpn_fixed_scopes].",func,210.2)
			return
		end

		-- Define current target scope tier from config
		local scope_tier_tresholds, which_variety = {}
		tier_amt = 3
		
		for i = 1,tier_amt do
			scope_tier_tresholds[i] = get_float("wpn_probabs","fixed_scope_tier_"..i.."_perc")
		end
		
		for i = tier_amt,1,-1 do
			if trgt_con <= scope_tier_tresholds[i] then
				which_variety = i
				break
			end
		end

		-- Read scope variety from config
		if self:trgt_is_in("fixed_scope_wp") then
			wpn_slot_scope_succ = get_string("wpn_fixed_scope_tier_"..which_variety.."_content","fixed_scope_wp")
		elseif self:trgt_is_in("fixed_scope_wp_special") then
			wpn_slot_scope_succ = get_string("wpn_fixed_scope_tier_"..which_variety.."_content","fixed_scope_wp_special")
		elseif self:trgt_is_in("fixed_scope_zf") then
			wpn_slot_scope_succ = get_string("wpn_fixed_scope_tier_"..which_variety.."_content","fixed_scope_zf")
		elseif self:trgt_is_in("fixed_scope_susat") then
			wpn_slot_scope_succ = get_string("wpn_fixed_scope_tier_"..which_variety.."_content","fixed_scope_susat")
		elseif self:trgt_is_in("fixed_scope_susat_moist") then
			wpn_slot_scope_succ = get_string("wpn_fixed_scope_tier_"..which_variety.."_content","fixed_scope_susat_moist")
		elseif self:trgt_is_in("fixed_scope_acog_trijicon") then
			wpn_slot_scope_succ = get_string("wpn_fixed_scope_tier_"..which_variety.."_content","fixed_scope_acog_trijicon")
		elseif self:trgt_is_in("fixed_scope_snag") then
			wpn_slot_scope_succ = get_string("wpn_fixed_scope_tier_"..which_variety.."_content","fixed_scope_snag")
		elseif self:trgt_is_in("fixed_scope_m16") then
			wpn_slot_scope_succ = get_string("wpn_fixed_scope_tier_"..which_variety.."_content","fixed_scope_m16")
		elseif self:trgt_is_in("fixed_scope_m21") then
			wpn_slot_scope_succ = get_string("wpn_fixed_scope_tier_"..which_variety.."_content","fixed_scope_m21")
		elseif self:trgt_is_in("fixed_scope_m24") then
			wpn_slot_scope_succ = get_string("wpn_fixed_scope_tier_"..which_variety.."_content","fixed_scope_m24")
		elseif self:trgt_is_in("fixed_scope_ksvk") then
			wpn_slot_scope_succ = get_string("wpn_fixed_scope_tier_"..which_variety.."_content","fixed_scope_ksvk")
		elseif self:trgt_is_in("fixed_scope_trg") then
			wpn_slot_scope_succ = get_string("wpn_fixed_scope_tier_"..which_variety.."_content","fixed_scope_trg")
		elseif self:trgt_is_in("fixed_scope_sig_sniper") then
			wpn_slot_scope_succ = get_string("wpn_fixed_scope_tier_"..which_variety.."_content","fixed_scope_sig_sniper")
		elseif self:trgt_is_in("fixed_scope_fnfalpara") then
			wpn_slot_scope_succ = get_string("wpn_fixed_scope_tier_"..which_variety.."_content","fixed_scope_fnfalpara")
		elseif self:trgt_is_in("fixed_scope_rpg7") then
			wpn_slot_scope_succ = get_string("wpn_fixed_scope_tier_"..which_variety.."_content","fixed_scope_rpg7")
		end
	end

	-- Build slots content table from gathered data
	local slot_def = "slot_definitions_"..trgt_genus.."_"..trgt_species
	local t_slots = {
			["light"] = {
				["amt"] =  get_string(slot_def,"wpn_slot_light_amt") or 0,
				["succ"] = get_string("wpn_slot_content","wpn_slot_light_succ"),
				["fail"] = get_string("wpn_slot_content","wpn_slot_light_fail")
				},
			["heavy"] = {
				["amt"] =  get_string(slot_def,"wpn_slot_heavy_amt") or 0,
				["succ"] = get_string("wpn_slot_content","wpn_slot_heavy_succ"),
				["fail"] = get_string("wpn_slot_content","wpn_slot_heavy_fail")
				},
			["scope"] = {
				["amt"] =  get_string(slot_def,"wpn_slot_scope_amt") or 0,
				["succ"] = wpn_slot_scope_succ,
				["fail"] = get_string("wpn_slot_content","wpn_slot_scope_fail")
				},
			["silencer"] = {
				["amt"] =  wpn_slot_silencer_amt or 0,
				["succ"] = wpn_slot_silencer_succ,
				["fail"] = get_string("wpn_slot_content","wpn_slot_silencer_fail")
				},
			["grndlnch"] = {
				["amt"] =  wpn_slot_grndlnch_amt or 0,
				["succ"] = wpn_slot_grndlnch_succ,
				["fail"] = get_string("wpn_slot_content","wpn_slot_grndlnch_fail")
				}
		}
	-- Execute content table
	for k, v in pairs(t_slots) do
		for i = 1, v.amt do
			if test_on(probab) then
				give(v.succ)
			else
				give(v.fail)
			end
		end
	end

	-- Execute const content
	give_const("all_"..trgt_genus)

	-- Basic operations: ammo unload , detach addon
	if self:TargetCondition() >= get_float("wpn_probabs","weapon_critical_con_treshold") then
		self:UnloadCurrentAmmo()
		self:DetachCurrentAddons()
	else
		give(get_string("wpn_slot_content","wpn_unload_ammo_fail"))
		give(get_string("wpn_slot_content","wpn_addon_detach_fail"))
	end

	self:KillTarget(se_trgt)

	-- Finish with selected AV effect
	local finish_content
	if self:tool_is_in("tools_all_dismantle_kits") then
		finish_content = "kit"
	elseif self.tool == "cutlery_sharp" then
		finish_content = "cutlery"
	elseif self.tool == "swiss_sharp" then
		finish_content = "cutlery"
	elseif self.tool == "grooming_sharp" then
		finish_content = "metalplastic"
	else
		finish_content = "hit"
	end
	self:FinishWith("weapon",finish_content)
end
	function irm_dismantle:UnloadCurrentAmmo()
		local func = "UnloadCurrentAmmo()"
		local item = self.list_box_trgts:GetSelectedItem()
		local item_by_id = level.object_by_id(item.item_id)
		local trgt = level.object_by_id(item_by_id:id())
		local wpn_data = (function() local ok, d = pcall(stpk_utils.get_weapon_data, trgt); return ok and d or {addon_flags = 0, ammo_elapsed = 0, ammo_type = 0, upgrades = {}} end)()  -- coop: STATE_Write nil client-side; fall back so dismantle proceeds
		local amount_loaded = wpn_data.ammo_elapsed
		local type_number = wpn_data.ammo_type

		local ammoline
		if next(wpn_data.upgrades) then
			for k,v in pairs (wpn_data.upgrades) do
				if system_ini():line_exist(v,"property") then
					if system_ini():r_string(v,"property") == "prop_calibre" then
						if system_ini():line_exist(v,"section") then
							local upg_sec = system_ini():r_string(v,"section")
							if system_ini():line_exist(upg_sec,"ammo_class") then
								ammoline = system_ini():r_string(upg_sec,"ammo_class")
							end
						end
					end
				end
			end
		end

		local ammo_section = self:DismantleFirearm_RecognizeAmmo(type_number, ammoline)

		if ammo_section then
			if amount_loaded ~= 0 then
				local box_size = system_ini():r_u32(ammo_section, "box_size")
				if amount_loaded > box_size then
					local boxes_in_elapsed, remainder
					boxes_in_elapsed = math.floor(amount_loaded / box_size)
					remainder = amount_loaded % box_size
					for i = 1, boxes_in_elapsed do
						do end
					end
					if remainder ~= 0 then
						do end
					end
				else
					do end
				end
			end
		else
			self:cast("Ammo recognized as nil.",func,211)
		end
	end
	function irm_dismantle:DetachCurrentAddons()
		-- scope detaching is not ready for this release, hence lines commented out
		local item = self.list_box_trgts:GetSelectedItem()
		local item_by_id = level.object_by_id(item.item_id)
		local trgt = level.object_by_id(item_by_id:id())
		local wpn_data = (function() local ok, d = pcall(stpk_utils.get_weapon_data, trgt); return ok and d or {addon_flags = 0, ammo_elapsed = 0, ammo_type = 0, upgrades = {}} end)()  -- coop: STATE_Write nil client-side; fall back so dismantle proceeds
		local addon_flags = wpn_data.addon_flags
		if addon_flags ~= 0 then
			if addon_flags == 1 then
				-- give(DismantleFirearm_RecognizeScope(trgt))
			elseif addon_flags == 2 then
				give(self:DismantleFirearm_RecognizeGrndlnchr())
			elseif addon_flags == 3 then
				give(self:DismantleFirearm_RecognizeGrndlnchr())
				-- give(DismantleFirearm_RecognizeScope(trgt))
			elseif addon_flags == 4 then
				give(self:DismantleFirearm_RecognizeSilencer())
			elseif addon_flags == 5 then
				give(self:DismantleFirearm_RecognizeSilencer())
				-- give(DismantleFirearm_RecognizeScope(trgt))
			elseif addon_flags == 6 then
				give(self:DismantleFirearm_RecognizeGrndlnchr())
				give(self:DismantleFirearm_RecognizeSilencer())
			elseif addon_flags == 7 then
				give(self:DismantleFirearm_RecognizeGrndlnchr())
				give(self:DismantleFirearm_RecognizeSilencer())
				-- give(DismantleFirearm_RecognizeScope(trgt))
			end
		end
	end
		function irm_dismantle:DismantleFirearm_RecognizeAmmo(ammo_type_number, ammoline)
			local func = "DismantleFirearm_RecognizeAmmo()"
			if system_ini():line_exist(self.trgt,"ammo_class") then
				ammoline = ammoline or system_ini():r_string(self.trgt,"ammo_class")
				local i = 0
				for ammo_section in string.gmatch(ammoline, '([^,]+)') do
					if i == ammo_type_number then return ammo_section end
					i = i + 1
				end
			else
				self:cast("WEAPON CONFIG: ["..self.trgt.."] Missing 'ammo_class'.",func,212)
			end
		end
		function irm_dismantle:DismantleFirearm_RecognizeSilencer()
			local func = "DismantleFirearm_RecognizeSilencer()"
			if system_ini():line_exist(self.trgt,"silencer_name") then
				return system_ini():r_string(self.trgt,"silencer_name")
			else
				self:cast("WEAPON CONFIG: Silencer addon flagged but cannot find 'silencer_name' line in weapons config.",func,213)
			end
		end
		function irm_dismantle:DismantleFirearm_RecognizeGrndlnchr()
			local func = "DismantleFirearm_RecognizeGrndlnchr()"
			if system_ini():line_exist(self.trgt,"grenade_launcher_name") then
				return system_ini():r_string(self.trgt,"grenade_launcher_name")
			else
				self:cast("WEAPON CONFIG: Grenade launcher addon flagged but cannot find 'grenade_launcher_name' line in weapons config.",func,214)
			end
		end
		function irm_dismantle:DismantleFirearm_RecognizeScope()
			--// not called anywhere //--
		end

function irm_dismantle:DismantleOutfit(se_trgt,trgt_genus)
	local func = "DismantleOutfit()"

	-- HOTFIX for SSP and SEVA outfits helm_protective spawn balance
	-- For details see 'how to' in dismantle_configs.ltx
		-- Check config
		if not configltx:section_exist("outfit_slot_definitions_ssp_helm") then
			self:cast(clx.."Missing section [outfit_slot_definitions_ssp_helm]",func,220.21)
			return
		end
		if not configltx:section_exist("outfit_slot_definitions_seva_helm") then
			self:cast(clx.."Missing section [outfit_slot_definitions_seva_helm]",func,220.22)
			return
		end
		if not configltx:line_exist("outfit_probabs","dp_ssp_helmet_scenario") then
			self:cast(clx.."Missing 'dp_ssp_helmet_scenario' line in [outfit_probabs] section.",func,220.23)
			return
		end
		if not configltx:line_exist("outfit_probabs","dp_ssp_helmet_condition_into_probab") then
			self:cast(clx.."Missing 'dp_ssp_helmet_condition_into_probab' line in [outfit_probabs] section.",func,220.24)
			return
		end
		-- Get probab
		local dp_ssphelm
		if get_bool("outfit_probabs","dp_ssp_helmet_condition_into_probab") then
			dp_ssphelm = self:TargetCondition() * 100 + self.actor_class_main_bonus
		else
			dp_ssphelm = get_float("outfit_probabs","dp_ssp_helmet_scenario") + self.actor_class_main_bonus
		end


	-- Recognize target species
	local trgt_species
	if self:trgt_is_in("outfit_light") then
		trgt_species = "light"
	elseif self:trgt_is_in("outfit_medium") then
		trgt_species = "medium"
	elseif self:trgt_is_in("outfit_heavy") then
		trgt_species = "heavy"
	elseif self:trgt_is_in("outfit_ssp") then
		if test_on(dp_ssphelm) then -- hotfix for balancing helm_protective
			trgt_species = "ssp_helm" -- hotfix: added artificial species
		else
			trgt_species = "ssp"
		end
	elseif self:trgt_is_in("outfit_seva") then
		if test_on(dp_ssphelm) then -- hotfix for balancing helm_protective
			trgt_species = "seva_helm" -- hotfix: added artificial species for
		else
			trgt_species = "seva"
		end
	elseif self:trgt_is_in("outfit_exo") then
		trgt_species = "exo"
	else
		self:cast(plx.."Target not included in plugin targets list.",func,220.1)
		return
	end

	-- Aux tool: handle or interrupt
	local aux_tool_dp_boost = self.aux_boost or 0
	if self.aux_demanded then
		if self.aux_obj then
			BluntAuxTool(self.aux_obj,self.aux_condec)
		else
			self:FinishWith("UI_cancel_override","override_no_aux")
			return
		end
	end

	-- Execute tool behaviour
	if get_bool(trgt_genus.."_tool_bhv","force_zerooneblunt") then
		self:ExecuteToolBehaviour("force_blunt","give")
	else
		self:ExecuteToolBehaviour(self:GetFromConfig("skip",trgt_genus.."_tool_bhv"))
	end

	-- Define base probab & patch amount
	local tier_amt = get_float(trgt_genus.."_probabs","tier_amt")
	local tier_tresholds = {}
	for i = 1,tier_amt do
		tier_tresholds[i] = get_float(trgt_genus.."_probabs","tier_"..i.."_perc")
	end
	local trgt_con, probab, patch_amt = self:TargetCondition()
	for i = tier_amt,1,-1 do
		if trgt_con <= tier_tresholds[i] then
			probab =    get_float(trgt_genus.."_probabs","tier_"..i.."_main_slot_probab")
			patch_amt = get_float(trgt_genus.."_probabs","tier_"..i.."_patch_amt")
			break
		end
	end
	-- Adjust probab with: tool probab adjustment, aux tool probab boost, class bonus
	local dp_suffix = self:tool_is_in("tools_all_dismantle_kits") and "kit" or self.tool
	probab = probab + get_float(trgt_genus.."_probabs","dp_"..dp_suffix) + aux_tool_dp_boost + self.actor_class_main_bonus

	-- Execute const content and patches
	give_const("all_outfits")
	if self:trgt_is_in("outfits_with_patches_list") then
		give(get_string("outfit_patches","op_"..self.trgt),patch_amt)
	end

	-- Prepare reading slots content from config
	local slot_def = trgt_genus.."_slot_definitions_"..trgt_species
	-- Build slots content table from config
	local t_slots = {
		["fabric1"] = {
			["amt"] = get_float(slot_def,"outfit_slot_fabric1_amt") or 0,
			["succ"] = get_string("outfit_slot_content","outfit_slot_fabric1_succ"),
			["fail"] = get_string("outfit_slot_content","outfit_slot_fabric1_fail")
			},
		["fabric2"] = {
			["amt"] = get_float(slot_def,"outfit_slot_fabric2_amt") or 0,
			["succ"] = get_string("outfit_slot_content","outfit_slot_fabric2_succ"),
			["fail"] = get_string("outfit_slot_content","outfit_slot_fabric2_fail")
			},
		["fabric3"] = {
			["amt"] = get_float(slot_def,"outfit_slot_fabric3_amt") or 0,
			["succ"] = get_string("outfit_slot_content","outfit_slot_fabric3_succ"),
			["fail"] = get_string("outfit_slot_content","outfit_slot_fabric3_fail")
			},
		["protect1"] = {
			["amt"] = get_float(slot_def,"outfit_slot_protect1_amt") or 0,
			["succ"] = get_string("outfit_slot_content","outfit_slot_protect1_succ"),
			["fail"] = get_string("outfit_slot_content","outfit_slot_protect1_fail")
			},
		["protect2"] = {
			["amt"] = get_float(slot_def,"outfit_slot_protect2_amt") or 0,
			["succ"] = get_string("outfit_slot_content","outfit_slot_protect2_succ"),
			["fail"] = get_string("outfit_slot_content","outfit_slot_protect2_fail")
			},
		["device1"] = {
			["amt"] = get_float(slot_def,"outfit_subslot_device_amt") or 0,
			["succ"] = get_string("outfit_slot_content","outfit_subslot_device1_succ"),
			["fail"] = get_string("outfit_slot_content","outfit_subslot_device_fail")
			},
		["device2"] = {
			["amt"] = get_float(slot_def,"outfit_subslot_device_amt") or 0,
			["succ"] = get_string("outfit_slot_content","outfit_subslot_device2_succ"),
			["fail"] = get_string("outfit_slot_content","outfit_subslot_device_fail")
			},
		["device3"] = {
			["amt"] = get_float(slot_def,"outfit_subslot_device_amt") or 0,
			["succ"] = get_string("outfit_slot_content","outfit_subslot_device3_succ"),
			["fail"] = get_string("outfit_slot_content","outfit_subslot_device_fail")
			},
		["helm"] = {
			["amt"] = get_float(slot_def,"outfit_slot_helmet_amt") or 0,
			["succ"] = get_string("outfit_slot_content","outfit_slot_helmet_succ"),
			["fail"] = get_string("outfit_slot_content","outfit_slot_helmet_fail")
			},
		}
	-- Execute slots content
	for k, v in pairs(t_slots) do
		for i = 1, v.amt do
			if test_on(probab) then
				give(v.succ)
			else
				give(v.fail)
			end
		end
	end
	-- Execute randomized gear subslot content
	local gear_amt = get_float(slot_def,"outfit_subslot_gear_amt")
	if gear_amt >= 1 then
		-- Build gear subslot content table
		local t_subslot = {
			["succ"] = {},
			["fail"] = get_string("outfit_slot_content","outfit_subslot_gear_fail")
			}
		local rnd_succ
		for i = 1, gear_amt do
			local rnd = math.random(3)
			if rnd == 1 then
				rnd_succ = get_string("outfit_slot_content","outfit_subslot_gear1_succ")
			elseif rnd == 2 then
				rnd_succ = get_string("outfit_slot_content","outfit_subslot_gear2_succ")
			elseif rnd == 3 then
				rnd_succ = get_string("outfit_slot_content","outfit_subslot_gear3_succ")
			end
			table.insert(t_subslot.succ, rnd_succ)
		end
		-- Execute gear subslot content
		for k, v in pairs(t_subslot.succ) do
			if test_on(probab) then
				give(v)
			else
				give(t_subslot.fail)
			end
		end
	end

	self:KillTarget(se_trgt)

	-- Finish with selected AV effect
	local finish_content
	if self:tool_is_in("tools_all_dismantle_kits") then
		finish_content = "kit"
	else
		finish_content = "hit"
	end
	self:FinishWith("outfit",finish_content)
end

function irm_dismantle:DismantleHelm(se_trgt)
	local func = "DismantleHelm()"
	if self:trgt_is_in("helmets_masks") then
		self:DismantleHelmNotTough(se_trgt,"helm","mask","all_helmets")
	elseif self:trgt_is_in("helmets_hardhats") then
		self:DismantleHelmTough(se_trgt,"helm","hard","all_helmets")
	elseif self:trgt_is_in("helmets_good") then
		self:DismantleHelmTough(se_trgt,"helm","good","all_helmets")
	else
		self:cast(plx.."Target not included in plugin targets list.",func,230)
	end
end
	function irm_dismantle:DismantleHelmNotTough(se_trgt,trgt_genus,trgt_species,const_give_inherit)
		-- Aux tool: handle or interrupt
		local aux_tool_dp_boost = self.aux_boost or 0
		if self.aux_demanded then
			if self.aux_obj then
				BluntAuxTool(self.aux_obj,self.aux_condec)
			else
				self:FinishWith("UI_cancel_override","override_no_aux")
				return
			end
		end

		-- Tool behaviour: read tool behaviour from config and execute
		self:ExecuteToolBehaviour(self:GetFromConfig("skip",trgt_genus.."_"..trgt_species.."_tool_bhv"))

		-- Define base probab
		local tier_amt = get_float(trgt_genus.."_"..trgt_species.."_probabs","tier_amt")
		local tier_tresholds = {}
		for i = 1,tier_amt do
			tier_tresholds[i] = get_float(trgt_genus.."_"..trgt_species.."_probabs","tier_"..i.."_perc")
		end
		local trgt_con, probab = self:TargetCondition()
		for i = tier_amt,1,-1 do
			if trgt_con <= tier_tresholds[i] then
				probab = get_float(trgt_genus.."_"..trgt_species.."_probabs","tier_"..i.."_main_slot_probab")
				break
			end
		end

		-- Adjust probab with: tool probab adjustment, aux tool probab boost, class bonus
		local dp_suffix = self:tool_is_in("tools_all_dismantle_kits") and "kit" or self.tool
		probab = probab + get_float(trgt_genus.."_"..trgt_species.."_probabs","dp_"..dp_suffix) + aux_tool_dp_boost + self.actor_class_main_bonus

		-- Execute content
		give_const(const_give_inherit)
		give_const("all_"..trgt_genus.."_"..trgt_species)
		self:ExecuteContentFromConfig(probab,trgt_genus.."_"..trgt_species)

		self:KillTarget(se_trgt)
		self:FinishWith("outfit","hit")
	end
	function irm_dismantle:DismantleHelmTough(se_trgt,trgt_genus,trgt_species,const_give_inherit)
		-- Aux tool: handle or interrupt
		local aux_tool_dp_boost = self.aux_boost or 0
		local aux_blunt_later
		if self.aux_demanded then
			if self.aux_obj then
				aux_blunt_later = true
			else
				self:FinishWith("UI_cancel_override","override_no_aux")
				return
			end
		end

		-- Tool behaviour: tool fail check
		if self:TestToolFail(trgt_genus,trgt_species) then
			self:ToolFailOverride(trgt_genus,trgt_species)
			return
		end

		-- Blunt aux tool
		if aux_blunt_later then 
			BluntAuxTool(self.aux_obj,self.aux_condec)
		end

		-- Tool behaviour: read tool behaviour from config and execute
		self:ExecuteToolBehaviour(self:GetFromConfig("skip",trgt_genus.."_"..trgt_species.."_tool_bhv"))

		-- Define base probab
		local tier_amt = get_float(trgt_genus.."_"..trgt_species.."_probabs","tier_amt")
		local tier_tresholds = {}
		for i = 1,tier_amt do
			tier_tresholds[i] = get_float(trgt_genus.."_"..trgt_species.."_probabs","tier_"..i.."_perc")
		end
		local trgt_con, probab = self:TargetCondition()
		for i = tier_amt,1,-1 do
			if trgt_con <= tier_tresholds[i] then
				probab = get_float(trgt_genus.."_"..trgt_species.."_probabs","tier_"..i.."_main_slot_probab")
				break
			end
		end
		-- Adjust probab with: tool probab adjustment, aux tool probab boost, class bonus
		local dp_suffix = self:tool_is_in("tools_all_dismantle_kits") and "kit" or self.tool
		probab = probab + get_float(trgt_genus.."_"..trgt_species.."_probabs","dp_"..dp_suffix) + aux_tool_dp_boost + self.actor_class_main_bonus

		-- Execute content
		give_const(const_give_inherit)
		give_const("all_"..trgt_genus.."_"..trgt_species)
		self:ExecuteContentFromConfig(probab,trgt_genus.."_"..trgt_species)

		self:KillTarget(se_trgt)
		self:FinishWith("outfit","hit")
	end

function irm_dismantle:DismantleGauss(se_trgt)
	local func = "DismantleGauss()"
	give_const("all_gauss_guns")
	local is_storyline_gauss

	--// Storyline gauss //--
	if self.trgt == "pri_a17_gauss_rifle" then
		local condec = get_float("gauss_rifles","storyline_gauss_con_decrease")
		if condec < 0 then
			condec = 0
			self:cast(clx.."[gauss] 'storyline_gauss_con_decrease' is < 0. Assuming 0.",func,241)
		elseif condec > 1 then
			condec = 1
			self:cast(clx.."[gauss] 'storyline_gauss_con_decrease' is > 1. Assuming 1.",func,242)
		end
		is_storyline_gauss = true
		self:DecreaseTargetCondition(condec)
		getLocalActor():drop_item(getLocalActor():object("pri_a17_gauss_rifle"))
	else
	--// Normal gauss //--
		-- Config content structure check
		local is_gauss_line = function(l) return configltx:line_exist("gauss_rifles",l) end
		if not is_gauss_line("gauss_1") then
			self:cast(clx.."Invalid [gauss_rifles] section structure.",func,243)
			return
		end
		-- Execute content from config
		if get_string("gauss_rifles","gauss_1") ~= "skip" then
			local i = 1
			repeat
				-- itms_refunct.spawn_in_front_quadrant(get_string("gauss","gauss_"..i))
				mc_cooking.itemop_give(get_string("gauss_rifles","gauss_"..i), 1)
				i = i + 1
			until is_gauss_line("gauss_"..i) ~= true
		end
		self:UnloadCurrentAmmo()
		self:KillTarget(se_trgt)
	end

	--// Tool behaviour //--
	if is_storyline_gauss then
		self:DropToolIntact()
	else
		self:DropToolZerooneBlunted()
	end

	self:FinishWith("target_surprise","gauss")
end

function irm_dismantle:DismantleWpnRelated(se_trgt)
	local func = "DismantleWpnRelated()"
	if self:trgt_is_in("explo_targets") then
		self:DismantleXplo(se_trgt,"xplo","all_wpn_related")
	elseif self:trgt_is_in("all_wpn_addon_targets") then
		self:DismantleWpnAddon(se_trgt,"wpn_addon","all_wpn_related")
	else
		self:cast(plx.."Target not included in plugin targets list.",func,250)
	end
end
	function irm_dismantle:DismantleWpnAddon(se_trgt,trgt_species,const_give_inherit)
		local func = "DismantleWpnAddon()"
		-- Recognize target subspecies
		local trgt_subspecies
		if     self:trgt_is_in("wpn_addon_grndlnch_targets")   then trgt_subspecies = "grndlnch"
		elseif self:trgt_is_in("wpn_addon_nightscope_targets") then trgt_subspecies = "nightscope"
		else
			self:cast(plx.."Target not included in plugin targets list.",func,251)
			return
		end

		-- Tool behaviour: tool fail check
		if self:TestToolFail(trgt_species,trgt_subspecies) then
			self:ToolFailOverride(trgt_species,"")
			return
		end

		local probab, tool_bhv = self:GetFromConfig(trgt_species.."_"..trgt_subspecies.."_probabs",trgt_species.."_"..trgt_subspecies.."_tool_bhv")
		give_const(const_give_inherit)
		give_const("all_"..trgt_species)
		self:ExecuteContentFromConfig(probab,trgt_species.."_"..trgt_subspecies.."_for_all")
		self:ExecuteToolBehaviour(tool_bhv)
		self:KillTarget(se_trgt)

		local finish_content
		if self:tool_is_in("tools_all_dismantle_kits") then
			finish_content = "kit"
		elseif self.tool == "cutlery_sharp" then
			finish_content = "cutlery"
		elseif self.tool == "swiss_sharp" then
			finish_content = "cutlery"
		elseif self.tool == "grooming_sharp" then
			finish_content = "metalplastic"
		else
			finish_content = "hit"
		end
		self:FinishWith("weapon",finish_content)
	end
	function irm_dismantle:DismantleXplo(se_trgt,trgt_species,const_give_inherit)
		if test_on(get_float(trgt_species.."_probabs","dp_main_"..self.trgt) + self.actor_class_main_bonus) then
			local probab, tool_bhv = self:GetFromConfig(trgt_species.."_probabs",trgt_species.."_tool_bhv",nil,nil,"dp_main_"..self.trgt)
			self:ExecuteContentFromConfig(probab,trgt_species)
			give_const(const_give_inherit)
			give_const("all_xplo")
			self:ExecuteToolBehaviour(tool_bhv)
			self:FinishWith("standard","metalplastic")
		else
			if get_string(trgt_species.."_content_"..self.trgt,"fail") == "event" then
				self:ExecuteToolBehaviour("force_blunt","drop")
				self:FinishWith("target_surprise","xplo")
			end
		end
		self:KillTarget(se_trgt)
	end

