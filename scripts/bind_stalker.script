-- PORT_NOTES (Misery_Coop_Port shadow)
-- Base: Call_Of_Pripyat_addon\scripts\bind_stalker.script (the canonical superset:
-- gameover screen, RPS game, gesture callback). Byte-identical except listed deltas.
-- Re-diff against base whenever the coop layer updates.
-- Delta 1: mp_actor_binder:update - mc_player_loop.on_local_spawn after the bCheckStart block.
-- Delta 2: mp_actor_binder:update - mc_player_loop.update at end of local-actor path.
-- Delta 3: mp_actor_binder:net_destroy - mc_player_loop.on_destroy before teardown.
-- Phase 3 will add the Misery item-use/callback blocks here (guarded, marked).

function init    (obj)
				if (OnClient()) then
					obj:bind_object(bind_stalker_cl(obj))
				else
					xr_motivator.AddToMotivator(obj)
				end
end

function actor_init    (npc)
	npc:bind_object(actor_binder(npc))	
end

function mp_actor_init    (npc)
					npc:bind_object(mp_actor_binder(npc))			
end

local game_difficulty_by_num = {
				[0] = "gd_novice",
				[1] = "gd_stalker",
				[2] = "gd_veteran",
				[3] = "gd_master"
				}

local weapon_hide = {}

class "mp_actor_binder" (object_binder)
function mp_actor_binder:__init (obj) super(obj)
	self.bCheckStart = false
	self.last_level_name = nil
	self.deimos_intensity = nil
	self.loaded_active_slot = 3
	self.loaded_slot_applied = false
	self.weather_manager = level_weathers.get_weather_manager()											
	self.surge_manager = surge_manager.get_surge_manager()
end

delayed_functions = {}

function add_delayed_function(funcName, timeout, params)
	local timestamp = time_global()
	
	local num = #delayed_functions + 1
	delayed_functions[num] = {}
	delayed_functions[num].name = funcName
	delayed_functions[num].timestamp = timestamp
	delayed_functions[num].timeout = timeout
	delayed_functions[num].params = params
end

function mp_actor_binder:update_delayed_functions()
	for k, v in pairs(delayed_functions) do
		if time_global() - v.timestamp > v.timeout then
			xr_effects[v.name](nil, nil, v.params)
			table.remove(delayed_functions, k)
		end
	end
end
function mp_actor_binder:init_gameover_screen()
	self.gameover_start_time = time_global()
	self.gameover_wnd = ui_gameover_wnd.gameover_wnd()
	self.gameover_wnd:InitControls()
	self.gameover_wnd:ShowDialog(true)
end

function mp_actor_binder:update_gameover_screen()
	local any_player_dead = xr_conditions.any_player_is_dead()
	
	if any_player_dead == false then
		return
	end
	
	if self.gameover_wnd == nil then
		self:init_gameover_screen()
	end
	
	local count = math.floor(10 - (time_global() - self.gameover_start_time) / 1000)
	
	if count >= 0 then
		self.gameover_wnd:getTimer():SetText(tostring(count))
	end 
	
	if count <= 0 and not story_flags.has_flag("LOAD_LAST_SAVE") then
		story_flags.give_flag("LOAD_LAST_SAVE")
		game_cl.executeFunctionOnServer("loadLastSave")
	end
end

function mp_actor_binder:net_spawn(data)
--	printf("actor net spawn")
	level.show_indicators()
	self.bCheckStart = true
	self.weapon_hide = false -- �������� ��� ��� ������ ��� ���������.
	self.weapon_hide_in_dialog = false
	weapon_hide = {} -- ������������� ���������� ���������� ����.
	self.task_manager = task_manager.get_task_manager()
	if object_binder.net_spawn(self,data) == false then
		return false
	end
	
	self.weather_manager:reset()			 
	db.add_obj(self.object)
	db.add_mp_actor(self.object)

	self.deimos_intensity = nil

	level.enable_input()

	--'������������� ������ �� ������������
	--self.task_manager = task_manager.get_task_manager()
	self.spawn_frame = device().frame
	self.already_jumped = false
	self.primary_objects_filled = false
	self.loaded = true	

	if data.story_id ~= "" then
		local previous_sid = get_object_story_id(self.object:id())
		if previous_sid == nil or previous_sid ~= data.story_id then
			add_story_object(self.object:id(), data.story_id)
		end
	end
	
	return true
end

function mp_actor_binder:reinit()
	object_binder.reinit(self)
	local npc_id = self.object:id()
	db.storage[npc_id] = { }
	self.st = db.storage[npc_id]
	self.st.pstor = nil
	
	self.object:set_callback(callback.inventory_info, self.info_callback, self)
	self.object:set_callback(callback.on_item_take, self.on_item_take, self)
	self.object:set_callback(callback.on_item_drop, self.on_item_drop, self)
	self.object:set_callback(callback.trade_sell_buy_item, self.on_trade, self) -- for game stats
	self.object:set_callback(callback.task_state, self.task_callback, self)
	self.object:set_callback(callback.take_item_from_box, self.take_item_from_box, self)
	self.object:set_callback(callback.use_object, self.use_inventory_item, self)
	self.object:set_callback(callback.gesture, self.use_gesture, self)
end

function mp_actor_binder:task_callback(_task, _state)
	if GameType() == game_cl.game_id_coop then
		if _state ~= task.fail then
			if not _task:is_silent_notify() then
				if _state == task.completed then
					news_manager.send_task(db.actor, "complete", _task)
				else
					news_manager.send_task(db.actor, "new", _task)
				end
			end
		end
		
		task_manager.task_callback(_task, _state)
		
		if _task:is_silent_notify() and _state == _task:get_target_state() then
			_task:set_silent_notify(false)
		end
	end
end

function mp_actor_binder:on_item_take(obj)

	-- PORT (Misery_Coop_Port): dispatch the Misery actor_on_item_take intercept chain (axr_main),
	-- which the coop binder never fired -> alun_riddle (axr_quest_master) + inventory_radiation
	-- take-callbacks were dead. Fires server-side here; the riddle's alife():create spawns are valid.
	if (axr_main and axr_main.actor_on_item_take) then axr_main.actor_on_item_take(obj) end
	--printf_msg("on_item_take [%s]", obj:name())
	if OnServer() then
		treasure_manager.get_treasure_manager():on_item_take(obj:id())
	end
	
	if isArtefact(obj) then
		-- PORT (Misery_Coop_Port): hard client CTD at the elseif below, "attempt to index
		-- field 'object' (a nil value)". net_destroy releases self.object, and while the
		-- teardown now clears callback.on_item_take, the artefact take still reaches a
		-- binder whose object is gone (remote player picking up at zat_b18, artefact
		-- handed over during the same frame the binder unbinds). Both branches deref
		-- self.object, so guard the block rather than each branch.
		if self.object == nil then return end
		if OnServer() then
			local anomal_zone = bind_anomaly_zone.parent_zones_by_artefact_id[obj:id()]
			if anomal_zone ~= nil then
				anomal_zone:on_artefact_take(obj)
			else
				bind_anomaly_zone.artefact_ways_by_id[obj:id()] = nil
			end
			local artefact = obj:get_artefact()
			artefact:FollowByPath("NULL",0,vector():set(500,500,500))
			xr_statistic.inc_founded_artefacts_counter(obj:id(), self.object:id())
		elseif (getLocalActor() and self.object:id() == getLocalActor():id()) then -- Client
			xr_statistic.inc_founded_artefacts_counter(obj:id(), self.object:id())
		end
	end
end

function mp_actor_binder:use_gesture(gesture_id)
	db.storage[self.object:id()].last_gesture = gesture_id
	db.storage[self.object:id()].gesture_checked = false
end

-- PORT (Misery_Coop_Port): coop item-use feedback. base mp_actor_binder:reinit binds
-- callback.use_object -> self.use_inventory_item but never DEFINED the method for the
-- coop binder, so item use fired a nil callback ("items vanish on use"). Fire the Misery
-- item-use chain the SP bind_stalker drives: actor_on_item_use handlers, the actor_effects
-- camera/sound FX, and the postproces_mod screen post-process. All guarded; client-side.
function mp_actor_binder:use_inventory_item(obj)
	if (obj == nil) then return end
	local la = getLocalActor()
	if mc_core then mc_core.mc_log("[itms] use_inv srv=%s cli_local=%s sec=%s", tostring(OnServer()), tostring(la ~= nil and self.object:id() == la:id()), tostring(obj:section())) end
	if not (la and self.object:id() == la:id()) then
		-- coop: use_object fires SERVER-side for a remote client's actor. Don't run the
		-- client handlers here (getLocalActor nil -> crash); RPC that client so they run there.
		if OnServer() and mc_cooking and mc_cooking.notify_use then mc_cooking.notify_use(self.object:id(), obj) end
		return
	end
	-- pcall each handler: a ported Misery handler that indexes a coop-nil (e.g. a stale
	-- .object) must DEGRADE+log, not FATAL the client (bind_stalker:215 index-nil class).
	local function _pc(fn, arg)
		local ok, err = pcall(fn, arg)
		if not ok and mc_core then mc_core.mc_log("[itms] use handler fail: %s", tostring(err)) end
	end
	if (axr_main and axr_main.actor_on_item_use) then _pc(axr_main.actor_on_item_use, obj) end
	-- COOP ANIM FIX: skip the Misery use-FX cinematic for items XRMPE/AGWP already animates
	-- (real consumable hud) -- else the engine eat anim + the Misery one DOUBLE (bread 'eat
	-- twice + fade + ~15s cam lockout'). eat_* satiety is engine-applied. See mc_cooking.
	if (not (mc_cooking and mc_cooking.has_agwp_use_anim and mc_cooking.has_agwp_use_anim(obj:section())) and actor_effects and actor_effects.use_item) then _pc(actor_effects.use_item, obj:section()) end
	if (not (mc_cooking and mc_cooking.has_agwp_use_anim and mc_cooking.has_agwp_use_anim(obj:section())) and postproces_mod and postproces_mod.use_obj) then _pc(postproces_mod.use_obj, obj) end
end

-- PORT (Misery_Coop_Port) [POWER_LIVE]: the coop mp_actor_binder:reinit binds
-- callback.inventory_info -> self.info_callback but never DEFINED the method, so the
-- info-callback chain was orphaned (axr_main.actor_on_info_callback never fired) -> the
-- axr_battery PDA open/close + battery-drain path was dead. Fire the Misery dispatcher.
function mp_actor_binder:info_callback(npc, info_id)
	if (axr_main and axr_main.actor_on_info_callback) then axr_main.actor_on_info_callback(npc, info_id) end
end

function actor_have_items()
	local n=3 -- ����������
	local count=0
	
	db.storage[LocalActor()].object:iterate_inventory(function (dummy, item) if item:section()=="kolbasa" then count=count+1 end end, nil)
	
	if count>=n then
		return true
	else
		return false
	end
end

function check_rps_win(our_gesture, other_gesture)
	if other_gesture == nil then
		return false
	end
	
	if our_gesture == 0 then -- eGstRock
		return other_gesture == 2
	elseif our_gesture == 1 then -- eGstPaper
		return other_gesture == 0
	elseif our_gesture == 2 then -- eGstScissors
		return other_gesture == 1
	end
	
	return false
end

function mp_actor_binder:update_rps_game()
	if self.object:id() ~= LocalActor() and not OnServer() then
		return
	end
	
	local last_gesture = db.storage[self.object:id()].last_gesture
	if last_gesture == nil or last_gesture < 0 then
		return
	end
	
	for k,v in pairs(db.mp_actors) do
		if v:id() ~= self.object:id() and v:position():distance_to_sqr(self.object:position()) <= 5 * 5 then
			local st = db.storage[v:id()]
			local other_gesture = st.last_gesture
			if not st.gesture_checked and check_rps_win(last_gesture, other_gesture) then
				xr_statistic.inc_rps_games_won(self.object:id())			
			end	
			st.gesture_checked = true
		end
	end
end

function mp_actor_binder:update(delta)
	self:update_rps_game()
	
	if LocalActor() ~= self.object:id() or (IsServerClient() and LocalActor() == self.object:id()) then
		if OnServer() then
			-- ������ �������� ������ ������ � ���� sr_no_weapon
			if check_for_weapon_hide_by_zones(self.object:id()) == true then
				if self.weapon_hide == false then
					self.object:hide_weapon_except_safe_items()
					self.weapon_hide = true
				end
			else
				if self.weapon_hide == true then
					self.object:restore_weapon_except_safe_items()
					self.weapon_hide = false
				end
			end
			
			xr_sound.update(self.object:id())
		end
		
		if not IsServerClient() then
			return
		end
		
	end
		
	object_binder.update(self, delta)
	
	--ui_dbg_info.print_debug()
	
	local time = time_global()
	game_stats.update (delta, self.object)

	--' ������ ��������������
	xr_sound.update(self.object:id())
	
	-- ���������� ���������� ����� � ����������.
	self.st.disable_input_time = nil
	
	-- ������ �������� ������ ������ �� ����� �������
	if self.object:is_talking() then
		if self.weapon_hide_in_dialog == false then
			self.object:hide_weapon()
			printf("hiding weapon!!!")
			self.weapon_hide_in_dialog = true
		end
	else
		if self.weapon_hide_in_dialog == true then
			printf("restoring weapon!!!")
			self.object:restore_weapon()
			self.weapon_hide_in_dialog = false
		end
	end
	
	if device().frame > self.spawn_frame+100 then
		self:update_gameover_screen()
	end
	
	-- ���������� ���-�������
	if sr_psy_antenna.psy_antenna then
		sr_psy_antenna.psy_antenna:update(delta)
	end
	
	if self.bCheckStart then
		printf("SET DEFAULT INFOS")
		if not has_alife_info("global_dialogs") then
			self.object:give_info_portion("global_dialogs")
		end
		if not has_alife_info("level_changer_icons") then
			self.object:give_info_portion("level_changer_icons")
		end
		self.bCheckStart = false
		-- PORT delta 1
		if mc_player_loop and LocalActor() == self.object:id() then
			mc_player_loop.on_local_spawn(self)
		end
	end

	if self.surge_manager then
		if self.f_surge_manager_loaded ~= true and not self.start_from_load then
			self.surge_manager:initialize()
			self.f_surge_manager_loaded = true
		end
		self.surge_manager:update()
	end
	
	if not self.loaded_slot_applied then
		self.object:activate_slot(self.loaded_active_slot)
		self.loaded_slot_applied = true
	end
	
	xr_s.on_actor_update(delta)
	
	if not(self.primary_objects_filled) then
		pda.fill_primary_objects()
		self.primary_objects_filled = true
	end
	pda.fill_sleep_zones()
	
	self:update_delayed_functions()									   
	
	sim_squad_scripted_cl_manager.get_squad_manager():update()
	
	for k, v in pairs(game_relations.temp_goodwill_table) do
		SetGoodwillForce(k, self.object:id(), v)
	end
	game_relations.temp_goodwill_table = { }

	-- PORT delta 2
	if mc_player_loop and LocalActor() == self.object:id() then
		mc_player_loop.update(self, delta)
	end
end

function mp_actor_binder:net_destroy()
	-- PORT delta 3
	if mc_player_loop and LocalActor() == self.object:id() then
		mc_player_loop.on_destroy(self)
	end
	xr_sound.stop_sounds_by_id(self.object:id())
	local board_factions = sim_board.get_sim_board().players
	if(board_factions) then
			for k,v in pairs (board_factions) do
					xr_sound.stop_sounds_by_id(v.id)
			end
	end
	if(actor_stats.remove_from_ranking~=nil)then
		actor_stats.remove_from_ranking(self.object:id())
	end
	level.show_weapon(true)
	db.del_obj(self.object)
	db.del_mp_actor(self.object)

	if sr_psy_antenna.psy_antenna then
		sr_psy_antenna.psy_antenna:destroy()
		sr_psy_antenna.psy_antenna = false
	end
	
	xrs_dyn_music.finish_theme()
	
	self.object:set_callback(callback.inventory_info, nil)
	self.object:set_callback(callback.article_info, nil)
	self.object:set_callback(callback.on_item_take, nil)
	self.object:set_callback(callback.on_item_drop, nil)
	self.object:set_callback(callback.task_state, nil)
	self.object:set_callback(callback.level_border_enter, nil)
	self.object:set_callback(callback.level_border_exit, nil)
	self.object:set_callback(callback.take_item_from_box, nil)
	self.object:set_callback(callback.use_object, nil)
	-- PORT (Misery_Coop_Port): reinit binds these two as well (see the set_callback block
	-- above), but the base teardown never cleared them. object_binder.net_destroy releases
	-- self.object, so a gesture / trade event arriving afterwards re-entered the dead binder
	-- and indexed a nil self.object -> hard CTD in use_gesture. Clear every callback reinit set.
	self.object:set_callback(callback.trade_sell_buy_item, nil)
	self.object:set_callback(callback.gesture, nil)

	object_binder.net_destroy(self)
end
----------------------------------------------------------------------------------------------------------------------
class "actor_binder" (object_binder)
----------------------------------------------------------------------------------------------------------------------
function actor_binder:__init (obj) super(obj)
	self.bCheckStart = false
	self.weather_manager = level_weathers.get_weather_manager()
	self.surge_manager = surge_manager.get_surge_manager()
	--self.actor_detector = xr_detector.actor_detector()
	self.last_level_name = nil
	self.deimos_intensity = nil
--	self.actor_weapon_on_start = true
	self.loaded_active_slot = 3
	self.loaded_slot_applied = false
	self.last_detective_achievement_spawn_time 	= nil
	self.last_mutant_hunter_achievement_spawn_time	= nil
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:net_spawn(data)
--	printf("actor net spawn")
	level.show_indicators()
	self.bCheckStart = true
	self.weapon_hide = false -- �������� ��� ��� ������ ��� ���������.
	self.weapon_hide_in_dialog = false
	weapon_hide = {} -- ������������� ���������� ���������� ����.
	if object_binder.net_spawn(self,data) == false then
		return false
	end
	db.add_actor(self.object)
	db.actor.deimos_intensity = self.deimos_intensity
	self.deimos_intensity = nil
	if self.st.disable_input_time == nil then
		level.enable_input()
	end
	xr_s.on_game_load()                                    --' Distemper 03.2008 --
	self.weather_manager:reset()
	--' ��������� ��������� �����
	death_manager.init_drop_settings()
	--'������������� ������ �� ������������
	self.task_manager = task_manager.get_task_manager()
	self.spawn_frame = device().frame
	self.already_jumped = false
	self.loaded = false
	benchmark.main()							          --' Distemper 06.2008 --
	
	return true
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:net_destroy()
	xr_sound.stop_sounds_by_id(self.object:id())
	local board_factions = sim_board.get_sim_board().players
	if(board_factions) then
			for k,v in pairs (board_factions) do
					xr_sound.stop_sounds_by_id(v.id)
			end
	end
	if(actor_stats.remove_from_ranking~=nil)then
		actor_stats.remove_from_ranking(self.object:id())
	end
	level.show_weapon(true)
	db.del_actor(self.object)

	self.object:set_callback(callback.inventory_info, nil)
	self.object:set_callback(callback.article_info, nil)
	self.object:set_callback(callback.on_item_take, nil)
	self.object:set_callback(callback.on_item_drop, nil)
	self.object:set_callback(callback.task_state, nil)
	self.object:set_callback(callback.level_border_enter, nil)
	self.object:set_callback(callback.level_border_exit, nil)
	self.object:set_callback(callback.take_item_from_box, nil)
	self.object:set_callback(callback.use_object, nil)

	log("--------->"..tostring(_G.amb_vol))
	log("--------->"..tostring(_G.mus_vol))
	if(_G.amb_vol~=0) then
		get_console():execute("snd_volume_eff "..tostring(_G.amb_vol))
		_G.amb_vol = 0
	end
	if(_G.mus_vol~=0) then
	    get_console():execute("snd_volume_music "..tostring(_G.mus_vol))
		_G.mus_vol = 0
	end
	if sr_psy_antenna.psy_antenna then
		sr_psy_antenna.psy_antenna:destroy()
		sr_psy_antenna.psy_antenna = false
	end
	xrs_dyn_music.finish_theme()
	xr_s.on_actor_destroy()
	object_binder.net_destroy(self)
end
