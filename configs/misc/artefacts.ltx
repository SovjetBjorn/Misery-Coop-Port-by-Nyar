;Артефакты, которые при активизации создают аномальные зоны
;формат: {секция_артефакта} = {секция_зоны},Radius,Power
[af_mica]:af_base
$spawn 				= "artefacts\acidic_7_mica"
class   			= ARTEFACT

visual				= dynamics\artefacts\af_mica.ogf
description			= st_af_mica_descr
inv_name			= st_af_mica_name
inv_name_short		= st_af_mica_name
inv_weight			= 0.5

inv_grid_x			= 13
inv_grid_y			= 0
cost				= 5000
jump_height			= .1

particles				= artefact\af_acidic_idle
det_show_particles		= artefact\af_acidic_show
det_hide_particles		= artefact\af_acidic_hide

af_rank				= 3

lights_enabled = true

trail_light_color 		= 0.6,0.7,0.6
trail_light_range 		= 1.0


;скорости увеличения (уменьшения)
health_restore_speed		= 0.0
radiation_restore_speed		= 0.0
satiety_restore_speed		= 0.0
power_restore_speed			= 0.0
bleeding_restore_speed		= 0.12

additional_inventory_weight		= 0
additional_inventory_weight2	= 0

hit_absorbation_sect = af_mica_absorbation

[af_mica_absorbation]
burn_immunity 			= -0.001				;коэффициенты иммунитета
strike_immunity 		= 0
shock_immunity 			= 0
wound_immunity 			= 0
radiation_immunity 		= 0
telepatic_immunity 		= 0
chemical_burn_immunity 	= -0.001
explosion_immunity 		= 0
fire_wound_immunity  	= 0

