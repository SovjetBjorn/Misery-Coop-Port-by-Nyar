[class_bonus]
; Actor class main bonus - added to dismantle probabs.
cb_main_class_bonus_assaulter 	 = 1
cb_main_class_bonus_recon 		 = 5
cb_main_class_bonus_sniper 		 = 0
; Actor class tool fail bonus - subtracted from tool fail probabs.
cb_fail_class_bonus_assaulter 	 = 0
cb_fail_class_bonus_recon 		 = 2
cb_fail_class_bonus_sniper 		 = 1
; Actor class condition decrease bonus - subtracted from target condition decrease on tool fail override.
cb_cdec_class_bonus_assaulter 	 = 0.03
cb_cdec_class_bonus_recon 		 = 0.02
cb_cdec_class_bonus_sniper 		 = 0.01
; Actor class tool blunt bonus - subtracted from tool blunt probabs.
cb_blnt_class_bonus_assaulter 	 = -4
cb_blnt_class_bonus_recon 		 = 5
cb_blnt_class_bonus_sniper 		 = 0



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; TOOL BLUNT PROBABS AND AUX TOOL BLUNT RATES ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[tool_zeroone_blunt_probabs]
; Sharpened tools get usually blunted on probab test. Since they don't have condition property, it's zero-one blunting. Define probability of getting a tool blunted here.
; Example: 40 means 40% chance of finishing with a blunted tool and 60% chance of finishing with the tool intact.
; NOTE: Not all dismantling scenarios will use this, zero-one blunting of a sharpened tool is one of a few possible tool behaviour patterns. Fate of a tool is a separate setting (tool behaviour: tb_* in [*_tool_bhv]).
tbp_swiss_sharp 		= 40
tbp_cutlery_sharp 		= 50
tbp_shovel_mili_sharp 	= 27
tbp_shovel_old_sharp 	= 30
tbp_grooming_sharp 		= 75

;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; AUX TOOLS BLUNT RATES ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Define how much condition will each aux tool lose on each target genus/species. Values between 0 and 1 only.
[aux_tool_blunt_rate_on_outfit]
atbr_outfit_light_knife 	= 0.06
atbr_outfit_light_axe 		= 0.03
atbr_outfit_medium_knife 	= 0.08
atbr_outfit_medium_axe 		= 0.04
atbr_outfit_heavy_knife 	= 0.1
atbr_outfit_heavy_axe 		= 0.05
atbr_outfit_seva_knife 		= 0.12
atbr_outfit_seva_axe 		= 0.06
atbr_outfit_ssp_knife 		= 0.14
atbr_outfit_ssp_axe 		= 0.07
atbr_outfit_exo_knife 		= 0.16
atbr_outfit_exo_axe 		= 0.08

[aux_tool_blunt_rate_on_helm_mask]
atbr_helm_mask_knife		= 0.04
atbr_helm_mask_axe 			= 0.02

