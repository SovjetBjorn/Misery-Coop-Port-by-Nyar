[wpn_pl]:identity_immunities,weapon_probability,default_weapon_params
GroupControlSection		= spawn_group
$spawn                  = "weapons\pl"		; option for Level Editor
$npc			 		= on						; option for Level Editor
$prefetch 				= 8
scheduled            	= off              	; option for ALife Simulator
cform                   = skeleton
class                   = WP_PM
description				= st_wpn_pl15_descr
ef_weapon_type		    = 5

;-----------------------------------------------------------------------------
cost					= 12500
inv_weight				= 0.83

upgrades                = vartree_pl_details, vartree_pl_podacha, vartree_pl_sights, vartree_pl_handle, vartree_pl_mag
installed_upgrades      =
upgrade_scheme          = upgrade_scheme_fort

def_hide_bones = barrel_silencer, laser, light, line, sight
def_show_bones = barrel

;--TTX----------------------------------------------------------------------------
hit_power                	= 0.62
hit_impulse		 	        = 65
hit_type 			        = fire_wound
fire_distance            	= 100
bullet_speed		 	    = 330
rpm                         = 400
rpm_empty_click 	 		= 10

hud                      	= wpn_pl_hud

use_aim_bullet				= true		;Поддерживается ли первая суппер пуля
time_to_aim					= 1.0

misfire_probability        = 0.005 ;вероятность осечки при максимальном износе  !!!old - now not working
;изношенность, при которой появляется шанс осечки
misfire_start_condition		= 0.6
;изношеность при которой шанс осечки становится константным
misfire_end_condition		= 0.1
;шанс осечки при изношености больше чем misfireStartCondition
misfire_start_prob	     	= 0.0075
;шанс осечки при изношености больше чем misfireEndCondition
misfire_end_prob	     	= 0.075
;увеличение изношености при одиночном выстреле
condition_shot_dec      	= 0.0036
;увеличение изношености при выстреле очередью
condition_queue_shot_dec	= 0.0036

ammo_elapsed		 	= 12
ammo_mag_size		 	= 16
