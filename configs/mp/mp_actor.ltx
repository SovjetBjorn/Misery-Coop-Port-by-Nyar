[mp_actor_immunities]
; Anomaly damage in the co-op model is effective = zone.max_start_power * immunity
; (higher immunity = MORE damage taken -- Misery's SP 10.9 is a compensator for its
; SP-only mechanics and is CATASTROPHIC here, so we do NOT copy it). The port ships
; Misery's real anomaly powers (weak steam 0.22, buzz 0.05, thermal 0.2, static up to
; 2.0), which are already meaningful, so the neutral 1.0 is correct:
;   weak Boiler steam  0.22 * 1.0 = 0.22   (dangerous; 3 overlaps 0.66 -> survivable)
;   average / strong   0.24 / 0.26         (escalates predictably)
;   zharka static strong 2.0 * 1.0 = 2.0   (telegraphed, stays lethal)
;   campfire bonfire   0.58 * 1.0 = 0.58   (was 1.16 instant-kill at 2.0)
; burn_immunity was 2.0 in the earlier candidate -> weak steam 0.44, two overlapping
; full-power mines ~88%, three > full health. 1.0 restores a survivable Boiler without
; a per-zone edit (a global scale would distort every fire anomaly equally). Other
; hit types stay neutral; only explosion is softened slightly.
burn_immunity				= 1.0
strike_immunity				= 1.0
shock_immunity				= 1.0
wound_immunity				= 1.0
radiation_immunity			= 1.0
telepatic_immunity			= 1.0
chemical_burn_immunity		= 1.0
explosion_immunity			= 0.8
fire_wound_immunity  		= 1.0
[mp_actor_wounded_immunities]
